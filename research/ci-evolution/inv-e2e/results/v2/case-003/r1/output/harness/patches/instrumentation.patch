new file mode 100644
index 0000000..0c61873
--- /dev/null
+++ b/internal/state/specula_values.go
@@ -0,0 +1,92 @@
+package state
+
+// Specula trace helpers (opt-in; used only when SPECULA_TRACE_FILE is set).
+// They map implementation values onto the base.tla vocabulary:
+//   parameter record  {rest, ve}
+//   update record     {present, rest, abciPresent, abci}
+//   veHist            enable height of the params in effect at each stored height
+
+import (
+	"strings"
+
+	cmtproto "github.com/cometbft/cometbft/api/cometbft/types/v1"
+	"github.com/cometbft/cometbft/internal/speculatrace"
+	"github.com/cometbft/cometbft/types"
+)
+
+// SpeculaParam returns the {rest, ve} record of a complete ConsensusParams value.
+// rest fingerprints every non-ABCI field; ve is ABCI.VoteExtensionsEnableHeight.
+func SpeculaParam(cp types.ConsensusParams) map[string]any {
+	rest := cp
+	rest.ABCI = types.ABCIParams{}
+	return map[string]any{
+		"rest": speculatrace.Fingerprint(rest),
+		"ve":   cp.ABCI.VoteExtensionsEnableHeight,
+	}
+}
+
+// SpeculaUpdate returns the update record of a FinalizeBlock ConsensusParamUpdates value
+// relative to the current params (rest identity is that of cur.Update(upd)).
+func SpeculaUpdate(cur types.ConsensusParams, upd *cmtproto.ConsensusParams) map[string]any {
+	if upd == nil {
+		return speculatrace.NoUpdate()
+	}
+	next := cur.Update(upd)
+	rec := map[string]any{
+		"present":     true,
+		"rest":        SpeculaParam(next)["rest"],
+		"abciPresent": upd.Abci != nil,
+		"abci":        int64(0),
+	}
+	if upd.Abci != nil {
+		rec["abci"] = upd.Abci.VoteExtensionsEnableHeight
+	}
+	return rec
+}
+
+// SpeculaVEHistory returns the enable height of the params in effect at each stored
+// height 1..blockStoreHeight, read from the state store's params history. A missing
+// entry is reported as -1 so that trace validation (veHist \in Nat) rejects it.
+// Test fixtures may pass a mock Store that panics on unexpected calls; the probe
+// must never alter the code path, so such a panic is recovered and an empty
+// history is returned (trace validation then rejects the event, since
+// DOMAIN veHist must equal 1..blockStoreHeight).
+func SpeculaVEHistory(store Store, blockStoreHeight int64) (hist []int64) {
+	defer func() {
+		if r := recover(); r != nil {
+			hist = []int64{}
+		}
+	}()
+	hist = make([]int64, 0, blockStoreHeight)
+	for m := int64(1); m <= blockStoreHeight; m++ {
+		cp, err := store.LoadConsensusParams(m)
+		if err != nil {
+			hist = append(hist, -1)
+			continue
+		}
+		hist = append(hist, cp.ABCI.VoteExtensionsEnableHeight)
+	}
+	return hist
+}
+
+// SpeculaRejectRule classifies an updateState error by the validation step that
+// produced it (execution.go updateState error wrapping and types/params.go messages).
+func SpeculaRejectRule(err error) string {
+	if err == nil {
+		return "none"
+	}
+	msg := err.Error()
+	switch {
+	case strings.Contains(msg, "validating new consensus params"):
+		return "basic"
+	case strings.Contains(msg, "VoteExtensionsEnableHeight must be positive"):
+		return "r2"
+	case strings.Contains(msg, "cannot be disabled once enabled"):
+		return "r4"
+	case strings.Contains(msg, "cannot be updated to a past or current height"):
+		return "r6"
+	case strings.Contains(msg, "cannot be modified once enabled"):
+		return "r8"
+	}
+	return "unclassified"
+}
