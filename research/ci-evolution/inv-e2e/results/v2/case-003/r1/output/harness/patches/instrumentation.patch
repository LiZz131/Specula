+// speculaLifecycleState captures the complete abstract state used by base.tla.
+// Parameter records are {rest, ve}: rest fingerprints the non-ABCI fields and
+// ve is ABCI.VoteExtensionsEnableHeight; veHist is read from the state store's
+// per-height params history for every stored block height.
+func (blockExec *BlockExecutor) speculaLifecycleState(
+	current State,
+	persisted State,
+	phase string,
+	pendingBlockHeight int64,
+	pendingParam map[string]any,
+	validationOutcome string,
+	rejectRule string,
+) map[string]any {
+	storeHeight := blockExec.blockStore.Height()
+	return speculatrace.LifecycleState(
+		storeHeight,
+		persisted.LastBlockHeight,
+		current.LastBlockHeight,
+		SpeculaParam(current.ConsensusParams),
+		SpeculaParam(persisted.ConsensusParams),
+		current.LastHeightConsensusParamsChanged,
+		persisted.LastHeightConsensusParamsChanged,
+		phase,
+		pendingBlockHeight,
+		pendingParam,
+		validationOutcome,
+		rejectRule,
+		SpeculaVEHistory(blockExec.store, storeHeight),
+	)
+}
