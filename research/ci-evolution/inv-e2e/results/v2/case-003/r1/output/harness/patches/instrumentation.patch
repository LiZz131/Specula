diff --git a/internal/consensus/specula_trace_test.go b/internal/consensus/specula_trace_test.go
new file mode 100644
index 0000000..1b7581e
--- /dev/null
+++ b/internal/consensus/specula_trace_test.go
@@ -0,0 +1,173 @@
+package consensus
+
+// Update-focused recovery scenarios (case-003): a FinalizeBlock response that
+// carries an ABCI.VoteExtensionsEnableHeight update crosses a crash window and
+// is re-validated by the handshake replay (mock app or real app). The crash is
+// injected at the real durable boundary by a failing state-store Save or a
+// failing application Commit; the restart runs the real Handshaker.
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	dbm "github.com/cometbft/cometbft-db"
+	abci "github.com/cometbft/cometbft/abci/types"
+	cmtproto "github.com/cometbft/cometbft/api/cometbft/types/v1"
+	"github.com/cometbft/cometbft/crypto/ed25519"
+	"github.com/cometbft/cometbft/crypto/merkle"
+	"github.com/cometbft/cometbft/internal/speculatrace"
+	sm "github.com/cometbft/cometbft/internal/state"
+	"github.com/cometbft/cometbft/internal/store"
+	"github.com/cometbft/cometbft/libs/log"
+	"github.com/cometbft/cometbft/proxy"
+	"github.com/cometbft/cometbft/types"
+	cmttime "github.com/cometbft/cometbft/types/time"
+)
+
+// speculaRecoveryApp: deterministic scripted updates; durable committed height;
+// optionally fails its first Commit (crash before the app persisted the block).
+type speculaRecoveryApp struct {
+	abci.BaseApplication
+	updates         map[int64]*cmtproto.ConsensusParams
+	committed       int64
+	pending         int64
+	failFirstCommit bool
+}
+
+func (a *speculaRecoveryApp) Info(context.Context, *abci.InfoRequest) (*abci.InfoResponse, error) {
+	return &abci.InfoResponse{LastBlockHeight: a.committed}, nil
+}
+
+func (a *speculaRecoveryApp) FinalizeBlock(
+	_ context.Context, req *abci.FinalizeBlockRequest,
+) (*abci.FinalizeBlockResponse, error) {
+	a.pending = req.Height
+	txResults := make([]*abci.ExecTxResult, len(req.Txs))
+	for i := range txResults {
+		txResults[i] = &abci.ExecTxResult{Code: abci.CodeTypeOK}
+	}
+	return &abci.FinalizeBlockResponse{TxResults: txResults, ConsensusParamUpdates: a.updates[req.Height]}, nil
+}
+
+func (a *speculaRecoveryApp) Commit(context.Context, *abci.CommitRequest) (*abci.CommitResponse, error) {
+	if a.failFirstCommit {
+		a.failFirstCommit = false
+		return nil, errors.New("specula: injected crash before application commit")
+	}
+	a.committed = a.pending
+	return &abci.CommitResponse{}, nil
+}
+
+// speculaFailingSaveStore loses the state save (crash after app Commit, before Save).
+type speculaFailingSaveStore struct {
+	sm.Store
+	fail bool
+}
+
+func (s *speculaFailingSaveStore) Save(state sm.State) error {
+	if s.fail {
+		return errors.New("specula: injected crash before state save")
+	}
+	return s.Store.Save(state)
+}
+
+// speculaCrashThenHandshake applies block 1 until the injected crash, then restarts
+// through the real Handshaker on the same durable stores and application.
+func speculaCrashThenHandshake(
+	t *testing.T, ve int64, update *cmtproto.ConsensusParams, failSave, failCommit bool,
+) (applyErr, handshakeErr error, final sm.State) {
+	t.Helper()
+	require.NoError(t, speculatrace.Reset())
+
+	params := types.DefaultConsensusParams()
+	params.ABCI.VoteExtensionsEnableHeight = ve
+	pk := ed25519.GenPrivKeyFromSecret([]byte("specula0"))
+	genDoc := &types.GenesisDoc{
+		ChainID:         "specula-chain",
+		GenesisTime:     cmttime.Now(),
+		InitialHeight:   1,
+		ConsensusParams: params,
+		Validators: []types.GenesisValidator{{
+			Address: pk.PubKey().Address(), PubKey: pk.PubKey(), Power: 10, Name: "specula0",
+		}},
+	}
+	state, err := sm.MakeGenesisState(genDoc)
+	require.NoError(t, err)
+	// The genesis handshake (InitChain) sets LastResultsHash before block 1 is produced
+	// (internal/consensus/replay.go InitChain branch); reproduce that durable state.
+	state.LastResultsHash = merkle.HashFromByteSlices(nil)
+	stateDB := dbm.NewMemDB()
+	stateStore := sm.NewStore(stateDB, sm.StoreOptions{DiscardABCIResponses: false})
+	require.NoError(t, stateStore.Save(state))
+	blockStore := store.NewBlockStore(dbm.NewMemDB())
+
+	app := &speculaRecoveryApp{updates: map[int64]*cmtproto.ConsensusParams{1: update}, failFirstCommit: failCommit}
+	clientCreator := proxy.NewLocalClientCreator(app)
+
+	// --- first run: block 1 is decided, saved, and applied until the crash.
+	proxyApp := proxy.NewAppConns(clientCreator, proxy.NopMetrics())
+	require.NoError(t, proxyApp.Start())
+	block := state.MakeBlock(1, nil, new(types.Commit), nil, state.Validators.GetProposer().Address)
+	parts, err := block.MakePartSet(types.BlockPartSizeBytes)
+	require.NoError(t, err)
+	blockID := types.BlockID{Hash: block.Hash(), PartSetHeader: parts.Header()}
+	blockStore.SaveBlock(block, parts, &types.Commit{Height: 1, BlockID: blockID})
+	execStore := &speculaFailingSaveStore{Store: stateStore, fail: failSave}
+	blockExec := sm.NewBlockExecutor(execStore, log.TestingLogger(), proxyApp.Consensus(),
+		emptyMempool{}, sm.EmptyEvidencePool{}, blockStore)
+	_, applyErr = blockExec.ApplyBlock(state, blockID, block)
+	require.NoError(t, proxyApp.Stop())
+
+	// --- restart: reload durable state and run the real handshake.
+	reloaded, err := stateStore.Load()
+	require.NoError(t, err)
+	proxyApp2 := proxy.NewAppConns(clientCreator, proxy.NopMetrics())
+	require.NoError(t, proxyApp2.Start())
+	t.Cleanup(func() { _ = proxyApp2.Stop() })
+	handshaker := NewHandshaker(stateStore, reloaded, blockStore, genDoc)
+	handshakeErr = handshaker.Handshake(context.Background(), proxyApp2)
+	final, err = stateStore.Load()
+	require.NoError(t, err)
+	return applyErr, handshakeErr, final
+}
+
+func speculaAbciUpdate(ve int64) *cmtproto.ConsensusParams {
+	return &cmtproto.ConsensusParams{Abci: &cmtproto.ABCIParams{VoteExtensionsEnableHeight: ve}}
+}
+
+// Mock replay: app committed block 1 (with an enable-height update), state save lost.
+func TestSpeculaTraceReplayMockVEUpdate(t *testing.T) {
+	applyErr, hsErr, final := speculaCrashThenHandshake(t, 0, speculaAbciUpdate(3), true, false)
+	require.Error(t, applyErr)
+	require.NoError(t, hsErr)
+	require.EqualValues(t, 1, final.LastBlockHeight)
+	require.EqualValues(t, 3, final.ConsensusParams.ABCI.VoteExtensionsEnableHeight)
+	require.EqualValues(t, 2, final.LastHeightConsensusParamsChanged)
+}
+
+// Real replay: crash before app Commit; the app re-executes block 1 and the
+// enable-height update is validated again.
+func TestSpeculaTraceReplayRealVEUpdate(t *testing.T) {
+	applyErr, hsErr, final := speculaCrashThenHandshake(t, 0, speculaAbciUpdate(2), false, true)
+	require.Error(t, applyErr)
+	require.NoError(t, hsErr)
+	require.EqualValues(t, 1, final.LastBlockHeight)
+	require.EqualValues(t, 2, final.ConsensusParams.ABCI.VoteExtensionsEnableHeight)
+}
+
+// Real replay of a rejected unchanged enable height: the restart re-executes the
+// block, ValidateUpdate rejects it again, and the handshake fails.
+func TestSpeculaTraceReplayRealVEUnchangedRejected(t *testing.T) {
+	full := types.DefaultConsensusParams()
+	full.ABCI.VoteExtensionsEnableHeight = 1
+	fullProto := full.ToProto()
+	applyErr, hsErr, final := speculaCrashThenHandshake(t, 1, &fullProto, false, false)
+	require.Error(t, applyErr)
+	require.Contains(t, applyErr.Error(), "cannot be updated to a past or current height")
+	require.Error(t, hsErr)
+	require.Contains(t, hsErr.Error(), "cannot be updated to a past or current height")
+	require.EqualValues(t, 0, final.LastBlockHeight)
+}
diff --git a/internal/speculatrace/trace.go b/internal/speculatrace/trace.go
new file mode 100644
index 0000000..15f64c9
--- /dev/null
+++ b/internal/speculatrace/trace.go
@@ -0,0 +1,194 @@
+// Package speculatrace provides opt-in NDJSON tracing for the Specula V0
+// harness. When SPECULA_TRACE_FILE is unset every operation is a no-op.
+package speculatrace
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+)
+
+const NoParam = "NoParam"
+
+// NoRest is the rest identity used by the absent update record.
+const NoRest = "none"
+
+// NoUpdate is the update record for a nil ConsensusParamUpdates (base.tla NoUpdate).
+func NoUpdate() map[string]any {
+	return map[string]any{"present": false, "rest": NoRest, "abciPresent": false, "abci": int64(0)}
+}
+
+var traceState struct {
+	sync.Mutex
+	file           *os.File
+	path           string
+	replay         bool
+	appHeight      int64
+	responseHeight int64
+	responseParam  any
+}
+
+// Enabled reports whether this process was launched for trace collection.
+func Enabled() bool {
+	return os.Getenv("SPECULA_TRACE_FILE") != ""
+}
+
+// Reset truncates the configured trace file. It is used at the real Handshake
+// entry point so test-fixture setup does not contaminate recovery traces.
+func Reset() error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file != nil {
+		_ = traceState.file.Close()
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	traceState.file = f
+	traceState.path = path
+	traceState.replay = false
+	traceState.appHeight = 0
+	traceState.responseHeight = 0
+	traceState.responseParam = NoUpdate()
+	return nil
+}
+
+// Fingerprint gives a stable symbolic identity to a complete consensus
+// parameter value without baking its large Go representation into the model.
+func Fingerprint(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return "marshal-error"
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+func SetReplay(v bool) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.replay = v
+}
+
+func IsReplay() bool {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.replay
+}
+
+func SetAppHeight(h int64) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.appHeight = h
+}
+
+func AppHeight() int64 {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.appHeight
+}
+
+func SetResponse(height int64, param any) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.responseHeight = height
+	traceState.responseParam = param
+}
+
+func Response() (int64, any) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.responseHeight, traceState.responseParam
+}
+
+// LifecycleState constructs the state object consumed by Trace.tla.
+// activeParam/persistedParam are {rest, ve} records; pendingParam is an update
+// record {present, rest, abciPresent, abci}; veHist[m-1] is the enable height of
+// the params in effect at stored height m.
+func LifecycleState(
+	blockStoreHeight, stateStoreHeight, inMemoryStateHeight int64,
+	activeParam, persistedParam any,
+	lastParamChange, persistedLastParamChange int64,
+	phase string,
+	pendingBlockHeight int64,
+	pendingParam any,
+	validationOutcome, rejectRule string,
+	veHist []int64,
+) map[string]any {
+	traceState.Lock()
+	defer traceState.Unlock()
+	if veHist == nil {
+		veHist = []int64{}
+	}
+	if pendingParam == nil {
+		pendingParam = NoUpdate()
+	}
+	responseParam := traceState.responseParam
+	if responseParam == nil {
+		responseParam = NoUpdate()
+	}
+	return map[string]any{
+		"blockStoreHeight":         blockStoreHeight,
+		"appHeight":                traceState.appHeight,
+		"stateStoreHeight":         stateStoreHeight,
+		"stateHeight":              inMemoryStateHeight,
+		"activeParam":              activeParam,
+		"persistedParam":           persistedParam,
+		"lastParamChange":          lastParamChange,
+		"persistedLastParamChange": persistedLastParamChange,
+		"phase":                    phase,
+		"replayMutatesState":       traceState.replay,
+		"responseHeight":           traceState.responseHeight,
+		"responseParam":            responseParam,
+		"pendingBlockHeight":       pendingBlockHeight,
+		"pendingParam":             pendingParam,
+		"validationOutcome":        validationOutcome,
+		"rejectRule":               rejectRule,
+		"veHist":                   veHist,
+	}
+}
+
+// Emit appends one mutex-serialized event with a real wall-clock timestamp.
+// Instrumentation deliberately ignores its returned error at call sites so it
+// cannot change the system's functional error paths.
+func Emit(name string, state map[string]any, msg map[string]any) error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file == nil || traceState.path != path {
+		if traceState.file != nil {
+			_ = traceState.file.Close()
+		}
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+		if err != nil {
+			return err
+		}
+		traceState.file = f
+		traceState.path = path
+	}
+	event := map[string]any{
+		"tag": "trace",
+		"ts":  time.Now().UnixNano(),
+		"event": map[string]any{
+			"name":  name,
+			"nid":   "node",
+			"state": state,
+			"msg":   msg,
+		},
+	}
+	if err := json.NewEncoder(traceState.file).Encode(event); err != nil {
+		return err
+	}
+	return traceState.file.Sync()
+}
