+// ---------------------------------------------------------------------------
+// Update-focused scenarios (case-003): ConsensusParams.ValidateUpdate decision
+// table driven through the real BlockExecutor.ApplyBlock -> updateState path.
+// Each scenario is derived from a changed or high-risk cell of the visible diff
+// (types/params.go:208-262).
+// ---------------------------------------------------------------------------
+
+// speculaScriptedApp returns a scripted ConsensusParamUpdates per height.
+type speculaScriptedApp struct {
+	abci.BaseApplication
+	updates map[int64]*cmtproto.ConsensusParams
+}
+
+func (a *speculaScriptedApp) FinalizeBlock(
+	_ context.Context,
+	req *abci.FinalizeBlockRequest,
+) (*abci.FinalizeBlockResponse, error) {
+	txResults := make([]*abci.ExecTxResult, len(req.Txs))
+	for i := range txResults {
+		txResults[i] = &abci.ExecTxResult{Code: abci.CodeTypeOK}
+	}
+	return &abci.FinalizeBlockResponse{
+		TxResults:             txResults,
+		ConsensusParamUpdates: a.updates[req.Height],
+	}, nil
+}
+
+// speculaGenesis is makeState(1, 1) with an explicit genesis enable height.
+func speculaGenesis(ve int64) (sm.State, dbm.DB, map[string]types.PrivValidator) {
+	params := types.DefaultConsensusParams()
+	params.ABCI.VoteExtensionsEnableHeight = ve
+	pk := ed25519.GenPrivKeyFromSecret([]byte("specula0"))
+	valAddr := pk.PubKey().Address()
+	s, err := sm.MakeGenesisState(&types.GenesisDoc{
+		ChainID:         chainID,
+		ConsensusParams: params,
+		Validators: []types.GenesisValidator{{
+			Address: valAddr, PubKey: pk.PubKey(), Power: 1000, Name: "specula0",
+		}},
+	})
+	if err != nil {
+		panic(err)
+	}
+	stateDB := dbm.NewMemDB()
+	if err := sm.NewStore(stateDB, sm.StoreOptions{DiscardABCIResponses: false}).Save(s); err != nil {
+		panic(err)
+	}
+	return s, stateDB, map[string]types.PrivValidator{
+		valAddr.String(): types.NewMockPVWithParams(pk, false, false),
+	}
+}
+
+// speculaApplyChain saves and applies blocks 1..n through the real BlockExecutor
+// (block saved before ApplyBlock, as consensus/state.go:1781-1792 does). It stops
+// at the first ApplyBlock error and returns the failing height.
+func speculaApplyChain(
+	t *testing.T,
+	initialVE int64,
+	n int64,
+	updates map[int64]*cmtproto.ConsensusParams,
+) (sm.State, sm.Store, int64, error) {
+	t.Helper()
+	require.NoError(t, speculatrace.Reset())
+
+	app := &speculaScriptedApp{updates: updates}
+	proxyApp := proxy.NewAppConns(proxy.NewLocalClientCreator(app), proxy.NopMetrics())
+	require.NoError(t, proxyApp.Start())
+	t.Cleanup(func() { require.NoError(t, proxyApp.Stop()) })
+
+	state, stateDB, privVals := speculaGenesis(initialVE)
+	stateStore := sm.NewStore(stateDB, sm.StoreOptions{DiscardABCIResponses: false})
+	blockStore := store.NewBlockStore(dbm.NewMemDB())
+
+	mp := &mpmocks.Mempool{}
+	mp.On("Lock").Return()
+	mp.On("Unlock").Return()
+	mp.On("FlushAppConn", mock.Anything).Return(nil)
+	mp.On("Update", mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil)
+
+	blockExec := sm.NewBlockExecutor(stateStore, log.TestingLogger(), proxyApp.Consensus(),
+		mp, sm.EmptyEvidencePool{}, blockStore)
+
+	lastCommit := new(types.Commit)
+	for h := int64(1); h <= n; h++ {
+		block := state.MakeBlock(h, test.MakeNTxs(h, 2), lastCommit, nil,
+			state.Validators.GetProposer().Address)
+		parts, err := block.MakePartSet(testPartSize)
+		require.NoError(t, err)
+		blockID := types.BlockID{Hash: block.Hash(), PartSetHeader: parts.Header()}
+		ec, err := makeValidCommit(h, blockID, state.Validators, privVals)
+		require.NoError(t, err)
+		blockStore.SaveBlock(block, parts, ec.ToCommit())
+
+		next, err := blockExec.ApplyBlock(state, blockID, block)
+		if err != nil {
+			return state, stateStore, h, err
+		}
+		state = next
+		lastCommit = ec.ToCommit()
+	}
+	return state, stateStore, n, nil
+}
+
+func speculaAbci(ve int64) *cmtproto.ConsensusParams {
+	return &cmtproto.ConsensusParams{Abci: &cmtproto.ABCIParams{VoteExtensionsEnableHeight: ve}}
+}
+
+// Row 7 (changed: the old revision rejected it): enable from 0 at h+1, then reach it.
+func TestSpeculaTraceVEEnableFuture(t *testing.T) {
+	state, _, _, err := speculaApplyChain(t, 0, 3, map[int64]*cmtproto.ConsensusParams{
+		1: speculaAbci(2),
+		3: {Block: &cmtproto.BlockParams{MaxBytes: 2097152, MaxGas: -1}},
+	})
+	require.NoError(t, err)
+	require.EqualValues(t, 2, state.ConsensusParams.ABCI.VoteExtensionsEnableHeight)
+	require.EqualValues(t, 3, state.LastBlockHeight)
+}
+
+// Rows 5, 7, 9: cancel a scheduled height (changed), re-enable, then move it.
+func TestSpeculaTraceVECancelScheduled(t *testing.T) {
+	state, _, _, err := speculaApplyChain(t, 5, 3, map[int64]*cmtproto.ConsensusParams{
+		1: speculaAbci(0),
+		2: speculaAbci(4),
+		3: speculaAbci(6),
+	})
+	require.NoError(t, err)
+	require.EqualValues(t, 6, state.ConsensusParams.ABCI.VoteExtensionsEnableHeight)
+}
+
+// Row 6 with an unchanged value (changed: the old revision accepted it). Height 1
+// changes Block params without an Abci subrecord; height 2 sends the complete
+// current params (ToProto always includes Abci) with the same Block change.
+func TestSpeculaTraceVEUnchangedAfterEnable(t *testing.T) {
+	full := types.DefaultConsensusParams()
+	full.ABCI.VoteExtensionsEnableHeight = 1
+	full.Block.MaxBytes = 2097152
+	fullProto := full.ToProto()
+	state, stateStore, failedAt, err := speculaApplyChain(t, 1, 2, map[int64]*cmtproto.ConsensusParams{
+		1: {Block: &cmtproto.BlockParams{MaxBytes: 2097152, MaxGas: full.Block.MaxGas}},
+		2: &fullProto,
+	})
+	require.Error(t, err)
+	require.EqualValues(t, 2, failedAt)
+	require.Contains(t, err.Error(), "cannot be updated to a past or current height")
+	persisted, loadErr := stateStore.Load()
+	require.NoError(t, loadErr)
+	require.Equal(t, persisted.ConsensusParams, state.ConsensusParams)
+}
+
+// Row 4: disable once enabled.
+func TestSpeculaTraceVEDisableAfterEnable(t *testing.T) {
+	_, _, _, err := speculaApplyChain(t, 1, 1, map[int64]*cmtproto.ConsensusParams{1: speculaAbci(0)})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "cannot be disabled once enabled")
+}
+
+// Row 8: modify once enabled.
+func TestSpeculaTraceVEModifyAfterEnable(t *testing.T) {
+	_, _, _, err := speculaApplyChain(t, 1, 1, map[int64]*cmtproto.ConsensusParams{1: speculaAbci(5)})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "cannot be modified once enabled")
+}
+
+// Row 6: enable at the current height.
+func TestSpeculaTraceVEPastHeight(t *testing.T) {
+	_, _, failedAt, err := speculaApplyChain(t, 0, 2, map[int64]*cmtproto.ConsensusParams{2: speculaAbci(2)})
+	require.Error(t, err)
+	require.EqualValues(t, 2, failedAt)
+	require.Contains(t, err.Error(), "cannot be updated to a past or current height")
+}
+
+// ValidateBasic precedes ValidateUpdate: a negative height fails basic validation.
+func TestSpeculaTraceVENegative(t *testing.T) {
+	_, _, _, err := speculaApplyChain(t, 0, 1, map[int64]*cmtproto.ConsensusParams{1: speculaAbci(-1)})
+	require.Error(t, err)
