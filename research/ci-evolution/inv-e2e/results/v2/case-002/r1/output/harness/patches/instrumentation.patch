+package org.apache.zookeeper.server.quorum;
+
+import java.io.BufferedWriter;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.zookeeper.server.ZooKeeperServer;
+import org.apache.zookeeper.server.util.ZxidUtils;
+
+/** Opt-in, synchronous Specula NDJSON instrumentation. */
+public final class SpeculaTrace {
+
+    private static final AtomicLong SEQUENCE = new AtomicLong();
+
+    private SpeculaTrace() {
+    }
+
+    public static boolean isEnabled() {
+        String path = System.getProperty("specula.trace.file");
+        return path != null && !path.isEmpty();
+    }
+
+    public static void emit(String event, QuorumPeer peer, long zxid) {
+        emitDetail(event, peer, zxid, null);
+    }
+
+    /** Update-focused NEWLEADER ACK probe: records logging, serving state and on-disk position. */
+    public static void emitNewLeaderAck(String event, QuorumPeer peer, ZooKeeperServer zk, long newLeaderZxid,
+                                        int loggedAtNewLeader, int pendingAfter) {
+        if (!isEnabled()) {
+            return;
+        }
+        long durableZxid = -1;
+        try {
+            durableZxid = zk.getTxnLogFactory().getLastLoggedZxid();
+        } catch (RuntimeException e) {
+            durableZxid = -2;
+        }
+        long durableEpoch = durableZxid < 0 ? -1 : ZxidUtils.getEpochFromZxid(durableZxid);
+        long durableCounter = durableZxid < 0 ? -1 : (durableZxid & 0xffffffffL);
+        emitDetail(event, peer, newLeaderZxid,
+            "\"logged\":" + loggedAtNewLeader
+            + ",\"pending\":" + pendingAfter
+            + ",\"running\":" + zk.isRunning()
+            + ",\"durableZxid\":\"" + durableZxid + "\""
+            + ",\"durableEpoch\":" + durableEpoch
+            + ",\"durableCounter\":" + durableCounter);
+    }
+
+    public static void emitDetail(String event, QuorumPeer peer, long zxid, String detail) {
+        if (!isEnabled()) {
+            return;
+        }
+        if (peer == null) {
+            emit(event, -1, zxid, -1, -1, "unknown", "unknown", "NONE", detail);
+            return;
+        }
+        long accepted = -1;
+        long current = -1;
+        try {
+            accepted = peer.getAcceptedEpoch();
+            current = peer.getCurrentEpoch();
+        } catch (IOException e) {
+            // Capture remains useful when epoch files are not initialized yet.
+        }
+        emit(event,
+             peer.getId(),
+             zxid,
+             accepted,
+             current,
+             peer.getPeerState().toString().toLowerCase(),
+             peer.getZabState().toString().toLowerCase(),
+             peer.getSyncMode().toString(),
+             detail);
+    }
+
+    public static void emit(String event, ZooKeeperServer server, long zxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        emit(event,
+             server == null ? -1 : server.getServerId(),
+             zxid,
+             -1,
+             -1,
+             "unknown",
+             "unknown",
+             "NONE",
+             null);
+    }
+
+    public static synchronized void emit(
+            String event,
+            long sid,
+            long zxid,
+            long acceptedEpoch,
+            long currentEpoch,
+            String role,
+            String phase,
+            String syncMode,
+            String detail) {
+        String path = System.getProperty("specula.trace.file");
+        if (!isEnabled()) {
+            return;
+        }
+        long sequence = SEQUENCE.incrementAndGet();
+        Thread thread = Thread.currentThread();
+        long txnEpoch = zxid < 0 ? -1 : ZxidUtils.getEpochFromZxid(zxid);
+        long txnCounter = zxid < 0 ? -1 : (zxid & 0xffffffffL);
+        String scenario = System.getProperty("specula.trace.scenario", "unspecified");
+        String line = "{\"tag\":\"trace\",\"scenario\":\"" + escape(scenario)
+            + "\",\"seq\":" + sequence
+            + ",\"timeMillis\":" + System.currentTimeMillis()
+            + ",\"timeNanos\":" + System.nanoTime()
+            + ",\"thread\":{\"id\":" + thread.getId()
+            + ",\"name\":\"" + escape(thread.getName()) + "\"}"
+            + ",\"event\":{\"name\":\"" + escape(event)
+            + "\",\"node\":\"s" + sid
+            + "\",\"zxid\":\"" + zxid + "\""
+            + ",\"txnEpoch\":" + txnEpoch
+            + ",\"txnCounter\":" + txnCounter
+            + ",\"state\":{\"acceptedEpoch\":" + acceptedEpoch
+            + ",\"currentEpoch\":" + currentEpoch
+            + ",\"role\":\"" + escape(role)
+            + "\",\"phase\":\"" + escape(phase)
+            + "\",\"syncMode\":\"" + escape(syncMode)
+            + "\"}"
+            + (detail == null ? "" : ",\"detail\":{" + detail + "}")
+            + "}}";
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+                 new FileOutputStream(path, true), StandardCharsets.UTF_8))) {
+            writer.write(line);
+            writer.newLine();
+        } catch (IOException e) {
+            throw new IllegalStateException("Unable to write Specula trace " + path, e);
+        }
+    }
+
+    private static String escape(String value) {
+        return value.replace("\\", "\\\\")
+                    .replace("\"", "\\\"")
+                    .replace("\n", "\\n")
+                    .replace("\r", "\\r");
+    }
+}
