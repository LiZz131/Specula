  "update_event_consumers": {
    "SyncProposalReceived": "Trace.NextPendingSync + ValidateEventPostState(Detail.pending, last entry); TraceSync k-th stream entry",
    "SyncCommitReceived": "Trace ValidateEventPostState(Detail.pending = buffer size); TraceSync entry in buffer",
    "NewLeaderAckSent": "Trace (syncMode NONE, epochs equal, running=false, pending=0, logged=buffer, buffered entries queued, disk>=durable); TraceSync AckNewLeader + exact durable field",
    "NewLeaderAckWritten": "Trace (nlAckSent, running=false, disk>=durable); TraceSync durable consistency",
    "NewLeaderAckCounted": "Trace.NextNlAcks + peer ACK-order check",
    "NewLeaderAckRejected": "Trace schema + peer check",
    "BroadcastReady": "Trace (data-tree position, running=true, nlAckSent, pending); TraceSync EnterBroadcast"
  }
