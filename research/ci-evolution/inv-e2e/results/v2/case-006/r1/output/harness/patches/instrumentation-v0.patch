diff --git a/specula_trace.go b/specula_trace.go
new file mode 100644
index 0000000..44a13dc
--- /dev/null
+++ b/specula_trace.go
@@ -0,0 +1,148 @@
+package raft
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	pb "github.com/coreos/etcd/raft/raftpb"
+)
+
+// This file is test-only instrumentation for the Specula V0 harness. Calls are
+// no-ops unless speculaTraceStart has enabled a writer.
+var speculaTrace struct {
+	sync.Mutex
+	f *os.File
+}
+
+type speculaTraceState struct {
+	Term           uint64   `json:"term"`
+	Vote           string   `json:"vote"`
+	Role           string   `json:"role"`
+	Leader         string   `json:"leader"`
+	Commit         uint64   `json:"commit"`
+	Applied        uint64   `json:"applied"`
+	LogTerms       []uint64 `json:"logTerms"`
+	ReadQueue      []string `json:"readQueue"`
+	PendingCount   int      `json:"pendingCount"`
+	ReadCount      int      `json:"readCount"`
+	ReadyReadCount int      `json:"readyReadCount"`
+}
+
+type speculaTraceMsg struct {
+	Type      string `json:"type"`
+	From      string `json:"from"`
+	To        string `json:"to"`
+	Term      uint64 `json:"term"`
+	Index     uint64 `json:"index"`
+	LogTerm   uint64 `json:"logTerm"`
+	Commit    uint64 `json:"commit"`
+	EntryTerm uint64 `json:"entryTerm"`
+	Value     string `json:"value"`
+	Ctx       string `json:"ctx"`
+	Reject    bool   `json:"reject"`
+}
+
+func speculaNodeID(id uint64) string {
+	if id == None {
+		return "Nil"
+	}
+	return fmt.Sprintf("s%d", id)
+}
+
+func speculaTraceStart(path string) error {
+	speculaTrace.Lock()
+	defer speculaTrace.Unlock()
+	f, err := os.Create(path)
+	if err != nil {
+		return err
+	}
+	speculaTrace.f = f
+	return nil
+}
+
+func speculaTraceStop() error {
+	speculaTrace.Lock()
+	defer speculaTrace.Unlock()
+	if speculaTrace.f == nil {
+		return nil
+	}
+	err := speculaTrace.f.Close()
+	speculaTrace.f = nil
+	return err
+}
+
+func speculaCaptureState(r *raft, readyReads int) speculaTraceState {
+	terms := make([]uint64, 0, r.raftLog.lastIndex())
+	for _, e := range r.raftLog.allEntries() {
+		terms = append(terms, e.Term)
+	}
+	queue := make([]string, len(r.readOnly.readIndexQueue))
+	copy(queue, r.readOnly.readIndexQueue)
+	role := strings.TrimPrefix(r.state.String(), "State")
+	return speculaTraceState{
+		Term: r.Term, Vote: speculaNodeID(r.Vote), Role: role,
+		Leader: speculaNodeID(r.lead), Commit: r.raftLog.committed,
+		Applied: r.raftLog.applied, LogTerms: terms, ReadQueue: queue,
+		PendingCount: len(r.readOnly.pendingReadIndex),
+		ReadCount:    len(r.readStates), ReadyReadCount: readyReads,
+	}
+}
+
+func speculaCaptureMsg(m *pb.Message) *speculaTraceMsg {
+	if m == nil {
+		return nil
+	}
+	tm, value := uint64(0), "Nil"
+	if len(m.Entries) != 0 {
+		e := m.Entries[len(m.Entries)-1]
+		tm = e.Term
+		if len(e.Data) != 0 {
+			value = string(e.Data)
+		}
+	}
+	ctx := "Nil"
+	if len(m.Context) != 0 {
+		ctx = string(m.Context)
+	} else if m.Type == pb.MsgReadIndex && len(m.Entries) != 0 {
+		ctx = string(m.Entries[0].Data)
+	}
+	return &speculaTraceMsg{
+		Type: m.Type.String(), From: speculaNodeID(m.From),
+		To: speculaNodeID(m.To), Term: m.Term, Index: m.Index,
+		LogTerm: m.LogTerm, Commit: m.Commit, EntryTerm: tm,
+		Value: value, Ctx: ctx, Reject: m.Reject,
+	}
+}
+
+func speculaTraceEmit(r *raft, name string, m *pb.Message, readyReads int) {
+	speculaTrace.Lock()
+	defer speculaTrace.Unlock()
+	if speculaTrace.f == nil {
+		return
+	}
+	event := map[string]interface{}{
+		"name":  name,
+		"nid":   speculaNodeID(r.id),
+		"state": speculaCaptureState(r, readyReads),
+	}
+	if msg := speculaCaptureMsg(m); msg != nil {
+		event["msg"] = msg
+	}
+	record := map[string]interface{}{
+		"tag": "trace", "ts": time.Now().UnixNano(), "event": event,
+	}
+	b, err := json.Marshal(record)
+	if err != nil {
+		panic(err)
+	}
+	if _, err = speculaTrace.f.Write(append(b, '\n')); err != nil {
+		panic(err)
+	}
+	if err = speculaTrace.f.Sync(); err != nil {
+		panic(err)
+	}
+}
diff --git a/specula_trace_test.go b/specula_trace_test.go
new file mode 100644
index 0000000..0b88812
--- /dev/null
+++ b/specula_trace_test.go
@@ -0,0 +1,82 @@
+package raft
+
+import (
+	"os"
+	"testing"
+
+	pb "github.com/coreos/etcd/raft/raftpb"
+)
+
+// TestSpeculaTraceQuorumRead drives the exact-old state machine and its real
+// in-tree message-routing test network. The core instrumentation emits NDJSON;
+// this test does not synthesize protocol states or trace lines.
+func TestSpeculaTraceQuorumRead(t *testing.T) {
+	path := os.Getenv("SPECULA_TRACE_PATH")
+	if path == "" {
+		t.Skip("SPECULA_TRACE_PATH is not set")
+	}
+
+	nt := newNetwork(nil, nil, nil)
+	if err := speculaTraceStart(path); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := speculaTraceStop(); err != nil {
+			t.Error(err)
+		}
+	}()
+
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})
+	lead := nt.peers[1].(*raft)
+	if lead.state != StateLeader {
+		t.Fatalf("node 1 state = %v, want leader", lead.state)
+	}
+
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgProp,
+		Entries: []pb.Entry{{Data: []byte("v1")}}})
+	if lead.raftLog.committed < 2 {
+		t.Fatalf("commit = %d, want at least 2", lead.raftLog.committed)
+	}
+
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgReadIndex,
+		Entries: []pb.Entry{{Data: []byte("ctx1")}}})
+	if len(lead.readStates) != 1 {
+		t.Fatalf("read states = %d, want 1", len(lead.readStates))
+	}
+
+	_ = newReady(lead, &SoftState{Lead: None, RaftState: StateFollower}, emptyState)
+}
+
+// TestSpeculaTraceQuorumLoss records the heartbeat-activity reset followed by
+// exact-old leader step-down when the next quorum check sees no active peers.
+func TestSpeculaTraceQuorumLoss(t *testing.T) {
+	path := os.Getenv("SPECULA_TRACE_PATH")
+	if path == "" {
+		t.Skip("SPECULA_TRACE_PATH is not set")
+	}
+
+	nt := newNetwork(nil, nil, nil)
+	if err := speculaTraceStart(path); err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := speculaTraceStop(); err != nil {
+			t.Error(err)
+		}
+	}()
+
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgHup})
+	lead := nt.peers[1].(*raft)
+	if lead.state != StateLeader {
+		t.Fatalf("node 1 state = %v, want leader", lead.state)
+	}
+
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgCheckQuorum})
+	if lead.state != StateLeader {
+		t.Fatalf("first quorum check state = %v, want leader", lead.state)
+	}
+	nt.send(pb.Message{From: 1, To: 1, Type: pb.MsgCheckQuorum})
+	if lead.state != StateFollower {
+		t.Fatalf("second quorum check state = %v, want follower", lead.state)
+	}
+}
