+    eng.leader_handler()?.leader_append_entries(vec![Entry::new_membership(LogId::default(), uniform)]);
+    rec.emit("LeaderAppend", 1, json!({"kind": "uniform", "configs": [[2,3]], "learners": [1]}), &eng)?;
