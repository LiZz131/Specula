+package org.apache.zookeeper.server.quorum;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import java.util.Map;
+import java.util.TreeMap;
+import org.apache.zookeeper.KeeperException;
+
+import org.apache.zookeeper.CreateMode;
+import org.apache.zookeeper.ZooDefs.Ids;
+import org.apache.zookeeper.ZooKeeper.States;
+import org.junit.jupiter.api.Test;
+
+/** Source-derived startup, mutation, restart, follower catch-up, and learner-exit scenarios. */
+public class SpeculaTraceScenarioTest extends QuorumPeerTestBase {
+
+    @Test
+    public void testElectionAndOrderedMutations() throws Exception {
+        numServers = 3;
+        servers = LaunchServers(numServers, 500);
+
+        int leader = servers.findLeader();
+        assertTrue(leader >= 0, "the startup election must choose a leader");
+
+        byte[] first = new byte[]{10};
+        byte[] second = new byte[]{11};
+        servers.zk[leader].create("/specula-ordered", first, Ids.OPEN_ACL_UNSAFE, CreateMode.PERSISTENT);
+        servers.zk[leader].setData("/specula-ordered", second, -1);
+        assertArrayEquals(second, servers.zk[leader].getData("/specula-ordered", false, null));
+
+        servers.shutDownAllServers();
+        waitForAll(servers.zk, States.CONNECTING);
+    }
+
+    @Test
+    public void testStartupMutationRestartAndCatchup() throws Exception {
+        numServers = 3;
+        servers = LaunchServers(numServers, 500);
+
+        int leader = servers.findLeader();
+        assertTrue(leader >= 0, "the initial election must choose a leader");
+
+        byte[] before = new byte[]{1};
+        servers.zk[leader].create("/specula", before, Ids.OPEN_ACL_UNSAFE, CreateMode.PERSISTENT);
+        assertArrayEquals(before, servers.zk[leader].getData("/specula", false, null));
+
+        servers.shutDownAllServers();
+        waitForAll(servers.zk, States.CONNECTING);
+        servers.restartAllServersAndClients(this);
+        waitForAll(servers, States.CONNECTED);
+        assertArrayEquals(before, servers.zk[0].getData("/specula", false, null));
+
+        int follower = servers.findAnyFollower();
+        assertTrue(follower >= 0, "the restarted ensemble must have a follower");
+        servers.mt[follower].shutdown();
+        waitForOne(servers.zk[follower], States.CONNECTING);
+
+        int live = follower == 0 ? 1 : 0;
+        byte[] after = new byte[]{2};
+        servers.zk[live].setData("/specula", after, -1);
+        assertArrayEquals(after, servers.zk[live].getData("/specula", false, null));
+
+        servers.mt[follower].start();
+        servers.restartClient(follower, this);
+        waitForOne(servers.zk[follower], States.CONNECTED);
+        assertArrayEquals(after, servers.zk[follower].getData("/specula", false, null));
+
+        servers.shutDownAllServers();
+        waitForAll(servers.zk, States.CONNECTING);
+    }
+
+    /**
+     * Update scenario UPD-3 (derived from the Learner.shutdown change): every
+     * follower leaves FOLLOWING while serving when its leader stops, then the
+     * remaining peers re-elect and the old leader re-joins. Observes live
+     * SyncRequestProcessor threads per server after each step.
+     */
+    @Test
+    public void testServingFollowerExitAfterLeaderLoss() throws Exception {
+        numServers = 3;
+        servers = LaunchServers(numServers, 500);
+
+        int leader = servers.findLeader();
+        assertTrue(leader >= 0, "the startup election must choose a leader");
+        byte[] first = new byte[]{21};
+        servers.zk[leader].create("/specula-exit", first, Ids.OPEN_ACL_UNSAFE, CreateMode.PERSISTENT);
+        observeSyncThreads("before-leader-loss");
+
+        servers.mt[leader].shutdown();
+        waitForOne(servers.zk[leader], States.CONNECTING);
+        int live = leader == 0 ? 1 : 0;
+        byte[] second = new byte[]{22};
+        setDataWithRetry(live, "/specula-exit", second);
+        assertArrayEquals(second, servers.zk[live].getData("/specula-exit", false, null));
+        observeSyncThreads("after-leader-loss");
+
+        servers.mt[leader].start();
+        servers.restartClient(leader, this);
+        waitForOne(servers.zk[leader], States.CONNECTED);
+        assertArrayEquals(second, servers.zk[leader].getData("/specula-exit", false, null));
+        observeSyncThreads("after-rejoin");
+
+        servers.shutDownAllServers();
+        waitForAll(servers.zk, States.CONNECTING);
+        observeSyncThreads("after-shutdown");
+    }
+
+    /**
+     * MC-1 reproduction (mechanism): when a serving follower leaves FOLLOWING
+     * (its leader stops), Learner.shutdown must stop that follower's
+     * SyncRequestProcessor ("SyncThread:<sid>"); after re-election each live
+     * server should run exactly one, and none after all servers shut down.
+     */
+    @Test
+    public void testServingLearnerExitStopsSyncProcessor() throws Exception {
+        numServers = 3;
+        servers = LaunchServers(numServers, 500);
+        int leader = servers.findLeader();
+        assertTrue(leader >= 0, "the startup election must choose a leader");
+        servers.zk[leader].create("/specula-repro", new byte[]{1}, Ids.OPEN_ACL_UNSAFE, CreateMode.PERSISTENT);
+
+        servers.mt[leader].shutdown();
+        waitForOne(servers.zk[leader], States.CONNECTING);
+        int live = leader == 0 ? 1 : 0;
+        setDataWithRetry(live, "/specula-repro", new byte[]{2});
+        Map<String, Integer> afterLoss = syncThreadCountsSettled(1);
+        observeSyncThreads("repro-after-leader-loss");
+        for (Map.Entry<String, Integer> e : afterLoss.entrySet()) {
+            org.junit.jupiter.api.Assertions.assertEquals(1, e.getValue().intValue(),
+                "live " + e.getKey() + " threads after one learner exit: " + afterLoss);
+        }
+        servers.shutDownAllServers();
+        waitForAll(servers.zk, States.CONNECTING);
+        Map<String, Integer> afterShutdown = syncThreadCountsSettled(0);
+        observeSyncThreads("repro-after-shutdown");
+        org.junit.jupiter.api.Assertions.assertTrue(afterShutdown.isEmpty(),
+            "SyncRequestProcessor threads still running after QuorumPeer shutdown: " + afterShutdown);
+    }
+
+    /** Polls up to 10s for every SyncThread count to settle at or below the target. */
+    private static Map<String, Integer> syncThreadCountsSettled(int target) throws InterruptedException {
+        Map<String, Integer> counts = new TreeMap<>();
+        for (int i = 0; i < 50; i++) {
+            counts.clear();
+            for (Thread t : Thread.getAllStackTraces().keySet()) {
+                if (t.isAlive() && t.getName().startsWith("SyncThread:")) {
+                    counts.merge(t.getName(), 1, Integer::sum);
+                }
+            }
+            boolean settled = true;
+            for (int c : counts.values()) {
+                if (c > target) {
+                    settled = false;
+                }
+            }
+            if (settled) {
+                break;
+            }
+            Thread.sleep(200);
+        }
+        return counts;
+    }
+
+    private void setDataWithRetry(int client, String path, byte[] data) throws Exception {
+        long deadline = System.currentTimeMillis() + 60000;
+        while (true) {
+            try {
+                waitForOne(servers.zk[client], States.CONNECTED);
+                servers.zk[client].setData(path, data, -1);
+                return;
+            } catch (KeeperException.ConnectionLossException e) {
+                if (System.currentTimeMillis() > deadline) {
+                    throw e;
+                }
+                Thread.sleep(200);
+            }
+        }
+    }
+
+    private static void observeSyncThreads(String label) {
+        Map<String, Integer> counts = new TreeMap<>();
+        for (Thread t : Thread.getAllStackTraces().keySet()) {
+            if (t.isAlive() && t.getName().startsWith("SyncThread:")) {
+                counts.merge(t.getName(), 1, Integer::sum);
+            }
+        }
+        LOG.info("SPECULA_OBSERVATION {} liveSyncThreads={}", label, counts);
+        System.out.println("SPECULA_OBSERVATION " + label + " liveSyncThreads=" + counts);
+    }
+}
