+package org.apache.zookeeper.server.quorum;
+
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.nio.file.StandardOpenOption;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+import org.apache.zookeeper.ZooDefs.OpCode;
+import org.apache.zookeeper.server.Request;
+import org.apache.zookeeper.server.SyncRequestProcessor;
+import org.apache.zookeeper.server.ZKDatabase;
+import org.apache.zookeeper.server.ZooKeeperServer;
+import org.apache.zookeeper.server.persistence.SnapshotInfo;
+import org.apache.zookeeper.txn.TxnHeader;
+
+/**
+ * Opt-in NDJSON probe used by the Specula harness (schema version 3).
+ * Dormant unless the JVM property specula.trace.file is set. All emission and
+ * probe bookkeeping happens under one lock so the file order is the observed
+ * order. Probes never change control flow; writer I/O errors are swallowed.
+ */
+public final class SpeculaTrace {
+
+    public static final Object LOCK = new Object();
+    private static final Map<Long, Integer> TX_IDS = new HashMap<>();
+    private static final TreeMap<Long, Integer> TX_BY_ZXID = new TreeMap<>();
+    private static final Map<Object, List<Integer>> QUEUES = new IdentityHashMap<>();
+    private static final Set<Object> LEAKED = Collections.newSetFromMap(new IdentityHashMap<>());
+    private static final ThreadLocal<Boolean> RELOAD = ThreadLocal.withInitial(() -> Boolean.FALSE);
+    /** Role cache: avoids calling the synchronized QuorumPeer.getPeerState() under LOCK. */
+    private static final Map<Long, String> ROLE = new HashMap<>();
+    private static BufferedWriter writer;
+    private static int nextTx = 1;
+
+    private SpeculaTrace() {
+    }
+
+    private static boolean enabled() {
+        String configured = System.getProperty("specula.trace.file");
+        return configured != null && !configured.isEmpty();
+    }
+
+    public static boolean isModeledType(int type) {
+        return type == OpCode.create
+               || type == OpCode.create2
+               || type == OpCode.delete
+               || type == OpCode.setData;
+    }
+
+    public static boolean isModeled(Request request) {
+        return request != null && request.getHdr() != null && isModeledType(request.getHdr().getType());
+    }
+
+    private static int tx(long zxid) {
+        Integer existing = TX_IDS.get(zxid);
+        if (existing != null) {
+            return existing;
+        }
+        int assigned = nextTx++;
+        TX_IDS.put(zxid, assigned);
+        TX_BY_ZXID.put(zxid, assigned);
+        return assigned;
+    }
+
+    /** Dense id of the last modeled transaction with zxid <= the given zxid. */
+    private static int floorId(long zxid) {
+        Map.Entry<Long, Integer> e = TX_BY_ZXID.floorEntry(zxid);
+        return e == null ? 0 : e.getValue();
+    }
+
+    private static BufferedWriter writer() throws IOException {
+        if (writer == null) {
+            String configured = System.getProperty("specula.trace.file");
+            if (configured == null || configured.isEmpty()) {
+                return null;
+            }
+            Path path = Paths.get(configured);
+            Path parent = path.toAbsolutePath().getParent();
+            if (parent != null) {
+                Files.createDirectories(parent);
+            }
+            writer = Files.newBufferedWriter(
+                path,
+                StandardCharsets.UTF_8,
+                StandardOpenOption.CREATE,
+                StandardOpenOption.APPEND);
+        }
+        return writer;
+    }
+
+    private static String node(long sid) {
+        return "s" + sid;
+    }
+
+    private static long epoch(QuorumPeer self, boolean accepted) {
+        try {
+            return accepted ? self.getAcceptedEpoch() : self.getCurrentEpoch();
+        } catch (IOException e) {
+            return -1;
+        }
+    }
+
+    private static String list(Collection<Integer> ids) {
+        StringBuilder sb = new StringBuilder("[");
+        boolean first = true;
+        for (Integer id : ids) {
+            if (!first) {
+                sb.append(',');
+            }
+            sb.append(id);
+            first = false;
+        }
+        return sb.append(']').toString();
+    }
+
+    private static String nodes(Collection<Long> sids) {
+        List<Long> sorted = new ArrayList<>(sids);
+        Collections.sort(sorted);
+        StringBuilder sb = new StringBuilder("[");
+        boolean first = true;
+        for (Long sid : sorted) {
+            if (!first) {
+                sb.append(',');
+            }
+            sb.append('"').append(node(sid)).append('"');
+            first = false;
+        }
+        return sb.append(']').toString();
+    }
+
+    /**
+     * Runs a traced state write and its emission atomically w.r.t. all other
+     * emissions; without tracing it only runs the write.
+     */
+    public static void atomically(Runnable write, Runnable probe) {
+        if (!enabled()) {
+            write.run();
+            return;
+        }
+        synchronized (LOCK) {
+            write.run();
+            probe.run();
+        }
+    }
+
+    private static String commonState(QuorumPeer self, String extra) {
+        return "{\"running\":" + self.isRunning()
+               + ",\"role\":\"" + ROLE.getOrDefault(self.getId(), "LOOKING") + "\""
+               + ",\"phase\":\"" + self.getZabState() + "\""
+               + ",\"syncMode\":\"" + self.getSyncMode() + "\""
+               + ",\"acceptedEpoch\":" + epoch(self, true)
+               + ",\"currentEpoch\":" + epoch(self, false)
+               + (extra == null || extra.isEmpty() ? "" : "," + extra)
+               + "}";
+    }
+
+    private static void emit(QuorumPeer self, String name, String stateExtra, String msg) {
+        synchronized (LOCK) {
+            try {
+                BufferedWriter out = writer();
+                if (out == null) {
+                    return;
+                }
+                out.write("{\"tag\":\"trace\",\"schemaVersion\":3,\"ts\":" + System.nanoTime()
+                          + ",\"event\":{\"name\":\"" + name
+                          + "\",\"nid\":\"" + node(self.getId())
+                          + "\",\"state\":" + commonState(self, stateExtra)
+                          + ",\"msg\":" + msg + "}}");
+                out.newLine();
+                out.flush();
+            } catch (IOException ignored) {
+                // Tracing must not alter the system behavior under test.
+            }
+        }
+    }
+
+    /** Recovered history: modeled txns covered by the loaded snapshot, then replayed WAL records. */
+    private static List<Integer> recovered(QuorumPeer self, ZKDatabase db) {
+        List<Integer> out = new ArrayList<>();
+        SnapshotInfo info = self.getTxnFactory() == null ? null : self.getTxnFactory().getLastSnapshotInfo();
+        long snapZxid = info == null ? -1 : info.zxid;
+        out.addAll(TX_BY_ZXID.headMap(snapZxid, true).values());
+        for (Leader.Proposal p : db.getCommittedLog()) {
+            long z = p.packet.getZxid();
+            Integer id = TX_IDS.get(z);
+            if (z > snapZxid && id != null) {
+                out.add(id);
+            }
+        }
+        return out;
+    }
+
+    public static void beginReload() {
+        RELOAD.set(Boolean.TRUE);
+    }
+
+    public static void endReload() {
+        RELOAD.set(Boolean.FALSE);
+    }
+
+    public static void recovery(QuorumPeer self) {
+        if (!enabled()) {
+            return;
+        }
+        synchronized (LOCK) {
+            String name = RELOAD.get() ? "ReloadDatabase" : "RestartLoadDatabase";
+            if (!RELOAD.get()) {
+                ROLE.put(self.getId(), "LOOKING");
+            }
+            emit(self, name, "\"recovered\":" + list(recovered(self, self.getZkDb())), "{}");
+        }
+    }
+
+    public static void shutdown(QuorumPeer self) {
+        emit(self, "GracefulShutdown", "", "{}");
+    }
+
+    public static void learnerShutdown(QuorumPeer self, ZooKeeperServer zk, boolean served, boolean full) {
+        if (!enabled()) {
+            return;
+        }
+        SyncRequestProcessor sp = zk instanceof LearnerZooKeeperServer
+            ? ((LearnerZooKeeperServer) zk).syncProcessor : null;
+        boolean alive = sp != null && sp.isAlive();
+        synchronized (LOCK) {
+            boolean leakedNow = alive && !LEAKED.contains(sp);
+            List<Integer> q = new ArrayList<>();
+            if (leakedNow) {
+                LEAKED.add(sp);
+                q.addAll(QUEUES.getOrDefault(sp, Collections.emptyList()));
+            }
+            boolean dbInit = zk.getZKDatabase() != null && zk.getZKDatabase().isInitialized();
+            emit(self, "LearnerShutdown", "",
+                 "{\"served\":" + served + ",\"full\":" + full + ",\"leakedNow\":" + leakedNow
+                 + ",\"leakedQueue\":" + list(q) + ",\"dbInit\":" + dbInit + "}");
+        }
+    }
+
+    public static void electionResult(QuorumPeer self, Vote vote) {
+        emit(self, "FinishElection", "",
+             "{\"leader\":\"" + node(vote.getId())
+             + "\",\"electionEpoch\":" + vote.getElectionEpoch() + "}");
+    }
+
+    public static void peerPhase(QuorumPeer self) {
+        emit(self, "SetZabState", "", "{}");
+    }
+
+    public static void peerRole(QuorumPeer self, QuorumPeer.ServerState newState) {
+        synchronized (LOCK) {
+            ROLE.put(self.getId(), newState.toString());
+            emit(self, "SetPeerState", "", "{}");
+        }
+    }
+
+    public static void acceptedEpoch(QuorumPeer self) {
+        emit(self, "PersistAcceptedEpoch", "", "{}");
+    }
+
+    public static void currentEpoch(QuorumPeer self) {
+        emit(self, "PersistCurrentEpoch", "", "{}");
+    }
+
+    public static void syncMode(QuorumPeer self) {
+        emit(self, "ChooseSyncMode", "", "{}");
+    }
+
+    public static void loadSyncSnapshot(QuorumPeer self, ZooKeeperServer zk) {
+        if (!enabled()) {
+            return;
+        }
+        synchronized (LOCK) {
+            emit(self, "LoadSyncSnapshot", "",
+                 "{\"lastZxid\":" + floorId(zk.getZKDatabase().getDataTreeLastProcessedZxid()) + "}");
+        }
+    }
+
+    public static void truncateLog(QuorumPeer self, ZooKeeperServer zk) {
+        if (!enabled()) {
+            return;
+        }
+        synchronized (LOCK) {
+            emit(self, "TruncateLog", "\"recovered\":" + list(recovered(self, zk.getZKDatabase())),
+                 "{\"lastZxid\":" + floorId(zk.getZKDatabase().getDataTreeLastProcessedZxid()) + "}");
+        }
+    }
+
+    public static void syncCommit(QuorumPeer self, ZooKeeperServer zk, TxnHeader hdr) {
+        if (!enabled() || hdr == null || !isModeledType(hdr.getType())) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(hdr.getZxid());
+            emit(self, "ApplySyncCommit", "",
+                 "{\"tx\":" + id + ",\"lastZxid\":" + floorId(zk.getZKDatabase().getDataTreeLastProcessedZxid()) + "}");
+        }
+    }
+
+    public static void syncComplete(QuorumPeer self) {
+        emit(self, "CompleteLearnerSync", "",
+             "{\"leader\":\"" + node(self.getLeaderId()) + "\"}");
+    }
+
+    public static void newLeaderQuorum(QuorumPeer self) {
+        emit(self, "FormNewLeaderQuorum", "", "{}");
+    }
+
+    public static void snapshot(QuorumPeer self, boolean begin, boolean syncSnap, long lastProcessedZxid) {
+        if (!enabled()) {
+            return;
+        }
+        synchronized (LOCK) {
+            emit(self, begin ? "BeginSnapshot" : "FinishSnapshot", "",
+                 "{\"syncSnap\":" + syncSnap + ",\"lastZxid\":" + floorId(lastProcessedZxid) + "}");
+        }
+    }
+
+    private static QuorumPeer selfOf(ZooKeeperServer zks) {
+        return zks instanceof QuorumZooKeeperServer ? ((QuorumZooKeeperServer) zks).self : null;
+    }
+
+    /** SyncRequestProcessor.processRequest: enqueue and record under one lock. */
+    public static void queueForSync(ZooKeeperServer zks, SyncRequestProcessor sp, Request request, Runnable enqueue) {
+        QuorumPeer self = selfOf(zks);
+        if (!enabled() || self == null || !isModeled(request)) {
+            enqueue.run();
+            return;
+        }
+        synchronized (LOCK) {
+            enqueue.run();
+            int id = tx(request.zxid);
+            List<Integer> q = QUEUES.computeIfAbsent(sp, k -> new ArrayList<>());
+            q.add(id);
+            emit(self, "QueueForSync", "\"queue\":" + list(q), "{\"tx\":" + id + "}");
+        }
+    }
+
+    /** SyncRequestProcessor.flush: after the log commit, one event per flushed modeled request. */
+    public static void flushed(ZooKeeperServer zks, SyncRequestProcessor sp, Collection<Request> toFlush) {
+        QuorumPeer self = selfOf(zks);
+        if (!enabled() || self == null) {
+            return;
+        }
+        synchronized (LOCK) {
+            List<Integer> q = QUEUES.computeIfAbsent(sp, k -> new ArrayList<>());
+            boolean leaked = LEAKED.contains(sp);
+            for (Request request : toFlush) {
+                if (!isModeled(request)) {
+                    continue;
+                }
+                int id = tx(request.zxid);
+                q.remove(Integer.valueOf(id));
+                emit(self, "FlushTxnLog", "\"queue\":" + list(q),
+                     "{\"tx\":" + id + ",\"leaked\":" + leaked + "}");
+            }
+        }
+    }
+
+    public static void applyTxn(ZooKeeperServer zks, Request request) {
+        QuorumPeer self = selfOf(zks);
+        if (!enabled() || self == null || !isModeled(request)) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(request.zxid);
+            emit(self, "ApplyTxn", "",
+                 "{\"tx\":" + id + ",\"lastZxid\":" + floorId(zks.getZKDatabase().getDataTreeLastProcessedZxid()) + "}");
+        }
+    }
+
+    public static void pending(String name, FollowerZooKeeperServer fzk, Request request, Collection<Request> pendingTxns) {
+        if (!enabled() || !isModeled(request)) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(request.zxid);
+            List<Integer> p = new ArrayList<>();
+            for (Request r : pendingTxns) {
+                if (isModeled(r)) {
+                    p.add(tx(r.zxid));
+                }
+            }
+            emit(fzk.self, name, "\"pending\":" + list(p), "{\"tx\":" + id + "}");
+        }
+    }
+
+    public static void txn(String name, QuorumPeer self, Request request) {
+        if (!enabled() || !isModeled(request)) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(request.zxid);
+            emit(self, name, "", "{\"tx\":" + id + "}");
+        }
+    }
+
+    private static Collection<Long> ackset(Leader.Proposal p) {
+        if (p.qvAcksetPairs.isEmpty()) {
+            return Collections.emptyList();
+        }
+        return p.qvAcksetPairs.get(0).getAckset();
+    }
+
+    public static void ack(QuorumPeer self, long source, Leader.Proposal p) {
+        if (!enabled() || !isModeled(p.request)) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(p.request.zxid);
+            emit(self, "RecordProposalAck", "\"acks\":" + nodes(ackset(p)),
+                 "{\"tx\":" + id + ",\"source\":\"" + node(source) + "\"}");
+        }
+    }
+
+    public static void commit(QuorumPeer self, Leader.Proposal p) {
+        if (!enabled() || !isModeled(p.request)) {
+            return;
+        }
+        synchronized (LOCK) {
+            int id = tx(p.request.zxid);
+            emit(self, "CommitProposal", "\"commitWitness\":" + nodes(ackset(p)), "{\"tx\":" + id + "}");
+        }
+    }
+}
