+    eng.last_seen_vote = vote;
+    eng.state.log_ids.append(log_id(1, 1, 1));
+    eng.state.accept_io(crate::raft_state::IOId::new_log_io(vote.into_committed(), Some(log_id(1, 1, 1))));
+    clear(&mut eng);
+    rec.emit("Bootstrap", 3, json!({}), &eng)?;
+
+    eng.elect();
