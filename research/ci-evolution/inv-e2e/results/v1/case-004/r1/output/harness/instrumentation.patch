+//! Specula update scenario (harness only): TransferLeader whose `to` is a learner.
+//!
+//! Derived from the visible diff: `RaftMsg::TransferLeader` calls `Engine::elect()` on `to`
+//! after checking only `vote == from` (openraft/src/core/raft_core.rs TransferLeader branch).
+//! The scenario follows the documented usage "Call this method on every node in the cluster
+//! with the same arguments" (openraft/src/raft/mod.rs transfer_leader doc) and records what the
+//! cluster does. It deliberately asserts nothing about the outcome; RaftCore window traces are
+//! written when built with `--features specula-trace` and `SPECULA_TRACE_DIR` is set.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use maplit::btreeset;
+use openraft::Config;
+
+use crate::fixtures::ut_harness;
+use crate::fixtures::RaftRouter;
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_transfer_leader_to_learner() -> anyhow::Result<()> {
+    let config = Arc::new(
+        Config {
+            election_timeout_min: 150,
+            election_timeout_max: 300,
+            ..Default::default()
+        }
+        .validate()?,
+    );
+
+    let mut router = RaftRouter::new(config.clone());
+
+    tracing::info!("--- initializing cluster: voters {{0,1,2}}, learner {{3}}");
+    let log_index = router.new_cluster(btreeset! {0,1,2}, btreeset! {3}).await?;
+    router.wait_for_log(&btreeset! {0,1,2,3}, Some(log_index), Some(Duration::from_millis(3000)), "all caught up").await?;
+
+    let n0 = router.get_raft_handle(&0)?;
+    let n3 = router.get_raft_handle(&3)?;
+
+    let metrics = n0.metrics().borrow().clone();
+    let leader_vote = metrics.vote;
+    let last_log_id = metrics.last_applied;
+
+    n3.wait(Some(Duration::from_millis(3000)))
+        .metrics(|m| m.vote == leader_vote, "learner 3 holds the leader vote")
+        .await?;
+
+    tracing::info!("--- transfer Leader from 0 to learner 3, called on every node");
+    let mut calls = vec![];
+    for id in [0u64, 1, 2, 3] {
+        let n = router.get_raft_handle(&id)?;
+        let res = n.transfer_leader(leader_vote, 3, last_log_id).await;
+        calls.push(format!("{{\"node\":{},\"transfer_leader\":\"{:?}\"}}", id, res));
+    }
+
+    tokio::time::sleep(Duration::from_millis(1500)).await;
+
+    let mut nodes = vec![];
+    for id in [0u64, 1, 2, 3] {
+        let n = router.get_raft_handle(&id)?;
+        let alive = n.is_initialized().await;
+        let m = n.metrics().borrow().clone();
+        nodes.push(format!(
+            "{{\"node\":{},\"is_initialized\":\"{:?}\",\"running_state\":\"{:?}\",\"state\":\"{:?}\",\"vote\":\"{}\",\"current_leader\":\"{:?}\"}}",
+            id, alive, m.running_state, m.state, m.vote, m.current_leader
+        ));
+    }
+
+    let obs = format!(
+        "{{\"scenario\":\"transfer_leader_to_learner\",\"leader_vote\":\"{}\",\"calls\":[{}],\"after_1500ms\":[{}]}}\n",
+        leader_vote,
+        calls.join(","),
+        nodes.join(",")
+    );
+    tracing::info!("specula observations: {}", obs);
+    if let Ok(dir) = std::env::var("SPECULA_TRACE_DIR") {
+        std::fs::write(format!("{}/observations.json", dir), &obs)?;
+    }
+    println!("SPECULA_OBSERVATIONS {}", obs);
+
+    Ok(())
+}
