+    let m = membership(vec![btreeset! {1,2}], btreeset! {3});
+    eng.leader_handler()?.leader_append_entries(vec![Entry::new_membership(LogId::default(), m)]);
+    rec.emit("LeaderAppend", 1, json!({"kind": "learner", "configs": [[1,2]], "learners": [3]}), &eng)?;
+    Ok(())
+}
