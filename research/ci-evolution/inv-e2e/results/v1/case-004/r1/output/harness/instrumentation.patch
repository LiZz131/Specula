+    let mut eng = base_engine(3, btreeset! {1,2}, btreeset! {3});
+    clear(&mut eng);
+    rec.emit("Bootstrap", 3, json!({}), &eng)?;
+
+    let vote = Vote::new_committed(1, 1);
+    let joint = membership(vec![btreeset! {1,2}, btreeset! {2,3}], btreeset! {});
+    eng.append_entries(&vote, Some(log_id(0, 0, 0)), vec![
+        Entry::new_blank(log_id(1, 1, 1)),
+        Entry::new_membership(log_id(1, 1, 2), joint),
+    ])?;
+    rec.emit(
+        "FollowerAppend",
+        3,
+        json!({"owner": 1, "term": 1, "prev": 0, "count": 2,
+               "entries": [blank_arg(1, 1, 1), membership_arg(1, 1, 2, vec![vec![1,2], vec![2,3]], vec![])]}),
