+// ---------------------------------------------------------------------------------------------
+// Update-focused scenarios (TransferLeader revision). See spec/instrumentation-spec.md.
+// ---------------------------------------------------------------------------------------------
+
+fn blank_arg(term: u64, node: u64, index: u64) -> Value {
+    json!({"term": term, "node": node, "index": index, "kind": "blank", "configs": [], "learners": []})
+}
+
+fn membership_arg(term: u64, node: u64, index: u64, configs: Vec<Vec<u64>>, learners: Vec<u64>) -> Value {
+    json!({"term": term, "node": node, "index": index, "kind": "membership", "configs": configs, "learners": learners})
+}
+
+/// Learner 3 of voters {1,2} that already accepted leader 1's committed vote and blank log.
+fn learner_following_leader1() -> Engine<UTConfig> {
+    let mut eng = base_engine(3, btreeset! {1,2}, btreeset! {3});
+    let vote = Vote::new_committed(1, 1);
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::from_millis(0), vote);
+    eng.last_seen_vote = vote;
+    eng.state.log_ids.append(log_id(1, 1, 1));
+    eng.state.accept_io(crate::raft_state::IOId::new_log_io(vote.into_committed(), Some(log_id(1, 1, 1))));
+    clear(&mut eng);
+    eng
+}
+
+/// U1: `RaftMsg::TransferLeader{from: (1,1,committed), to: 3}` makes RaftCore call `Engine::elect()`
+/// on learner 3 (core/raft_core.rs:1197-1200). This scenario drives the same production Engine
+/// calls: `elect()`, then the local self-grant that SaveVote completion delivers
+/// (core/raft_core.rs:1670-1682). A panic is recorded as `VoteResponsePanic` with the pre-state.
+#[test]
+fn specula_trace_elect_learner() -> anyhow::Result<()> {
+    let Some(mut rec) = Recorder::from_env()? else { return Ok(()); };
+    let mut eng = learner_following_leader1();
+    rec.emit("Bootstrap", 3, json!({}), &eng)?;
+
+    eng.elect();
+    rec.emit("Elect", 3, json!({}), &eng)?;
+    clear(&mut eng);
+
+    let v = *eng.state.vote_ref();
+    let args = json!({"peer": 3, "term": v.leader_id.term, "owner": 3, "committed": false});
+    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        eng.handle_vote_resp(3, VoteResponse::new(v, None));
+    }));
+    match res {
+        Ok(()) => rec.emit("VoteResponse", 3, args, &eng)?,
+        Err(_) => rec.emit("VoteResponsePanic", 3, args, &eng)?,
+    }
+    Ok(())
+}
+
