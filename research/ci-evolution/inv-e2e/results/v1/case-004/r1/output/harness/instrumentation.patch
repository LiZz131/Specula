+//! Specula trace capture for the updated revision (TransferLeader).
+//!
+//! Shared by the Engine unit harness (`engine::specula_trace_tests`, `cfg(test)`) and by the
+//! RaftCore window probes (cargo feature `specula-trace`). Capture is read-only: it observes the
+//! Engine state owned by the single RaftCore task, synchronously, before and after one real step.
+//! Without `SPECULA_TRACE_DIR` the window probes do nothing.
+
+use std::collections::BTreeSet;
+use std::fs::File;
+use std::io::Write;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use serde_json::json;
+use serde_json::Value;
+
+use crate::engine::Command;
+use crate::engine::Engine;
+use crate::progress::Progress;
+use crate::raft_state::LogStateReader;
+use crate::LogId;
+use crate::NodeId;
+use crate::RaftTypeConfig;
+use crate::Vote;
+
+/// Node ids in the traced scenarios are `u64`; generic ids are rendered through `Display`.
+pub(crate) fn nid<N: NodeId>(n: &N) -> u64 {
+    n.to_string().parse::<u64>().unwrap_or(u64::MAX)
+}
+
+pub(crate) fn command_name<C: RaftTypeConfig>(cmd: &Command<C>) -> &'static str {
+    match cmd {
+        Command::UpdateIOProgress { .. } => "UpdateIOProgress",
+        Command::AppendInputEntries { .. } => "AppendInputEntries",
+        Command::ReplicateCommitted { .. } => "ReplicateCommitted",
+        Command::SaveCommitted { .. } => "SaveCommitted",
+        Command::Apply { .. } => "Apply",
+        Command::Replicate { .. } => "Replicate",
+        Command::RebuildReplicationStreams { .. } => "RebuildReplicationStreams",
+        Command::SaveVote { .. } => "SaveVote",
+        Command::SendVote { .. } => "SendVote",
+        Command::PurgeLog { .. } => "PurgeLog",
+        Command::TruncateLog { .. } => "TruncateLog",
+        Command::StateMachine { .. } => "StateMachine",
+        Command::Respond { .. } => "Respond",
+    }
+}
+
+fn idx<N: NodeId>(log_id: Option<&LogId<N>>) -> i64 {
+    log_id.map(|x| x.index as i64).unwrap_or(-1)
+}
+
+/// Capture the Engine state. Only commands queued after the first `skip_cmds` entries of the
+/// output queue are reported, i.e. the commands pushed by the observed step.
+pub(crate) fn capture<C: RaftTypeConfig>(eng: &Engine<C>, skip_cmds: usize) -> Value {
+    let vote = eng.state.vote_ref();
+    let seen = eng.last_seen_vote;
+    let effective = eng.state.membership_state.effective();
+    let committed_membership = eng.state.membership_state.committed();
+    let last_index = eng.state.last_log_id().map(|x| x.index as i64).unwrap_or(-1);
+
+    let logs = if last_index < 0 {
+        Vec::new()
+    } else {
+        (0..=last_index as u64)
+            .map(|i| {
+                let x = eng.state.get_log_id(i).expect("LogIdList must cover every retained index");
+                json!({"term": x.leader_id.term, "node": nid(&x.leader_id.node_id), "index": x.index})
+            })
+            .collect::<Vec<_>>()
+    };
+
+    let configs = effective
+        .membership()
+        .get_joint_config()
+        .iter()
+        .map(|c| c.iter().map(nid).collect::<Vec<_>>())
+        .collect::<Vec<_>>();
+    let learners = effective.membership().learner_ids().map(|x| nid(&x)).collect::<Vec<_>>();
+    let granters = eng
+        .candidate_ref()
+        .map(|c| c.granters().map(|x| nid(&x)).collect::<Vec<_>>())
+        .unwrap_or_default();
+    let (cand_term, cand_node, cand_index) = match eng.candidate_ref().and_then(|c| c.last_log_id().copied()) {
+        Some(x) => (x.leader_id.term, nid(&x.leader_id.node_id), x.index as i64),
+        None => (0, 0, -1),
+    };
+    let matches = eng
+        .leader_ref()
+        .map(|l| {
+            l.progress
+                .iter()
+                .map(|(peer, p)| json!({"peer": nid(peer), "index": idx(p.matching.as_ref())}))
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    let commands = eng
+        .output
+        .iter_commands()
+        .skip(skip_cmds)
+        .map(command_name)
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .collect::<Vec<_>>();
+
+    json!({
+        "node_id": nid(&eng.config.id),
+        "vote_term": vote.leader_id.term,
+        "vote_node": nid(&vote.leader_id.node_id),
+        "vote_committed": vote.committed,
+        "last_seen_term": seen.leader_id.term,
+        "last_seen_node": nid(&seen.leader_id.node_id),
+        "last_seen_committed": seen.committed,
+        "role": format!("{:?}", eng.state.server_state),
+        "logs": logs,
+        "last_index": last_index,
+        "commit_index": idx(eng.state.committed()),
+        "effective_index": idx(effective.log_id().as_ref()),
+        "committed_membership_index": idx(committed_membership.log_id().as_ref()),
+        "effective_configs": configs,
+        "learners": learners,
+        "candidate": eng.candidate_ref().is_some(),
+        "candidate_last_term": cand_term,
+        "candidate_last_node": cand_node,
+        "candidate_last_index": cand_index,
+        "granters": granters,
+        "leader": eng.leader_ref().is_some(),
+        "matches": matches,
+        "accepted_index": eng.state.accepted_io().and_then(|x| x.last_log_id()).map(|x| x.index as i64).unwrap_or(-1),
+        "commands": commands,
+    })
+}
+
+// ---------------------------------------------------------------------------------------------
+// RaftCore window probes
+// ---------------------------------------------------------------------------------------------
+
+static SEQ: AtomicU64 = AtomicU64::new(0);
+static ARMED: AtomicBool = AtomicBool::new(false);
+static LAST_TS: AtomicU64 = AtomicU64::new(0);
+
+fn window_dir() -> Option<String> {
+    std::env::var("SPECULA_TRACE_DIR").ok()
+}
+
+fn armed() -> bool {
+    ARMED.load(Ordering::SeqCst) || std::env::var("SPECULA_TRACE_WINDOW_ALL").map(|x| x == "1").unwrap_or(false)
+}
+
+fn ts() -> u64 {
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_nanos() as u64).unwrap_or(0);
+    let mut prev = LAST_TS.load(Ordering::SeqCst);
+    loop {
+        let next = std::cmp::max(now, prev + 1);
+        match LAST_TS.compare_exchange(prev, next, Ordering::SeqCst, Ordering::SeqCst) {
+            Ok(_) => return next,
+            Err(x) => prev = x,
+        }
+    }
+}
+
+/// Pre-state of a window: the Engine state plus the current output-queue length.
+pub(crate) struct Pre {
+    state: Value,
+    skip: usize,
+}
+
+pub(crate) fn pre<C: RaftTypeConfig>(eng: &Engine<C>) -> Option<Pre> {
+    window_dir()?;
+    let skip = eng.output.len();
+    Some(Pre {
+        state: capture(eng, skip),
+        skip,
+    })
+}
+
+pub(crate) fn pre_if_armed<C: RaftTypeConfig>(eng: &Engine<C>) -> Option<Pre> {
+    if !armed() {
+        return None;
+    }
+    pre(eng)
+}
+
+fn window_path<C: RaftTypeConfig>(label: &str, eng: &Engine<C>) -> Option<String> {
+    let dir = window_dir()?;
+    let node = nid(&eng.config.id);
+    let seq = SEQ.fetch_add(1, Ordering::SeqCst);
+    Some(format!("{}/{:05}-{}-n{}.ndjson", dir, seq, label, node))
+}
+
+fn write_lines(path: &str, node: u64, pre_state: &Value, name: &str, args: &Value, post: &Value) {
+    let l1 = json!({"tag": "trace", "ts": ts().to_string(),
+                    "event": {"name": "Bootstrap", "node": node, "args": {}, "state": pre_state}});
+    let l2 = json!({"tag": "trace", "ts": ts().to_string(),
+                    "event": {"name": name, "node": node, "args": args, "state": post}});
+    let res = File::create(path).and_then(|mut f| {
+        f.write_all(format!("{}\n{}\n", l1, l2).as_bytes())?;
+        f.flush()
+    });
+    if let Err(e) = res {
+        tracing::error!("specula trace window write failed: {}: {}", path, e);
+    }
+}
+
+fn write_window<C: RaftTypeConfig>(label: &str, name: &str, eng: &Engine<C>, args: Value, pre: Pre) {
+    let Some(path) = window_path(label, eng) else { return };
+    let post = capture(eng, pre.skip);
+    write_lines(&path, nid(&eng.config.id), &pre.state, name, &args, &post);
+}
+
+fn vote_args<N: NodeId>(v: &Vote<N>) -> (u64, u64, bool) {
+    (v.leader_id.term, nid(&v.leader_id.node_id), v.committed)
+}
+
+/// After `RaftMsg::TransferLeader` was handled (core/raft_core.rs TransferLeader branch).
+pub(crate) fn transfer_window<C: RaftTypeConfig>(
+    eng: &Engine<C>,
+    pre: Option<Pre>,
+    from: &Vote<C::NodeId>,
+    to: &C::NodeId,
+) {
+    ARMED.store(true, Ordering::SeqCst);
+    let Some(pre) = pre else { return };
+    let (t, n, c) = vote_args(from);
+    let pre_vote = (
+        pre.state["vote_term"].as_u64().unwrap_or(0),
+        pre.state["vote_node"].as_u64().unwrap_or(0),
+        pre.state["vote_committed"].as_bool().unwrap_or(false),
+    );
+    let label = if pre_vote != (t, n, c) {
+        "transfer-ignored"
+    } else if nid(&eng.config.id) == nid(to) {
+        "transfer-elect"
+    } else {
+        "transfer-lease"
+    };
+    write_window(
+        label,
+        "TransferLeader",
+        eng,
+        json!({"from_term": t, "from_node": n, "from_committed": c, "to": nid(to)}),
+        pre,
+    );
+}
+
+/// After `Engine::handle_vote_req` called from `RaftCore::handle_vote_request`.
+pub(crate) fn vote_request_window<C: RaftTypeConfig>(
+    eng: &Engine<C>,
+    pre: Option<Pre>,
+    vote: &Vote<C::NodeId>,
+    last_log_id: Option<&LogId<C::NodeId>>,
+) {
+    let Some(pre) = pre else { return };
+    let (t, n, c) = vote_args(vote);
+    let (lt, ln, li) = match last_log_id {
+        Some(x) => (x.leader_id.term, nid(&x.leader_id.node_id), x.index as i64),
+        None => (0, 0, -1),
+    };
+    write_window(
+        "vote-request",
+        "VoteRequest",
+        eng,
+        json!({"candidate": n, "term": t, "committed": c, "last_term": lt, "last_node": ln, "last_index": li}),
+        pre,
+    );
+}
+
+/// A vote-response window in progress. `vote_response_begin` writes the window as a
+/// `VoteResponsePanic` (pre-state only) before `Engine::handle_vote_resp` runs; if the call returns,
+/// `vote_response_end` overwrites the same file with the real post-state. A file left in the
+/// `VoteResponsePanic` form therefore records a panic inside `handle_vote_resp`.
+pub(crate) struct PendingResponse {
+    path: String,
+    pre: Pre,
+    args: Value,
+}
+
+/// Before `Engine::handle_vote_resp` called for `Notification::VoteResponse`.
+pub(crate) fn vote_response_begin<C: RaftTypeConfig>(
+    eng: &Engine<C>,
+    pre: Option<Pre>,
+    peer: &C::NodeId,
+    vote: &Vote<C::NodeId>,
+) -> Option<PendingResponse> {
+    let pre = pre?;
+    let path = window_path("vote-response", eng)?;
+    let (t, n, c) = vote_args(vote);
+    let args = json!({"peer": nid(peer), "term": t, "owner": n, "committed": c});
+    write_lines(&path, nid(&eng.config.id), &pre.state, "VoteResponsePanic", &args, &pre.state);
+    Some(PendingResponse { path, pre, args })
+}
+
+/// After `Engine::handle_vote_resp` returned normally.
+pub(crate) fn vote_response_end<C: RaftTypeConfig>(eng: &Engine<C>, pending: Option<PendingResponse>) {
+    let Some(p) = pending else { return };
+    let post = capture(eng, p.pre.skip);
+    write_lines(&p.path, nid(&eng.config.id), &p.pre.state, "VoteResponse", &p.args, &post);
+}
