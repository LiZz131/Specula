+/// R1: vote-request freshness compares the full LogId (term, node, index).
+#[test]
+fn specula_trace_vote_request_logid() -> anyhow::Result<()> {
+    let Some(mut rec) = Recorder::from_env()? else { return Ok(()); };
+    let mut eng = base_engine(2, btreeset! {1,2}, btreeset! {3});
+    let vote = Vote::new(2, 1);
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::from_millis(0), vote);
+    eng.last_seen_vote = vote;
+    eng.state.log_ids.append(log_id(1, 1, 1));
+    eng.state.log_ids.append(log_id(2, 1, 2));
+    clear(&mut eng);
+    rec.emit("Bootstrap", 2, json!({}), &eng)?;
+
+    // Higher index but older term: rejected.
+    let _ = eng.handle_vote_req(VoteRequest::new(Vote::new(3, 1), Some(log_id(1, 1, 5))));
+    rec.emit("VoteRequest", 2,
+             json!({"candidate": 1, "term": 3, "committed": false, "last_term": 1, "last_node": 1, "last_index": 5}), &eng)?;
+    clear(&mut eng);
+
+    // Lower index but newer term: granted.
+    let _ = eng.handle_vote_req(VoteRequest::new(Vote::new(4, 2), Some(log_id(3, 2, 1))));
+    rec.emit("VoteRequest", 2,
+             json!({"candidate": 2, "term": 4, "committed": false, "last_term": 3, "last_node": 2, "last_index": 1}), &eng)?;
+    Ok(())
+}
