diff --git a/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java b/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java
new file mode 100644
index 0000000..78bfeeb
--- /dev/null
+++ b/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java
@@ -0,0 +1,165 @@
+/*
