+// echoWithBlockChange mirrors the in-repo construction of a parameter update
+// from a complete ConsensusParams value (internal/state/state_test.go:1044,
+// types/params.go:320-341 ToProto always fills Abci): change Block.MaxBytes,
+// re-send everything else unchanged.
+func echoWithBlockChange(cp types.ConsensusParams, veh int64) *cmtproto.ConsensusParams {
+	cp.Block.MaxBytes++
+	cp.ABCI.VoteExtensionsEnableHeight = veh
+	pb := cp.ToProto()
+	return &pb
+}
