+// speculaLifecycleState captures the complete abstract state used by the V0
+// model. Consensus parameter records are represented by stable fingerprints;
+// equality and installation are preserved without serializing Go-only detail
+// into TLA+ values.
+func (blockExec *BlockExecutor) speculaLifecycleState(
+	current State,
+	persisted State,
+	phase string,
+	pendingBlockHeight int64,
+	pendingParam any,
+	validationOutcome string,
+) map[string]any {
+	return speculatrace.LifecycleState(
+		blockExec.blockStore.Height(),
+		persisted.LastBlockHeight,
+		current.LastBlockHeight,
+		speculatrace.ParamRecord(current.ConsensusParams),
+		speculatrace.ParamRecord(persisted.ConsensusParams),
+		current.LastHeightConsensusParamsChanged,
+		persisted.LastHeightConsensusParamsChanged,
+		phase,
+		pendingBlockHeight,
+		pendingParam,
+		validationOutcome,
+	)
+}
