@@ -0,0 +1,160 @@
+package consensus
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	dbm "github.com/cometbft/cometbft-db"
+	abci "github.com/cometbft/cometbft/abci/types"
+	cmtproto "github.com/cometbft/cometbft/api/cometbft/types/v1"
+	"github.com/cometbft/cometbft/crypto/ed25519"
+	"github.com/cometbft/cometbft/internal/speculatrace"
+	sm "github.com/cometbft/cometbft/internal/state"
+	"github.com/cometbft/cometbft/internal/store"
+	"github.com/cometbft/cometbft/libs/log"
+	"github.com/cometbft/cometbft/proxy"
+	"github.com/cometbft/cometbft/types"
+	cmttime "github.com/cometbft/cometbft/types/time"
+)
+
+// V1 update-focused recovery scenarios (Specula harness).  Phase 1 (node
+// start + block 1) is written to SPECULA_TRACE_PREFIX_FILE; the restart is
+// written to SPECULA_TRACE_FILE.  Handshake resets the active trace file.
+
+type speculaReplayApp struct {
+	abci.BaseApplication
+	update  *cmtproto.ConsensusParams
+	height  int64
+	appHash []byte
+}
+
+func (app *speculaReplayApp) Info(context.Context, *abci.InfoRequest) (*abci.InfoResponse, error) {
+	return &abci.InfoResponse{LastBlockHeight: app.height, LastBlockAppHash: app.appHash}, nil
+}
+
+func (app *speculaReplayApp) FinalizeBlock(
+	_ context.Context, req *abci.FinalizeBlockRequest,
+) (*abci.FinalizeBlockResponse, error) {
+	txResults := make([]*abci.ExecTxResult, len(req.Txs))
+	for i := range txResults {
+		txResults[i] = &abci.ExecTxResult{Code: abci.CodeTypeOK}
+	}
+	return &abci.FinalizeBlockResponse{
+		TxResults:             txResults,
+		ConsensusParamUpdates: app.update,
+		AppHash:               []byte{0x5c, byte(req.Height)},
+	}, nil
+}
+
+func (app *speculaReplayApp) Commit(context.Context, *abci.CommitRequest) (*abci.CommitResponse, error) {
+	app.height++
+	app.appHash = []byte{0x5c, byte(app.height)}
+	return &abci.CommitResponse{}, nil
+}
+
+// speculaFailSaveStore injects one state-save failure: the crash cut after
+// application Commit and before State save (execution.go:284-299).
+type speculaFailSaveStore struct {
+	sm.Store
+	failNext bool
+}
+
+func (s *speculaFailSaveStore) Save(st sm.State) error {
+	if s.failNext {
+		s.failNext = false
+		return errors.New("specula: injected state-save failure (crash cut)")
+	}
+	return s.Store.Save(st)
+}
+
+func speculaRecoveryScenario(
+	t *testing.T,
+	genesisVEH int64,
+	update *cmtproto.ConsensusParams,
+	failStateSave bool,
+) (applyErr, restartErr error) {
+	t.Helper()
+	restartTrace := os.Getenv("SPECULA_TRACE_FILE")
+	if prefix := os.Getenv("SPECULA_TRACE_PREFIX_FILE"); prefix != "" {
+		t.Setenv("SPECULA_TRACE_FILE", prefix)
+	}
+
+	pk := ed25519.GenPrivKeyFromSecret([]byte("specula-v1"))
+	cp := types.DefaultConsensusParams()
+	cp.ABCI.VoteExtensionsEnableHeight = genesisVEH
+	genDoc := &types.GenesisDoc{
+		GenesisTime:     cmttime.Now(),
+		ChainID:         "specula-v1",
+		InitialHeight:   1,
+		ConsensusParams: cp,
+		Validators: []types.GenesisValidator{{
+			Address: pk.PubKey().Address(), PubKey: pk.PubKey(), Power: 10, Name: "v0",
+		}},
+	}
+	require.NoError(t, genDoc.ValidateAndComplete())
+	state, err := sm.MakeGenesisState(genDoc)
+	require.NoError(t, err)
+	stateStore := sm.NewStore(dbm.NewMemDB(), sm.StoreOptions{DiscardABCIResponses: false})
+	require.NoError(t, stateStore.Save(state))
+	blockStore := store.NewBlockStore(dbm.NewMemDB())
+
+	app := &speculaReplayApp{update: update}
+	proxyApp := proxy.NewAppConns(proxy.NewLocalClientCreator(app), proxy.NopMetrics())
+	require.NoError(t, proxyApp.Start())
+	t.Cleanup(func() { _ = proxyApp.Stop() })
+
+	// Node start: the real handshake (InitChain at genesis), node.go:351.
+	require.NoError(t, NewHandshaker(stateStore, state, blockStore, genDoc).Handshake(context.Background(), proxyApp))
+	state, err = stateStore.Load()
+	require.NoError(t, err)
+
+	// Consensus decides block 1: save it, then ApplyBlock (state.go:1781-1836).
+	execStore := sm.Store(stateStore)
+	if failStateSave {
+		execStore = &speculaFailSaveStore{Store: stateStore, failNext: true}
+	}
+	blockExec := sm.NewBlockExecutor(execStore, log.TestingLogger(), proxyApp.Consensus(),
+		emptyMempool{}, sm.EmptyEvidencePool{}, blockStore)
+	block := state.MakeBlock(1, nil, &types.Commit{}, nil, state.Validators.GetProposer().Address)
+	parts, err := block.MakePartSet(types.BlockPartSizeBytes)
+	require.NoError(t, err)
+	blockID := types.BlockID{Hash: block.Hash(), PartSetHeader: parts.Header()}
+	blockStore.SaveBlock(block, parts, &types.Commit{Height: 1, BlockID: blockID})
+	_, applyErr = blockExec.ApplyBlock(state, blockID, block)
+	t.Logf("block 1 ApplyBlock error: %v (production consensus panics on error, state.go:1834-1836)", applyErr)
+
+	// Restart: real handshake on the durable stores.
+	if restartTrace != "" {
+		t.Setenv("SPECULA_TRACE_FILE", restartTrace)
+	}
+	persisted, err := stateStore.Load()
+	require.NoError(t, err)
+	restartErr = NewHandshaker(stateStore, persisted, blockStore, genDoc).Handshake(context.Background(), proxyApp)
+	t.Logf("restart Handshake error: %v", restartErr)
+	return applyErr, restartErr
+}
+
+// U4a: vote extensions enabled at genesis; block 1 re-sends the unchanged
+// enable height with a Block change (complete ConsensusParams echo).  Restart
+// replays the stored block through the real application (replay.go:408-415).
+func TestSpeculaTraceReplayVEUnchanged(t *testing.T) {
+	cp := *types.DefaultConsensusParams()
+	cp.Block.MaxBytes++
+	cp.ABCI.VoteExtensionsEnableHeight = 1
+	pb := cp.ToProto()
+	_, _ = speculaRecoveryScenario(t, 1, &pb, false)
+}
+
+// U4b: first enablement from 0 at height 2 in block 1; application commits,
+// the state save fails (crash cut), restart replays with the saved response
+// through the mock application (replay.go:417-433).
+func TestSpeculaTraceReplayMockVEEnable(t *testing.T) {
+	_, _ = speculaRecoveryScenario(t, 0,
+		&cmtproto.ConsensusParams{Abci: &cmtproto.ABCIParams{VoteExtensionsEnableHeight: 2}}, true)
+}
+
+var _ = speculatrace.Enabled
diff --git a/internal/speculatrace/trace.go b/internal/speculatrace/trace.go
new file mode 100644
index 0000000..c0bfd17
--- /dev/null
+++ b/internal/speculatrace/trace.go
@@ -0,0 +1,233 @@
+// Package speculatrace provides opt-in NDJSON tracing for the Specula V0
+// harness. When SPECULA_TRACE_FILE is unset every operation is a no-op.
+package speculatrace
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"sync"
+	"time"
+
+	cmtproto "github.com/cometbft/cometbft/api/cometbft/types/v1"
+	"github.com/cometbft/cometbft/types"
+)
+
+// NoParam is the descriptor of an absent ConsensusParamUpdates (nil).
+// V1: update descriptors are JSON objects; see ParamRecord/UpdateRecord.
+var NoParam any = map[string]any{"present": false}
+
+// ParamRecord is the V1 abstraction of a complete ConsensusParams value:
+// a fingerprint of the non-ABCI sub-records plus the exact
+// ABCI.VoteExtensionsEnableHeight (types/params.go:69-71).
+func ParamRecord(cp types.ConsensusParams) map[string]any {
+	body := cp
+	body.ABCI = types.ABCIParams{}
+	return map[string]any{
+		"body": Fingerprint(body),
+		"veh":  cp.ABCI.VoteExtensionsEnableHeight,
+	}
+}
+
+// UpdateRecord describes a FinalizeBlockResponse.ConsensusParamUpdates value
+// relative to the current parameters: the fingerprint of the non-ABCI part of
+// cur.Update(upd) and whether/what Abci sub-record was supplied.
+func UpdateRecord(cur types.ConsensusParams, upd *cmtproto.ConsensusParams) any {
+	if upd == nil {
+		return NoParam
+	}
+	next := cur.Update(upd)
+	next.ABCI = types.ABCIParams{}
+	rec := map[string]any{
+		"present":     true,
+		"body":        Fingerprint(next),
+		"abciPresent": upd.Abci != nil,
+		"veh":         int64(0),
+	}
+	if upd.Abci != nil {
+		rec["veh"] = upd.Abci.VoteExtensionsEnableHeight
+	}
+	return rec
+}
+
+// BodyValid evaluates the non-ABCI part of the real ValidateBasic on the
+// record that the update would produce (enable height neutralized).
+func BodyValid(cur types.ConsensusParams, upd *cmtproto.ConsensusParams) bool {
+	if upd == nil {
+		return true
+	}
+	next := cur.Update(upd)
+	next.ABCI.VoteExtensionsEnableHeight = 0
+	return next.ValidateBasic() == nil
+}
+
+// RejectStage re-evaluates the real validation functions to name the failing
+// stage of updateState (internal/state/execution.go:617-625).
+func RejectStage(cur types.ConsensusParams, upd *cmtproto.ConsensusParams, h int64) string {
+	if upd == nil {
+		return "other"
+	}
+	if err := cur.Update(upd).ValidateBasic(); err != nil {
+		return "basic"
+	}
+	if err := cur.ValidateUpdate(upd, h); err != nil {
+		return "update"
+	}
+	return "other"
+}
+
+var traceState struct {
+	sync.Mutex
+	file           *os.File
+	path           string
+	replay         bool
+	appHeight      int64
+	responseHeight int64
+	responseParam  any
+}
+
+// Enabled reports whether this process was launched for trace collection.
+func Enabled() bool {
+	return os.Getenv("SPECULA_TRACE_FILE") != ""
+}
+
+// Reset truncates the configured trace file. It is used at the real Handshake
+// entry point so test-fixture setup does not contaminate recovery traces.
+func Reset() error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file != nil {
+		_ = traceState.file.Close()
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0o600)
+	if err != nil {
+		return err
+	}
+	traceState.file = f
+	traceState.path = path
+	traceState.replay = false
+	traceState.appHeight = 0
+	traceState.responseHeight = 0
+	traceState.responseParam = NoParam
+	return nil
+}
+
+// Fingerprint gives a stable symbolic identity to a complete consensus
+// parameter value without baking its large Go representation into the model.
+func Fingerprint(v any) string {
+	b, err := json.Marshal(v)
+	if err != nil {
+		return "marshal-error"
+	}
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+func SetReplay(v bool) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.replay = v
+}
+
+func IsReplay() bool {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.replay
+}
+
+func SetAppHeight(h int64) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.appHeight = h
+}
+
+func AppHeight() int64 {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.appHeight
+}
+
+func SetResponse(height int64, param any) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	traceState.responseHeight = height
+	traceState.responseParam = param
+}
+
+func Response() (int64, any) {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return traceState.responseHeight, traceState.responseParam
+}
+
+// LifecycleState constructs the state object consumed by Trace.tla.
+func LifecycleState(
+	blockStoreHeight, stateStoreHeight, inMemoryStateHeight int64,
+	activeParam, persistedParam any,
+	lastParamChange, persistedLastParamChange int64,
+	phase string,
+	pendingBlockHeight int64,
+	pendingParam any, validationOutcome string,
+) map[string]any {
+	traceState.Lock()
+	defer traceState.Unlock()
+	return map[string]any{
+		"blockStoreHeight":         blockStoreHeight,
+		"appHeight":                traceState.appHeight,
+		"stateStoreHeight":         stateStoreHeight,
+		"stateHeight":              inMemoryStateHeight,
+		"activeParam":              activeParam,
+		"persistedParam":           persistedParam,
+		"lastParamChange":          lastParamChange,
+		"persistedLastParamChange": persistedLastParamChange,
+		"phase":                    phase,
+		"replayMutatesState":       traceState.replay,
+		"responseHeight":           traceState.responseHeight,
+		"responseParam":            traceState.responseParam,
+		"pendingBlockHeight":       pendingBlockHeight,
+		"pendingParam":             pendingParam,
+		"validationOutcome":        validationOutcome,
+	}
+}
+
+// Emit appends one mutex-serialized event with a real wall-clock timestamp.
+// Instrumentation deliberately ignores its returned error at call sites so it
+// cannot change the system's functional error paths.
+func Emit(name string, state map[string]any, msg map[string]any) error {
+	path := os.Getenv("SPECULA_TRACE_FILE")
+	if path == "" {
+		return nil
+	}
+	traceState.Lock()
+	defer traceState.Unlock()
+	if traceState.file == nil || traceState.path != path {
+		if traceState.file != nil {
+			_ = traceState.file.Close()
+		}
+		f, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+		if err != nil {
+			return err
+		}
+		traceState.file = f
+		traceState.path = path
+	}
+	event := map[string]any{
+		"tag": "trace",
+		"ts":  time.Now().UnixNano(),
+		"event": map[string]any{
+			"name":  name,
+			"nid":   "node",
+			"state": state,
+			"msg":   msg,
+		},
+	}
+	if err := json.NewEncoder(traceState.file).Encode(event); err != nil {
+		return err
+	}
+	return traceState.file.Sync()
+}
