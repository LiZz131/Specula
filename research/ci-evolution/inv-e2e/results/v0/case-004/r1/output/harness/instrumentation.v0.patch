+        Some(log_id(2, 1, 1)),
+        vec![Entry::new_blank(log_id(2, 1, 2)), Entry::new_blank(log_id(2, 1, 3))],
+    )?;
+    rec.emit("FollowerAppend", 2, json!({"owner": 1, "term": 2, "prev": 1, "count": 2}), &eng)?;
+    Ok(())
+}
