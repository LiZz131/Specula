+
+/// Update-focused Engine scenario (Scenario U-S2): a follower whose lease was disabled by the
+/// TransferLeader handler (`Leased::disable_lease`, the exact call in
+/// `RaftMsg::TransferLeader`) receives an AppendEntries carrying the same leader vote
+/// (`Leased::touch` keeps the lease disabled) and then one carrying a greater leader vote
+/// (`Leased::update` re-enables it).
+#[test]
+fn specula_trace_lease_touch() -> anyhow::Result<()> {
+    let Some(mut rec) = Recorder::from_env()? else { return Ok(()); };
+    let mut eng = base_engine(2, btreeset! {1,2}, btreeset! {3});
+    let vote = Vote::new_committed(2, 1);
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::from_millis(1000), vote);
+    eng.last_seen_vote = vote;
+    eng.state.log_ids.append(log_id(2, 1, 1));
+    eng.state.committed = Some(log_id(0, 0, 0));
+    eng.state.vote.disable_lease();
+    clear(&mut eng);
+    rec.emit("Bootstrap", 2, json!({}), &eng)?;
+
+    eng.append_entries(&vote, Some(log_id(2, 1, 1)), vec![Entry::new_blank(log_id(2, 1, 2))])?;
+    rec.emit("FollowerAppend", 2, json!({"owner": 1, "term": 2, "prev": 1, "count": 1}), &eng)?;
+    clear(&mut eng);
+
+    let vote3 = Vote::new_committed(3, 1);
+    eng.append_entries(&vote3, Some(log_id(2, 1, 2)), vec![Entry::new_blank(log_id(3, 1, 3))])?;
+    rec.emit("FollowerAppend", 2, json!({"owner": 1, "term": 3, "prev": 2, "count": 1}), &eng)?;
+    Ok(())
+}
