+//! Specula update-focused trace scenario U-S1 (derived from the TransferLeader diff).
+//!
+//! Same call pattern as `t14_transfer_leader`, but the assigned next leader `to` is a learner.
+//! The scenario only observes; it asserts nothing about the outcome so that traces are always
+//! collected. Observations are printed with the `SPECULA-OBS` prefix.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use maplit::btreeset;
+use openraft::Config;
+
+use crate::fixtures::ut_harness;
+use crate::fixtures::RaftRouter;
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_transfer_leader_to_learner() -> anyhow::Result<()> {
+    let config = Arc::new(
+        Config {
+            election_timeout_min: 150,
+            election_timeout_max: 300,
+            ..Default::default()
+        }
+        .validate()?,
+    );
+
+    let mut router = RaftRouter::new(config.clone());
+
+    tracing::info!("--- initializing cluster: voters {{0,1,2}}, learner {{3}}");
+    let log_index = router.new_cluster(btreeset! {0,1,2}, btreeset! {3}).await?;
+
+    let n0 = router.get_raft_handle(&0)?;
+    let n1 = router.get_raft_handle(&1)?;
+    let n2 = router.get_raft_handle(&2)?;
+    let n3 = router.get_raft_handle(&3)?;
+
+    n3.wait(timeout()).applied_index(Some(log_index), "learner-3 caught up").await?;
+
+    let metrics = n0.metrics().borrow().clone();
+    let leader_vote = metrics.vote;
+    let last_log_id = metrics.last_applied;
+    {
+        let m3 = n3.metrics().borrow().clone();
+        println!(
+            "SPECULA-OBS before: leader_vote={} last_log_id={:?} n3.state={:?} n3.vote={}",
+            leader_vote, last_log_id, m3.state, m3.vote
+        );
+    }
+
+    tracing::info!("--- transfer Leader from 0 to learner 3, called on every node");
+    for (id, n) in [(0u64, &n0), (1, &n1), (2, &n2), (3, &n3)] {
+        let r = n.transfer_leader(leader_vote, 3, last_log_id).await;
+        println!("SPECULA-OBS transfer_leader on n{} -> {:?}", id, r);
+    }
+
+    tokio::time::sleep(Duration::from_millis(1_000)).await;
+
+    println!("SPECULA-OBS after: n3.is_initialized() = {:?}", n3.is_initialized().await);
+    for (id, n) in [(0u64, &n0), (1, &n1), (2, &n2), (3, &n3)] {
+        let m = n.metrics().borrow().clone();
+        println!(
+            "SPECULA-OBS after: n{} state={:?} vote={} current_leader={:?}",
+            id, m.state, m.vote, m.current_leader
+        );
+    }
+
+    Ok(())
+}
+
+fn timeout() -> Option<Duration> {
+    Some(Duration::from_millis(1_000))
+}
