+//! Specula incremental-run RaftCore trace hook (instrumentation only).
+//!
+//! Active only when `SPECULA_CORE_TRACE_FILE` is set; otherwise every entry point returns
+//! immediately without touching Engine state. The hook observes the synchronous Engine state
+//! immediately before and after a real RaftCore handler; it never mutates any state.
+
+use std::collections::BTreeSet;
+use std::fmt::Display;
+use std::fmt::Write as _;
+use std::fs::File;
+use std::io::Write;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use crate::engine::Command;
+use crate::engine::Engine;
+use crate::progress::Progress;
+use crate::raft_state::IOId;
+use crate::raft_state::LogStateReader;
+use crate::LogId;
+use crate::RaftTypeConfig;
+use crate::Vote;
+
+static OUT: OnceLock<Option<Mutex<File>>> = OnceLock::new();
+
+fn out() -> Option<&'static Mutex<File>> {
+    OUT.get_or_init(|| {
+        let path = std::env::var("SPECULA_CORE_TRACE_FILE").ok()?;
+        let f = std::fs::OpenOptions::new().create(true).append(true).open(path).ok()?;
+        Some(Mutex::new(f))
+    })
+    .as_ref()
+}
+
+/// Pre-handler snapshot.
+pub(crate) struct Pre {
+    state: String,
+    n_cmds: usize,
+}
+
+fn cmd_name<C: RaftTypeConfig>(cmd: &Command<C>) -> &'static str {
+    match cmd {
+        Command::UpdateIOProgress { .. } => "UpdateIOProgress",
+        Command::AppendInputEntries { .. } => "AppendInputEntries",
+        Command::ReplicateCommitted { .. } => "ReplicateCommitted",
+        Command::SaveCommitted { .. } => "SaveCommitted",
+        Command::Apply { .. } => "Apply",
+        Command::Replicate { .. } => "Replicate",
+        Command::RebuildReplicationStreams { .. } => "RebuildReplicationStreams",
+        Command::SaveVote { .. } => "SaveVote",
+        Command::SendVote { .. } => "SendVote",
+        Command::PurgeLog { .. } => "PurgeLog",
+        Command::TruncateLog { .. } => "TruncateLog",
+        Command::StateMachine { .. } => "StateMachine",
+        Command::Respond { .. } => "Respond",
+    }
+}
+
+fn id<T: Display>(x: &T) -> String {
+    x.to_string()
+}
+
+fn idx<NID: crate::NodeId>(log_id: Option<&LogId<NID>>) -> i64 {
+    log_id.map(|x| x.index as i64).unwrap_or(-1)
+}
+
+fn ids<'a, NID: crate::NodeId + 'a>(it: impl Iterator<Item = &'a NID>) -> String {
+    let v = it.map(id).collect::<Vec<_>>();
+    format!("[{}]", v.join(","))
+}
+
+/// Capture the same field set as the Engine unit harness. `skip_cmds` excludes commands that
+/// were already queued before the handler ran, so `commands` holds those it emitted.
+fn capture<C: RaftTypeConfig>(eng: &Engine<C>, skip_cmds: usize) -> String {
+    let vote = eng.state.vote_ref();
+    let seen = eng.last_seen_vote;
+    let effective = eng.state.membership_state.effective();
+    let committed_membership = eng.state.membership_state.committed();
+    let last_index = eng.state.last_log_id().map(|x| x.index as i64).unwrap_or(-1);
+
+    let mut logs = Vec::new();
+    if last_index >= 0 {
+        for i in 0..=last_index as u64 {
+            if let Some(x) = eng.state.get_log_id(i) {
+                logs.push(format!(
+                    "{{\"term\":{},\"node\":{},\"index\":{}}}",
+                    x.leader_id.term,
+                    id(&x.leader_id.node_id),
+                    x.index
+                ));
+            }
+        }
+    }
+
+    let configs = effective
+        .membership()
+        .get_joint_config()
+        .iter()
+        .map(|c| ids(c.iter()))
+        .collect::<Vec<_>>();
+    let learners = effective.membership().learner_ids().collect::<Vec<_>>();
+    let granters = eng.candidate_ref().map(|c| c.granters().collect::<Vec<_>>()).unwrap_or_default();
+    let matches = eng
+        .leader_ref()
+        .map(|l| {
+            l.progress
+                .iter()
+                .map(|(peer, p)| format!("{{\"peer\":{},\"index\":{}}}", id(peer), idx(p.matching.as_ref())))
+                .collect::<Vec<_>>()
+        })
+        .unwrap_or_default();
+    let commands = eng
+        .output
+        .iter_commands()
+        .skip(skip_cmds)
+        .map(cmd_name)
+        .collect::<BTreeSet<_>>()
+        .into_iter()
+        .map(|x| format!("\"{}\"", x))
+        .collect::<Vec<_>>();
+    let accepted = eng.state.accepted_io();
+    let accepted_index = accepted.and_then(|x| x.last_log_id()).map(|x| x.index as i64).unwrap_or(-1);
+    let accepted_vote_io = matches!(accepted, Some(IOId::Vote(_)));
+
+    let mut s = String::new();
+    let _ = write!(
+        s,
+        "{{\"node_id\":{},\"vote_term\":{},\"vote_node\":{},\"vote_committed\":{},\
+         \"last_seen_term\":{},\"last_seen_node\":{},\"last_seen_committed\":{},\
+         \"role\":\"{:?}\",\"logs\":[{}],\"last_index\":{},\"commit_index\":{},\
+         \"effective_index\":{},\"committed_membership_index\":{},\
+         \"effective_configs\":[{}],\"learners\":{},\"candidate\":{},\"granters\":{},\
+         \"leader\":{},\"matches\":[{}],\"accepted_index\":{},\"accepted_vote_io\":{},\
+         \"commands\":[{}],\"lease_enabled\":{}}}",
+        id(&eng.config.id),
+        vote.leader_id.term,
+        id(&vote.leader_id.node_id),
+        vote.committed,
+        seen.leader_id.term,
+        id(&seen.leader_id.node_id),
+        seen.committed,
+        eng.state.server_state,
+        logs.join(","),
+        last_index,
+        idx(eng.state.committed()),
+        idx(effective.log_id().as_ref()),
+        idx(committed_membership.log_id().as_ref()),
+        configs.join(","),
+        ids(learners.iter()),
+        eng.candidate_ref().is_some(),
+        ids(granters.iter()),
+        eng.leader_ref().is_some(),
+        matches.join(","),
+        accepted_index,
+        accepted_vote_io,
+        commands.join(","),
+        eng.state.vote.lease_enabled(),
+    );
+    s
+}
+
+pub(crate) fn pre<C: RaftTypeConfig>(eng: &Engine<C>) -> Option<Pre> {
+    out()?;
+    Some(Pre {
+        state: capture(eng, 0),
+        n_cmds: eng.output.iter_commands().count(),
+    })
+}
+
+fn emit(name: &str, node: &str, args: &str, pre: &str, post: Option<&str>) {
+    let Some(out) = out() else { return };
+    let ts = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+    let post = post.unwrap_or("null");
+    let line = format!(
+        "{{\"tag\":\"trace\",\"ts\":\"{}\",\"event\":{{\"name\":\"{}\",\"node\":{},\"args\":{},\"pre\":{},\"state\":{}}}}}\n",
+        ts, name, node, args, pre, post
+    );
+    if let Ok(mut f) = out.lock() {
+        let _ = f.write_all(line.as_bytes());
+        let _ = f.flush();
+    }
+}
+
+pub(crate) fn post<C: RaftTypeConfig>(eng: &Engine<C>, pre: Option<Pre>, name: &str, args: String) {
+    let Some(pre) = pre else { return };
+    let post = capture(eng, pre.n_cmds);
+    emit(name, &id(&eng.config.id), &args, &pre.state, Some(&post));
+}
+
+pub(crate) fn vote_args<NID: crate::NodeId>(v: &Vote<NID>) -> (u64, String, bool) {
+    (v.leader_id.term, id(&v.leader_id.node_id), v.committed)
+}
+
+pub(crate) fn transfer_args<NID: crate::NodeId>(from: &Vote<NID>, to: &NID) -> String {
+    let (t, n, c) = vote_args(from);
+    format!(
+        "{{\"from_term\":{},\"from_node\":{},\"from_committed\":{},\"to\":{}}}",
+        t,
+        n,
+        c,
+        id(to)
+    )
+}
+
+pub(crate) fn vote_req_args<NID: crate::NodeId>(v: &Vote<NID>, last: Option<&LogId<NID>>) -> String {
+    let (t, n, c) = vote_args(v);
+    let (lt, ln, li) = match last {
+        Some(x) => (x.leader_id.term, id(&x.leader_id.node_id), x.index as i64),
+        None => (0, "0".to_string(), -1),
+    };
+    format!(
+        "{{\"candidate\":{},\"term\":{},\"committed\":{},\"last_term\":{},\"last_node\":{},\"last_index\":{}}}",
+        n, t, c, lt, ln, li
+    )
+}
+
+pub(crate) fn vote_resp_args<NID: crate::NodeId>(target: &NID, v: &Vote<NID>) -> String {
+    let (t, n, c) = vote_args(v);
+    format!(
+        "{{\"peer\":{},\"term\":{},\"owner\":{},\"committed\":{}}}",
+        id(target),
+        t,
+        n,
+        c
+    )
+}
+
+/// Records a `VoteResponsePanic` event if the guarded Engine call unwinds.
+pub(crate) struct PanicGuard {
+    node: String,
+    args: String,
+    pre: Option<String>,
+}
+
+impl PanicGuard {
+    pub(crate) fn new(node: String, args: String, pre: &Option<Pre>) -> Self {
+        Self {
+            node,
+            args,
+            pre: pre.as_ref().map(|p| p.state.clone()),
+        }
+    }
+
+    pub(crate) fn disarm(mut self) {
+        self.pre = None;
+    }
+}
+
+impl Drop for PanicGuard {
+    fn drop(&mut self) {
+        if let Some(pre) = self.pre.take() {
+            if std::thread::panicking() {
+                emit("VoteResponsePanic", &self.node, &self.args, &pre, None);
+            }
+        }
+    }
+}
+
+pub(crate) fn node_str<NID: crate::NodeId>(n: &NID) -> String {
+    id(n)
+}
