diff --git a/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java b/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java
new file mode 100644
index 0000000..772c66b
--- /dev/null
+++ b/zookeeper-server/src/main/java/org/apache/zookeeper/server/quorum/SpeculaTrace.java
@@ -0,0 +1,154 @@
+/*
+ * Licensed to the Apache Software Foundation (ASF) under one
+ * or more contributor license agreements. See the NOTICE file distributed
+ * with this work for additional information regarding copyright ownership.
+ * The ASF licenses this file to You under the Apache License, Version 2.0.
+ */
+package org.apache.zookeeper.server.quorum;
+
+import java.io.BufferedWriter;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.zookeeper.server.ZooKeeperServer;
+import org.apache.zookeeper.server.util.ZxidUtils;
+
+/**
+ * Opt-in, synchronous Specula NDJSON instrumentation.
+ *
+ * Incremental rebase: every record now carries an {@code aux} object with the
+ * role instance's ZooKeeperServer state, Learner sync-buffer sizes, the peer
+ * of a leader-side NEWLEADER ACK and the txn-log tail where captured. The
+ * writer takes no lock other than its own monitor.
+ */
+public final class SpeculaTrace {
+
+    private static final AtomicLong SEQUENCE = new AtomicLong();
+
+    private SpeculaTrace() {
+    }
+
+    public static boolean isEnabled() {
+        String path = System.getProperty("specula.trace.file");
+        return path != null && !path.isEmpty();
+    }
+
+    public static void emit(String event, QuorumPeer peer, long zxid) {
+        emitAux(event, peer, zxid, "unknown", -1, -1, -1L, -1L);
+    }
+
+    public static void emitAux(String event, QuorumPeer peer, long zxid, String zkState,
+                               int pending, int committed, long peerSid, long logZxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        if (peer == null) {
+            emitRaw(event, -1, zxid, -1, -1, "unknown", "unknown", "NONE",
+                    zkState, pending, committed, peerSid, logZxid);
+            return;
+        }
+        long accepted = -1;
+        long current = -1;
+        try {
+            accepted = peer.getAcceptedEpoch();
+            current = peer.getCurrentEpoch();
+        } catch (IOException e) {
+            // Capture remains useful when epoch files are not initialized yet.
+        }
+        emitRaw(event,
+                peer.getId(),
+                zxid,
+                accepted,
+                current,
+                peer.getPeerState().toString().toLowerCase(),
+                peer.getZabState().toString().toLowerCase(),
+                peer.getSyncMode().toString(),
+                zkState, pending, committed, peerSid, logZxid);
+    }
+
+    public static void emit(String event, ZooKeeperServer server, long zxid) {
+        emitServer(event, server, zxid, -1L);
+    }
+
+    public static void emitServer(String event, ZooKeeperServer server, long zxid, long logZxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        emitRaw(event,
+                server == null ? -1 : server.getServerId(),
+                zxid,
+                -1,
+                -1,
+                "unknown",
+                "unknown",
+                "NONE",
+                server == null ? "unknown" : server.speculaStateName(),
+                -1, -1, -1L, logZxid);
+    }
+
+    private static synchronized void emitRaw(
+            String event,
+            long sid,
+            long zxid,
+            long acceptedEpoch,
+            long currentEpoch,
+            String role,
+            String phase,
+            String syncMode,
+            String zkState,
+            int pending,
+            int committed,
+            long peerSid,
+            long logZxid) {
+        String path = System.getProperty("specula.trace.file");
+        if (!isEnabled()) {
+            return;
+        }
+        long sequence = SEQUENCE.incrementAndGet();
+        Thread thread = Thread.currentThread();
+        long txnEpoch = zxid < 0 ? -1 : ZxidUtils.getEpochFromZxid(zxid);
+        long txnCounter = zxid < 0 ? -1 : (zxid & 0xffffffffL);
+        long logEpoch = logZxid < 0 ? -1 : ZxidUtils.getEpochFromZxid(logZxid);
+        long logCounter = logZxid < 0 ? -1 : (logZxid & 0xffffffffL);
+        String scenario = System.getProperty("specula.trace.scenario", "unspecified");
+        String line = "{\"tag\":\"trace\",\"scenario\":\"" + escape(scenario)
+            + "\",\"seq\":" + sequence
+            + ",\"timeMillis\":" + System.currentTimeMillis()
+            + ",\"timeNanos\":" + System.nanoTime()
+            + ",\"thread\":{\"id\":" + thread.getId()
+            + ",\"name\":\"" + escape(thread.getName()) + "\"}"
+            + ",\"event\":{\"name\":\"" + escape(event)
+            + "\",\"node\":\"s" + sid
+            + "\",\"zxid\":\"" + zxid + "\""
+            + ",\"txnEpoch\":" + txnEpoch
+            + ",\"txnCounter\":" + txnCounter
+            + ",\"state\":{\"acceptedEpoch\":" + acceptedEpoch
+            + ",\"currentEpoch\":" + currentEpoch
+            + ",\"role\":\"" + escape(role)
+            + "\",\"phase\":\"" + escape(phase)
+            + "\",\"syncMode\":\"" + escape(syncMode)
+            + "\"},\"aux\":{\"zkState\":\"" + escape(zkState)
+            + "\",\"pending\":" + pending
+            + ",\"committed\":" + committed
+            + ",\"peer\":\"" + (peerSid < 0 ? "none" : "s" + peerSid)
+            + "\",\"logEpoch\":" + logEpoch
+            + ",\"logCounter\":" + logCounter
+            + "}}}";
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+                 new FileOutputStream(path, true), StandardCharsets.UTF_8))) {
+            writer.write(line);
+            writer.newLine();
+        } catch (IOException e) {
+            throw new IllegalStateException("Unable to write Specula trace " + path, e);
+        }
+    }
+
+    private static String escape(String value) {
+        return value.replace("\\", "\\\\")
+                    .replace("\"", "\\\"")
+                    .replace("\n", "\\n")
+                    .replace("\r", "\\r");
+    }
+}
