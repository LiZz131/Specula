+//! Specula reproduction (Scenario U2): a Pre-Vote round started while a node
+//! is still a Candidate is not cancelled when that node's real election wins.
+//! A delayed Pre-Vote grant then makes the established Leader start a new
+//! election at a higher term, disrupting its own healthy leadership.
+//!
+//! The Pre-Vote round is started with `Trigger::elect(true)` for determinism;
+//! the election timer reaches the same `Engine::pre_elect` on a Candidate
+//! whose election has run longer than the election timeout
+//! (RaftCore::handle_tick_election skips only Leaders).
+//!
+//! This test asserts the promised behavior and FAILS while the defect exists.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::Result;
+use maplit::btreeset;
+use openraft::Config;
+use openraft::RPCTypes;
+use openraft::ServerState;
+use openraft::async_runtime::WatchReceiver;
+use openraft::type_config::TypeConfigExt;
+use openraft_memstore::TypeConfig;
+
+use crate::fixtures::RaftRouter;
+use crate::fixtures::rpc_request::RpcRequest;
+use crate::fixtures::rpc_response::RpcResponse;
+use crate::fixtures::ut_harness;
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_stale_pre_vote_round_does_not_depose_leader() -> Result<()> {
+    let config = Arc::new(
+        Config {
+            enable_heartbeat: false,
+            enable_elect: false,
+            enable_pre_vote: Some(true),
+            // Vote RPC timeout is election_timeout_min; keep it above the delays below.
+            election_timeout_min: 3000,
+            election_timeout_max: 4000,
+            ..Default::default()
+        }
+        .validate()?,
+    );
+
+    let mut router = RaftRouter::new(config.clone());
+
+    tracing::info!("--- create cluster of 0,1,2; node 0 becomes leader");
+    router.new_cluster(btreeset! {0,1,2}, btreeset! {}).await?;
+    let n0 = router.get_raft_handle(&0)?;
+    let n1 = router.get_raft_handle(&1)?;
+    n0.wait(timeout()).state(ServerState::Leader, "node 0 is leader").await?;
+    let t = n1.metrics().borrow_watched().current_term;
+
+    tracing::info!("--- let every leader lease expire (leader_lease = election_timeout_max)");
+    TypeConfig::sleep(Duration::from_millis(4500)).await;
+
+    // Real Vote requests of node 1 for term t+1 are slow to arrive (500 ms);
+    // Pre-Vote requests (term t+2) arrive at once, but their responses are
+    // slow to return (1500 ms). Both stay within the 3000 ms RPC timeout.
+    router
+        .set_rpc_pre_hook(RPCTypes::Vote, move |_r, req, from, _to| {
+            let slow = matches!(&req, RpcRequest::Vote(v) if from == 1 && v.vote.leader_id().term == t + 1);
+            Box::pin(async move {
+                if slow {
+                    TypeConfig::sleep(Duration::from_millis(500)).await;
+                }
+                Ok(())
+            })
+        })
+        .await;
+    router
+        .set_rpc_post_hook(RPCTypes::Vote, move |_r, req, _resp: RpcResponse<TypeConfig>, from, _to| {
+            let slow = matches!(&req, RpcRequest::Vote(v) if from == 1 && v.vote.leader_id().term == t + 2);
+            Box::pin(async move {
+                if slow {
+                    TypeConfig::sleep(Duration::from_millis(1500)).await;
+                }
+                Ok(())
+            })
+        })
+        .await;
+
+    tracing::info!("--- node 1 starts a real election at term t+1 (votes in flight)");
+    n1.trigger().elect(false).await?;
+    tracing::info!("--- while still Candidate, node 1 starts a Pre-Vote round for term t+2");
+    n1.trigger().elect(true).await?;
+
+    n1.wait(timeout()).state(ServerState::Leader, "node 1 wins the term t+1 election").await?;
+    assert_eq!(t + 1, n1.metrics().borrow_watched().current_term);
+    tracing::info!("--- node 1 is leader at term t+1; wait for the delayed Pre-Vote grants");
+
+    TypeConfig::sleep(Duration::from_millis(3000)).await;
+    // RaftCore must still be alive: a dead core leaves metrics frozen at the
+    // last published value, so probe it with a request it must serve.
+    let core = n1.with_raft_state(|st| (st.server_state, st.vote_ref().leader_id().term)).await;
+    println!("SPECULA_OBSERVATION node1 RaftCore probe: {:?}", core);
+    let m = n1.metrics().borrow_watched().clone();
+    tracing::info!("--- node 1 after the delayed Pre-Vote responses: state={:?} term={}", m.state, m.current_term);
+    println!("SPECULA_OBSERVATION node1 state={:?} term={} (leader term was {})", m.state, m.current_term, t + 1);
+
+    let core = core.map_err(|e| anyhow::anyhow!("RaftCore of node 1 is no longer running: {}", e))?;
+    assert_eq!(
+        (ServerState::Leader, t + 1),
+        core,
+        "RaftCore state: a superseded Pre-Vote round must not depose the leader it was started for"
+    );
+    assert_eq!(
+        (ServerState::Leader, t + 1),
+        (m.state, m.current_term),
+        "a superseded Pre-Vote round must not depose the leader it was started for"
+    );
+    Ok(())
+}
+
+fn timeout() -> Option<Duration> {
+    Some(Duration::from_millis(3000))
+}
diff --git a/tests/tests/elect/t92_specula_stale_pre_vote_round_timer.rs b/tests/tests/elect/t92_specula_stale_pre_vote_round_timer.rs
new file mode 100644
index 0000000..ee71a51
--- /dev/null
+++ b/tests/tests/elect/t92_specula_stale_pre_vote_round_timer.rs
@@ -0,0 +1,108 @@
+//! Specula reproduction (Scenario U2), election-timer variant: no operator
+//! trigger is used. Node 1's vote save is slow (600 ms) and its real Vote
+//! RPCs take 500 ms, so its term t+1 election outlives the election timeout
+//! (~1000 ms). The timer then starts a Pre-Vote round for term t+2 on the
+//! still-running Candidate; the real election wins at term t+1; the delayed
+//! Pre-Vote grant then makes the new Leader call `elect()` again.
+//!
+//! This test asserts the promised behavior and FAILS while the defect exists.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::Result;
+use maplit::btreeset;
+use openraft::Config;
+use openraft::RPCTypes;
+use openraft::ServerState;
+use openraft::async_runtime::WatchReceiver;
+use openraft::type_config::TypeConfigExt;
+use openraft_memstore::BlockOperation;
+use openraft_memstore::TypeConfig;
+
+use crate::fixtures::RaftRouter;
+use crate::fixtures::rpc_request::RpcRequest;
+use crate::fixtures::rpc_response::RpcResponse;
+use crate::fixtures::ut_harness;
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_timer_pre_vote_round_does_not_depose_leader() -> Result<()> {
+    let config = Arc::new(
+        Config {
+            enable_pre_vote: Some(true),
+            election_timeout_min: 1000,
+            election_timeout_max: 1001,
+            heartbeat_interval: 100,
+            ..Default::default()
+        }
+        .validate()?,
+    );
+
+    let mut router = RaftRouter::new(config.clone());
+    tracing::info!("--- create cluster of 0,1,2; node 0 becomes leader");
+    router.new_cluster(btreeset! {0,1,2}, btreeset! {}).await?;
+    let n0 = router.get_raft_handle(&0)?;
+    let n1 = router.get_raft_handle(&1)?;
+    let n2 = router.get_raft_handle(&2)?;
+    n0.wait(timeout()).state(ServerState::Leader, "node 0 is leader").await?;
+    let t = n1.metrics().borrow_watched().current_term;
+
+    // Only node 1 runs its election timer.
+    n0.runtime_config().elect(false);
+    n2.runtime_config().elect(false);
+
+    let (_log1, sm1) = router.get_storage_handle(&1)?;
+    sm1.block.set_blocking(BlockOperation::DelaySaveVote, Duration::from_millis(600));
+
+    router
+        .set_rpc_pre_hook(RPCTypes::Vote, move |_r, req, from, _to| {
+            let slow = matches!(&req, RpcRequest::Vote(v) if from == 1 && v.vote.leader_id().term == t + 1 && !v.vote.is_committed());
+            Box::pin(async move {
+                if slow {
+                    TypeConfig::sleep(Duration::from_millis(500)).await;
+                }
+                Ok(())
+            })
+        })
+        .await;
+    // Delay only the responses of the term t+2 Pre-Vote round (the real
+    // term t+1 election and the first Pre-Vote round are not delayed here).
+    router
+        .set_rpc_post_hook(RPCTypes::Vote, move |_r, req, _resp: RpcResponse<TypeConfig>, from, _to| {
+            let slow = matches!(&req, RpcRequest::Vote(v) if from == 1 && v.vote.leader_id().term == t + 2);
+            Box::pin(async move {
+                if slow {
+                    TypeConfig::sleep(Duration::from_millis(800)).await;
+                }
+                Ok(())
+            })
+        })
+        .await;
+
+    tracing::info!("--- isolate leader 0; node 1's timer drives Pre-Vote and election");
+    router.set_network_error(0, true);
+
+    n1.wait(Some(Duration::from_secs(10)))
+        .metrics(
+            |m| m.state == ServerState::Leader && m.current_term == t + 1,
+            "node 1 becomes leader at term t+1",
+        )
+        .await?;
+    tracing::info!("--- node 1 leads term t+1; wait for the delayed Pre-Vote grants");
+    TypeConfig::sleep(Duration::from_millis(2500)).await;
+
+    let core = n1.with_raft_state(|st| (st.server_state, st.vote_ref().leader_id().term)).await;
+    println!("SPECULA_OBSERVATION timer variant: node1 RaftCore probe: {:?}", core);
+    let core = core.map_err(|e| anyhow::anyhow!("RaftCore of node 1 is no longer running: {}", e))?;
+    assert_eq!(
+        (ServerState::Leader, t + 1),
+        core,
+        "a timer-started Pre-Vote round must not depose the leader its node became"
+    );
+    Ok(())
+}
+
+fn timeout() -> Option<Duration> {
+    Some(Duration::from_millis(3000))
+}
diff --git a/tests/tests/elect/t93_specula_stale_pre_vote_grant_removed_member.rs b/tests/tests/elect/t93_specula_stale_pre_vote_grant_removed_member.rs
new file mode 100644
index 0000000..9940af8
--- /dev/null
+++ b/tests/tests/elect/t93_specula_stale_pre_vote_grant_removed_member.rs
@@ -0,0 +1,137 @@
+//! Specula reproduction (Scenario U5): Pre-Vote rounds at an unchanged term
+//! reuse the leader id `(term+1, self)`. Node 1 starts a Pre-Vote round
+//! (`Trigger::elect(true)`) while node 3 is still a voter; node 3's grant is
+//! delayed. The leader removes node 3 (joint, then uniform config replicated to
+//! node 1, which drops the round via become_following). Node 1 starts a new
+//! round at the same term with config {0,1,2}. The delayed grant of node 3
+//! passes RaftCore's leader-id filter and `Candidate::grant_by` panics with
+//! "target not in quorum set" (an `expect`, so also in release builds).
+//!
+//! Heartbeats are disabled because each heartbeat makes node 1 run
+//! become_following, which drops a live round; with heartbeats on, the stale
+//! grant must arrive within one heartbeat interval after round 2 starts.
+//!
+//! This test asserts the promised behavior (a delayed response is ignored)
+//! and FAILS while the defect exists.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::Result;
+use maplit::btreeset;
+use openraft::Config;
+use openraft::RPCTypes;
+use openraft::ServerState;
+use openraft::async_runtime::WatchReceiver;
+use openraft::errors::RPCError;
+use openraft::errors::Unreachable;
+use openraft::type_config::TypeConfigExt;
+use openraft_memstore::TypeConfig;
+
+use crate::fixtures::RaftRouter;
+use crate::fixtures::rpc_request::RpcRequest;
+use crate::fixtures::rpc_response::RpcResponse;
+use crate::fixtures::ut_harness;
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_stale_pre_vote_grant_from_removed_member() -> Result<()> {
+    let config = Arc::new(
+        Config {
+            enable_elect: false,
+            // Every heartbeat runs become_following on node 1, which drops a
+            // live Pre-Vote round; without heartbeats the round stays live
+            // until the delayed response arrives (log replication still runs).
+            enable_heartbeat: false,
+            enable_pre_vote: Some(true),
+            election_timeout_min: 3000,
+            election_timeout_max: 4000,
+            heartbeat_interval: 200,
+            ..Default::default()
+        }
+        .validate()?,
+    );
+
+    let mut router = RaftRouter::new(config.clone());
+    tracing::info!("--- create cluster of 0,1,2,3; node 0 becomes leader");
+    router.new_cluster(btreeset! {0,1,2,3}, btreeset! {}).await?;
+    let n0 = router.get_raft_handle(&0)?;
+    let n1 = router.get_raft_handle(&1)?;
+    n0.wait(timeout()).state(ServerState::Leader, "node 0 is leader").await?;
+    let t = n1.metrics().borrow_watched().current_term;
+
+    // Node 3 stops hearing from the leader, so its lease expires and it would
+    // grant a Pre-Vote; nodes 1 and 2 keep receiving heartbeats.
+    router
+        .set_rpc_pre_hook(RPCTypes::AppendEntries, |_r, _req, _from, to| {
+            let blocked = to == 3;
+            Box::pin(async move {
+                if blocked {
+                    Err(RPCError::Unreachable(Unreachable::<TypeConfig>::from_string("specula: block 0 -> 3")))
+                } else {
+                    Ok(())
+                }
+            })
+        })
+        .await;
+    // Pre-Vote requests of node 1 do not reach the leader (keeps it out of the
+    // tally); node 3's grant for round 1 is delayed by 1500 ms (< 3000 ms RPC timeout).
+    router
+        .set_rpc_pre_hook(RPCTypes::Vote, move |_r, req, from, to| {
+            let drop_to_leader = matches!(&req, RpcRequest::Vote(v) if from == 1 && to == 0 && v.vote.leader_id().term == t + 1);
+            Box::pin(async move {
+                if drop_to_leader {
+                    Err(RPCError::Unreachable(Unreachable::<TypeConfig>::from_string("specula: drop 1 -> 0")))
+                } else {
+                    Ok(())
+                }
+            })
+        })
+        .await;
+    router
+        .set_rpc_post_hook(RPCTypes::Vote, move |_r, req, _resp: RpcResponse<TypeConfig>, from, to| {
+            let slow = matches!(&req, RpcRequest::Vote(v) if from == 1 && to == 3 && v.vote.leader_id().term == t + 1);
+            Box::pin(async move {
+                if slow {
+                    TypeConfig::sleep(Duration::from_millis(1500)).await;
+                }
+                Ok(())
+            })
+        })
+        .await;
+
+    tracing::info!("--- wait for node 3's lease to expire");
+    TypeConfig::sleep(Duration::from_millis(4500)).await;
+
+    tracing::info!("--- node 1: Pre-Vote round 1 (config 0,1,2,3)");
+    n1.trigger().elect(true).await?;
+    TypeConfig::sleep(Duration::from_millis(100)).await;
+
+    tracing::info!("--- leader removes node 3");
+    n0.change_membership([0, 1, 2], false).await?;
+    n1.wait(timeout())
+        .metrics(
+            |m| m.membership_config.membership().voter_ids().collect::<Vec<_>>() == vec![0, 1, 2],
+            "node 1 sees config 0,1,2",
+        )
+        .await?;
+
+    // Let the trailing commit-index replication reach node 1 first.
+    TypeConfig::sleep(Duration::from_millis(300)).await;
+    tracing::info!("--- node 1: Pre-Vote round 2 at the same term (config 0,1,2)");
+    n1.trigger().elect(true).await?;
+    assert_eq!(t, n1.metrics().borrow_watched().current_term);
+
+    tracing::info!("--- wait for node 3's delayed grant to round 1");
+    TypeConfig::sleep(Duration::from_millis(2500)).await;
+
+    let core = n1.with_raft_state(|st| (st.server_state, st.vote_ref().leader_id().term)).await;
+    println!("SPECULA_OBSERVATION stale grant: node1 RaftCore probe: {:?}", core);
+    let core = core.map_err(|e| anyhow::anyhow!("RaftCore of node 1 is no longer running: {}", e))?;
+    assert_eq!((ServerState::Follower, t), core, "a delayed grant from a removed member must be ignored");
+    Ok(())
+}
+
+fn timeout() -> Option<Duration> {
+    Some(Duration::from_millis(5000))
+}
diff --git a/tests/tests/elect/t94_specula_pre_vote_term_stall.rs b/tests/tests/elect/t94_specula_pre_vote_term_stall.rs
new file mode 100644
index 0000000..1a054ff
--- /dev/null
+++ b/tests/tests/elect/t94_specula_pre_vote_term_stall.rs
@@ -0,0 +1,145 @@
+//! Specula reproduction (CR-1): a rejected Pre-Vote never carries the
+//! responder's higher term back to the requester.
+//!
+//! Five voters {0..4}. Leader 0 replicates one extra entry only to node 1 and
+//! then fails for good. While node 1 is partitioned, nodes 2,3,4 elect a
+//! leader W at a higher term; W fails before replicating anything. Node 1
+//! rejoins: it has the freshest log but a stale term; the two other live
+//! nodes hold W's higher (uncommitted) vote but a shorter log. Three of five
+//! voters are alive and connected.
+//!
+//! - With Pre-Vote: node 1's Pre-Vote is rejected (its vote is lower) and it
+//!   never learns the higher term; the others' Pre-Votes are rejected by node
+//!   1 (shorter log). Nobody ever raises its term: no leader.
+//! - Control without Pre-Vote: node 1's rejected real election adopts the
+//!   higher term and its next election wins.
+//!
+//! `specula_pre_vote_term_stall_live_majority_elects` asserts the promised
+//! progress and FAILS while the defect exists; the control passes.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use anyhow::Result;
+use maplit::btreeset;
+use openraft::Config;
+use openraft::RPCTypes;
+use openraft::ServerState;
+use openraft::async_runtime::WatchReceiver;
+use openraft::errors::RPCError;
+use openraft::errors::Unreachable;
+use openraft::type_config::TypeConfigExt;
+use openraft_memstore::TypeConfig;
+
+use crate::fixtures::RaftRouter;
+use crate::fixtures::ut_harness;
+
+/// Returns (live node ids, leader among them, their terms).
+async fn stall_scenario(pre_vote: bool) -> Result<(Vec<u64>, Option<u64>, Vec<u64>)> {
+    let config = Arc::new(
+        Config {
+            enable_pre_vote: Some(pre_vote),
+            ..Default::default()
+        }
+        .validate()?,
+    );
+    let mut router = RaftRouter::new(config.clone());
+    let mut log_index = router.new_cluster(btreeset! {0,1,2,3,4}, btreeset! {}).await?;
+    router.get_raft_handle(&0)?.wait(timeout()).state(ServerState::Leader, "node 0 is leader").await?;
+
+    // Nodes 2,3,4 do not run their election timers yet.
+    for id in [2, 3, 4] {
+        router.get_raft_handle(&id)?.runtime_config().elect(false);
+    }
+    // Leader 0 replicates only to node 1; whatever 2,3,4 would replicate never arrives.
+    router
+        .set_rpc_pre_hook(RPCTypes::AppendEntries, |_r, _req, from, to| {
+            let blocked = (from == 0 && to != 1) || [2, 3, 4].contains(&from);
+            Box::pin(async move {
+                if blocked {
+                    Err(RPCError::Unreachable(Unreachable::<TypeConfig>::from_string("specula: blocked")))
+                } else {
+                    Ok(())
+                }
+            })
+        })
+        .await;
+
+    tracing::info!("--- leader 0 appends one entry that reaches only node 1");
+    let r = router.clone();
+    TypeConfig::spawn(async move {
+        let _x = r.client_request(0, "foo", 1).await;
+    });
+    log_index += 1;
+    let n1 = router.get_raft_handle(&1)?;
+    n1.wait(timeout()).log_index(Some(log_index), "node 1 has the extra entry").await?;
+
+    tracing::info!("--- node 0 fails for good; node 1 is partitioned for now");
+    router.set_network_error(0, true);
+    router.set_network_error(1, true);
+    n1.runtime_config().elect(false);
+
+    tracing::info!("--- nodes 2,3,4 elect a leader among themselves");
+    for id in [2, 3, 4] {
+        router.get_raft_handle(&id)?.runtime_config().elect(true);
+    }
+    let mut w = None;
+    for _ in 0..200 {
+        for id in [2, 3, 4] {
+            if router.get_raft_handle(&id)?.metrics().borrow_watched().state == ServerState::Leader {
+                w = Some(id);
+            }
+        }
+        if w.is_some() {
+            break;
+        }
+        TypeConfig::sleep(Duration::from_millis(50)).await;
+    }
+    let w = w.ok_or_else(|| anyhow::anyhow!("nodes 2,3,4 did not elect a leader"))?;
+    tracing::info!("--- new leader {} fails for good before replicating", w);
+    router.set_network_error(w, true);
+
+    tracing::info!("--- node 1 rejoins; live voters: 1 and the two remaining nodes");
+    router.set_network_error(1, false);
+    n1.runtime_config().elect(true);
+    let live = [1u64, 2, 3, 4].into_iter().filter(|id| *id != w).collect::<Vec<_>>();
+
+    TypeConfig::sleep(Duration::from_millis(5000)).await;
+
+    let mut leader = None;
+    let mut terms = vec![];
+    for id in &live {
+        let m = router.get_raft_handle(id)?.metrics().borrow_watched().clone();
+        println!("SPECULA_OBSERVATION pre_vote={} node {}: state={:?} term={} last_log={:?}", pre_vote, id, m.state, m.current_term, m.last_log_index);
+        terms.push(m.current_term);
+        if m.state == ServerState::Leader {
+            leader = Some(*id);
+        }
+    }
+    Ok((live, leader, terms))
+}
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_pre_vote_term_stall_live_majority_elects() -> Result<()> {
+    let (live, leader, terms) = stall_scenario(true).await?;
+    assert!(
+        leader.is_some(),
+        "3 of 5 voters {:?} are alive and connected, but no leader was elected; terms stay {:?}",
+        live,
+        terms
+    );
+    Ok(())
+}
+
+#[tracing::instrument]
+#[test_harness::test(harness = ut_harness)]
+async fn specula_control_direct_election_live_majority_elects() -> Result<()> {
+    let (live, leader, terms) = stall_scenario(false).await?;
+    assert!(leader.is_some(), "control: no leader among {:?}; terms {:?}", live, terms);
+    Ok(())
+}
+
+fn timeout() -> Option<Duration> {
+    Some(Duration::from_millis(3000))
+}
