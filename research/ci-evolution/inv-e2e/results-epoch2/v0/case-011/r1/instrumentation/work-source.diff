index 0000000..907455f
--- /dev/null
+++ b/openraft/src/engine/tests/specula_repro_test.rs
@@ -0,0 +1,328 @@
+//! Specula reproduction tests for the Pre-Vote update.
+//!
+//! Each `specula_repro_*` test asserts the behavior the update promises; it
+//! FAILS while the defect is present. `specula_control_*` tests show the
+//! comparison path (direct elections, as in the old revision) and pass.
+
+use std::time::Duration;
+
+use maplit::btreeset;
+
+use crate::Vote;
+use crate::core::ServerState;
+use crate::engine::Command;
+use crate::engine::Engine;
+use crate::engine::LogIdList;
+use crate::engine::testing::UTConfig;
+use crate::engine::testing::log_id;
+use crate::raft::VoteRequest;
+use crate::raft::VoteResponse;
+use crate::raft_state::LogStateReader;
+use crate::type_config::TypeConfigExt;
+use crate::utime::Leased;
+
+fn node(id: u64, voters: std::collections::BTreeSet<u64>, last_index: u64, vote: Vote<crate::engine::testing::UTLeaderId>) -> Engine<UTConfig> {
+    use std::sync::Arc;
+
+    use crate::Membership;
+    use crate::MembershipState;
+    use crate::type_config::alias::StoredMembershipOf;
+
+    let mut eng = Engine::testing_default(id);
+    eng.state.enable_validation(false);
+    eng.config.id = id;
+    let m = Arc::new(StoredMembershipOf::<UTConfig>::new(
+        Some(log_id(1, 1, 1)),
+        Membership::new_with_defaults(vec![voters], []),
+    ));
+    eng.state.membership_state = MembershipState::new(m.clone(), m);
+    eng.state.log_ids = LogIdList::new(None, [log_id(1, 1, last_index)]);
+    // Expired lease: no live leader is known.
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::ZERO, vote);
+    eng.state.server_state = ServerState::Follower;
+    eng.output.clear_commands();
+    eng
+}
+
+/// Scenario U2 / MC finding: a Pre-Vote round started while the node was
+/// still a Candidate survives leader establishment; a delayed grant then
+/// makes the established Leader call `elect()` and abandon its leadership.
+#[test]
+fn specula_repro_stale_pre_vote_round_deposes_leader() -> anyhow::Result<()> {
+    let mut eng = node(1, btreeset! {1, 2, 3}, 1, Vote::new(2, 1));
+    eng.state.server_state = ServerState::Candidate;
+    eng.new_candidate(*eng.state.vote_ref()).grant_by(&1);
+    eng.output.clear_commands();
+
+    // Election timer fires while the real election at term 2 is in flight.
+    eng.pre_elect();
+    let pre_vote = *eng.pre_candidate_ref().unwrap().vote_ref();
+    assert_eq!(Vote::new(3, 1), pre_vote);
+
+    // The real election wins.
+    eng.handle_vote_resp(2, VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true));
+    assert_eq!(ServerState::Leader, eng.state.server_state);
+    assert_eq!(Vote::new_committed(2, 1), *eng.state.vote_ref());
+    eng.output.clear_commands();
+
+    // Node 2 granted the Pre-Vote before it learned about the new leader; the
+    // response is delivered now and passes RaftCore's pre-candidate filter.
+    assert!(eng.pre_candidate_ref().is_some(), "the superseded Pre-Vote round is still live");
+    eng.handle_pre_vote_resp(2, VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true));
+
+    assert_eq!(
+        ServerState::Leader,
+        eng.state.server_state,
+        "a stale Pre-Vote quorum must not depose an established leader"
+    );
+    assert_eq!(Vote::new_committed(2, 1), *eng.state.vote_ref());
+    Ok(())
+}
+
+/// Drive one Pre-Vote round of node `x` against the live peers, the way
+/// RaftCore does (SendPreVote -> peers' handle_pre_vote_req -> filtered
+/// handle_pre_vote_resp). Returns true if a real election was started.
+fn pre_vote_round(nodes: &mut [Engine<UTConfig>], x: usize) -> bool {
+    nodes[x].pre_elect();
+    if nodes[x].candidate_ref().is_some() {
+        return true;
+    }
+    let req: VoteRequest<UTConfig> = nodes[x]
+        .output
+        .iter_commands()
+        .find_map(|c| match c {
+            Command::SendPreVote { vote_req } => Some(vote_req.clone()),
+            _ => None,
+        })
+        .expect("SendPreVote queued");
+    nodes[x].output.clear_commands();
+    for y in 0..nodes.len() {
+        if y == x {
+            continue;
+        }
+        let resp = nodes[y].handle_pre_vote_req(req.clone());
+        nodes[y].output.clear_commands();
+        let target = nodes[y].config.id;
+        let matches = nodes[x].pre_candidate_ref().map(|p| p.vote_ref().leader_id == req.vote.leader_id).unwrap_or(false);
+        if matches {
+            nodes[x].handle_pre_vote_resp(target, resp);
+        }
+        if nodes[x].candidate_ref().is_some() {
+            return true;
+        }
+    }
+    false
+}
+
+/// Drive one direct election of node `x` (the pre-update path): self grant
+/// after SaveVote, then the peers' handle_vote_req and filtered
+/// handle_vote_resp. Returns true if `x` became leader.
+fn direct_election(nodes: &mut [Engine<UTConfig>], x: usize) -> bool {
+    nodes[x].elect();
+    let req: VoteRequest<UTConfig> = nodes[x]
+        .output
+        .iter_commands()
+        .find_map(|c| match c {
+            Command::SendVote { vote_req } => Some(vote_req.clone()),
+            _ => None,
+        })
+        .expect("SendVote queued");
+    nodes[x].output.clear_commands();
+    let me = nodes[x].config.id;
+    let self_resp = VoteResponse::new(req.vote, nodes[x].state.last_log_id().cloned(), true);
+    nodes[x].handle_vote_resp(me, self_resp);
+    for y in 0..nodes.len() {
+        if y == x {
+            continue;
+        }
+        let resp = nodes[y].handle_vote_req(req.clone());
+        nodes[y].output.clear_commands();
+        let target = nodes[y].config.id;
+        let matches = nodes[x].candidate_ref().map(|c| c.vote_ref().leader_id == req.vote.leader_id).unwrap_or(false);
+        if matches {
+            nodes[x].handle_vote_resp(target, resp);
+        }
+        nodes[x].output.clear_commands();
+        if nodes[x].state.server_state == ServerState::Leader {
+            return true;
+        }
+    }
+    false
+}
+
+/// Five voters {1..5}; nodes 1 and 3 have crashed permanently. Node 2 holds
+/// the longest log (1,1,2) but still votes for the old leader at term 1;
+/// nodes 4 and 5 granted node 3's real vote at term 2 but lack entry 2.
+fn stalled_cluster() -> Vec<Engine<UTConfig>> {
+    let voters = btreeset! {1, 2, 3, 4, 5};
+    vec![
+        node(2, voters.clone(), 2, Vote::new_committed(1, 1)),
+        node(4, voters.clone(), 1, Vote::new(2, 3)),
+        node(5, voters, 1, Vote::new(2, 3)),
+    ]
+}
+
+/// Code-review finding: a rejected Pre-Vote never carries the responder's
+/// higher term back to the requester, so a live majority whose freshest log
+/// sits at a stale term can never pass Pre-Vote, while the higher-term nodes
+/// fail the log check. The cluster stays leaderless with 3 of 5 voters up.
+#[test]
+fn specula_repro_pre_vote_term_stall() -> anyhow::Result<()> {
+    let mut nodes = stalled_cluster();
+    let mut elected = false;
+    for _round in 0..10 {
+        for x in 0..nodes.len() {
+            if pre_vote_round(&mut nodes, x) {
+                elected = true;
+            }
+        }
+        if elected {
+            break;
+        }
+    }
+    let terms = nodes.iter().map(|n| n.state.vote_ref().leader_id.term).collect::<Vec<_>>();
+    assert!(
+        elected,
+        "a live majority (nodes 2,4,5 of 5) must eventually start an election; terms stay {:?}",
+        terms
+    );
+    Ok(())
+}
+
+/// Control: the same cluster state with direct elections (Pre-Vote disabled,
+/// the pre-update behavior). When node 2's randomized timer fires first, its
+/// rejected election adopts term 2 and its next election wins; the Pre-Vote
+/// schedule above includes this same schedule (node 2 retrying alone) and
+/// still never starts an election.
+#[test]
+fn specula_control_direct_election_progresses() -> anyhow::Result<()> {
+    let mut nodes = stalled_cluster();
+    let mut leader = None;
+    for _attempt in 0..3 {
+        if direct_election(&mut nodes, 0) {
+            leader = Some(nodes[0].config.id);
+            break;
+        }
+    }
+    assert_eq!(Some(2), leader, "direct elections let the freshest log win after adopting term 2");
+    Ok(())
+}
+
+/// The Pre-Vote counterpart of the control schedule: node 2 retries alone.
+#[test]
+fn specula_repro_pre_vote_term_stall_node2_alone() -> anyhow::Result<()> {
+    let mut nodes = stalled_cluster();
+    let mut elected = false;
+    for _attempt in 0..3 {
+        if pre_vote_round(&mut nodes, 0) {
+            elected = true;
+            break;
+        }
+    }
+    assert!(elected, "node 2 (freshest log) must be able to pass Pre-Vote once it learns term 2");
+    Ok(())
+}
+
+/// Scenario U5: Pre-Vote rounds at an unchanged term reuse the leader id
+/// `(term+1, self)`. A round started before a membership change that removes
+/// node 2 is superseded (become_following drops it) and a new round is started
+/// with the new config (e.g. `Trigger::elect(true)` again). Node 2's delayed
+/// grant to the first round passes RaftCore's filter (same leader id) and
+/// `Candidate::grant_by` hits `expect("target not in quorum set")`.
+/// The promised behavior is that a delayed response is ignored; this test
+/// FAILS (panics) while the defect is present.
+#[test]
+fn specula_repro_stale_pre_vote_grant_from_removed_member() -> anyhow::Result<()> {
+    use crate::raft::LogSegment;
+    use crate::testing::membership_ent;
+
+    let mut eng = node(1, btreeset! {1, 2, 3}, 1, Vote::new_committed(1, 2));
+
+    // Round 1 with config {1,2,3}; requests go to 2 and 3.
+    eng.pre_elect();
+    let round1 = *eng.pre_candidate_ref().unwrap().vote_ref();
+    eng.output.clear_commands();
+
+    // Leader 2 (same term 1) replicates a joint and then a uniform config that
+    // removes node 2. AppendEntries runs become_following: the round is dropped.
+    let res = eng.append_entries(
+        &Vote::new_committed(1, 2),
+        LogSegment::new(Some(log_id(1, 1, 1)), vec![
+            membership_ent::<UTConfig>(1, 2, 2, vec![btreeset! {1, 2, 3}, btreeset! {1, 3}]),
+            membership_ent::<UTConfig>(1, 2, 3, vec![btreeset! {1, 3}]),
+        ]),
+    );
+    assert!(res.is_ok(), "append_entries accepted: {:?}", res);
+    assert_eq!(
+        vec![1, 3],
+        eng.state.membership_state.effective().voter_ids().collect::<Vec<_>>(),
+        "node 2 removed from the effective config"
+    );
+    assert!(eng.pre_candidate_ref().is_none());
+    assert_eq!(Vote::new_committed(1, 2), *eng.state.vote_ref(), "same leader, same term");
+    eng.output.clear_commands();
+
+    // Round 2 (operator Trigger::elect(true)), same term -> same leader id, config {1,3}.
+    eng.pre_elect();
+    let round2 = *eng.pre_candidate_ref().unwrap().vote_ref();
+    assert_eq!(round1.leader_id, round2.leader_id, "rounds at one term share the leader id");
+    eng.output.clear_commands();
+
+    // Node 2's delayed grant to round 1 arrives; RaftCore's filter compares
+    // only the leader id, so it reaches the engine.
+    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        eng.handle_pre_vote_resp(2, VoteResponse::new(Vote::new_committed(1, 2), Some(log_id(1, 1, 1)), true));
+    }));
+    assert!(
+        res.is_ok(),
+        "a delayed Pre-Vote grant from a node outside the round's config must be ignored, not panic"
+    );
+    Ok(())
+}
+
+/// MC-2, leader variant (the model-checking counterexample shape): a
+/// timer-started round of a Candidate survives establishment (MC-1 state);
+/// the new Leader removes node 3 from the membership; an operator
+/// `Trigger::elect(true)` starts a new round at the same term with config
+/// {1,2}; node 3's delayed grant to the first round reaches `grant_by`.
+/// FAILS (panics) while the defect is present.
+#[test]
+fn specula_repro_stale_pre_vote_grant_leader_variant() -> anyhow::Result<()> {
+    use crate::Membership;
+    use crate::entry::payload::EntryPayload;
+
+    let mut eng = node(1, btreeset! {1, 2, 3}, 1, Vote::new(2, 1));
+    eng.state.server_state = ServerState::Candidate;
+    eng.new_candidate(*eng.state.vote_ref()).grant_by(&1);
+    eng.output.clear_commands();
+
+    // Timer round on the Candidate (config {1,2,3}); requests to 2 and 3.
+    eng.pre_elect();
+    let round1 = *eng.pre_candidate_ref().unwrap().vote_ref();
+    // The real election wins; the round survives.
+    eng.handle_vote_resp(2, VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true));
+    assert_eq!(ServerState::Leader, eng.state.server_state);
+    eng.output.clear_commands();
+
+    // The Leader removes node 3: joint, then uniform {1,2}.
+    let joint = Membership::<u64, ()>::new_with_defaults(vec![btreeset! {1, 2, 3}, btreeset! {1, 2}], []);
+    let uniform = Membership::<u64, ()>::new_with_defaults(vec![btreeset! {1, 2}], []);
+    eng.try_leader_handler()?.leader_append_entries([EntryPayload::Membership(joint)]);
+    eng.try_leader_handler()?.leader_append_entries([EntryPayload::Membership(uniform)]);
+    eng.output.clear_commands();
+
+    // Operator Trigger::elect(true) on the Leader: same term -> same leader id.
+    eng.pre_elect();
+    let round2 = *eng.pre_candidate_ref().unwrap().vote_ref();
+    assert_eq!(round1.leader_id, round2.leader_id);
+    eng.output.clear_commands();
+
+    let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        eng.handle_pre_vote_resp(3, VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true));
+    }));
+    assert!(
+        res.is_ok(),
+        "a delayed Pre-Vote grant from a node outside the round's config must be ignored, not panic"
+    );
+    Ok(())
+}
