+package org.apache.zookeeper.server.quorum;
+
+import java.io.BufferedWriter;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicLong;
+import org.apache.zookeeper.server.ZooKeeperServer;
+import org.apache.zookeeper.server.util.ZxidUtils;
+
+/** Opt-in, synchronous Specula NDJSON instrumentation. */
+public final class SpeculaTrace {
+
+    private static final AtomicLong SEQUENCE = new AtomicLong();
+
+    // Incremental-update probes (rebased harness).  fsyncedZxid is the raw
+    // watermark written immediately after the transaction-log force returns;
+    // emittedDurableZxid is updated atomically with the TxnDurable record, so
+    // it always equals the last TxnDurable zxid preceding a reader in the trace.
+    private static final ConcurrentHashMap<Long, Long> FSYNCED = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<Long, Long> EMITTED_DURABLE = new ConcurrentHashMap<>();
+
+    public static void noteFsynced(ZooKeeperServer server, long zxid) {
+        if (!isEnabled() || server == null) {
+            return;
+        }
+        FSYNCED.put(server.getServerId(), zxid);
+    }
+
+    public static long fsyncedZxid(long sid) {
+        Long v = FSYNCED.get(sid);
+        return v == null ? 0 : v;
+    }
+
+    public static synchronized void emitDurable(String event, ZooKeeperServer server, long zxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        if (server != null) {
+            EMITTED_DURABLE.put(server.getServerId(), zxid);
+        }
+        emit(event, server, zxid);
+    }
+
+    /** NEWLEADER ACK written by Learner.syncWithLeader (Zab 1.0 branch). */
+    public static synchronized void emitNewLeaderAck(QuorumPeer peer, long newLeaderZxid,
+            long lastLoggedAtNewLeader, int loggedAtNewLeader, long fsyncedAtAck, String serverState) {
+        if (!isEnabled()) {
+            return;
+        }
+        Long d = EMITTED_DURABLE.get(peer.getId());
+        String extra = ",\"update\":{\"queuedZxid\":\"" + lastLoggedAtNewLeader + "\""
+            + ",\"queuedEpoch\":" + (lastLoggedAtNewLeader < 0 ? -1 : ZxidUtils.getEpochFromZxid(lastLoggedAtNewLeader))
+            + ",\"queuedCounter\":" + (lastLoggedAtNewLeader < 0 ? -1 : (lastLoggedAtNewLeader & 0xffffffffL))
+            + ",\"loggedAtNewLeader\":" + loggedAtNewLeader
+            + ",\"durableZxid\":\"" + (d == null ? 0 : d) + "\""
+            + ",\"durableEpoch\":" + (d == null ? 0 : ZxidUtils.getEpochFromZxid(d))
+            + ",\"durableCounter\":" + (d == null ? 0 : (d & 0xffffffffL))
+            + ",\"fsyncedZxidAtAck\":\"" + fsyncedAtAck + "\""
+            + ",\"serverState\":\"" + escape(serverState) + "\"}";
+        emitPeer("NewLeaderAckSent", peer, newLeaderZxid, extra);
+    }
+
+    /** Leader.waitForNewLeaderAck decision for one learner ACK. */
+    public static synchronized void emitNewLeaderAckReceived(QuorumPeer leader, long sid, long zxid,
+            String disposition) {
+        if (!isEnabled()) {
+            return;
+        }
+        String extra = ",\"update\":{\"fromSid\":\"s" + sid + "\",\"disposition\":\""
+            + escape(disposition) + "\"}";
+        emitPeer("NewLeaderAckReceived", leader, zxid, extra);
+    }
+
+    /** ZooKeeperServer.shutdown returned early because canShutdown() was false. */
+    public static synchronized void emitShutdownSkipped(ZooKeeperServer server, long zxid, String state) {
+        if (!isEnabled()) {
+            return;
+        }
+        String extra = ",\"update\":{\"serverState\":\"" + escape(state) + "\"}";
+        emit("ShutdownSkipped", server == null ? -1 : server.getServerId(), zxid, -1, -1,
+             "unknown", "unknown", "NONE", extra);
+    }
+
+    private static void emitPeer(String event, QuorumPeer peer, long zxid, String extra) {
+        long accepted = -1;
+        long current = -1;
+        try {
+            accepted = peer.getAcceptedEpoch();
+            current = peer.getCurrentEpoch();
+        } catch (IOException e) {
+            // Capture remains useful when epoch files are not initialized yet.
+        }
+        emit(event, peer.getId(), zxid, accepted, current,
+             peer.getPeerState().toString().toLowerCase(),
+             peer.getZabState().toString().toLowerCase(),
+             peer.getSyncMode().toString(), extra);
+    }
+
+    private SpeculaTrace() {
+    }
+
+    public static boolean isEnabled() {
+        String path = System.getProperty("specula.trace.file");
+        return path != null && !path.isEmpty();
+    }
+
+    public static void emit(String event, QuorumPeer peer, long zxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        if (peer == null) {
+            emit(event, -1, zxid, -1, -1, "unknown", "unknown", "NONE");
+            return;
+        }
+        long accepted = -1;
+        long current = -1;
+        try {
+            accepted = peer.getAcceptedEpoch();
+            current = peer.getCurrentEpoch();
+        } catch (IOException e) {
+            // Capture remains useful when epoch files are not initialized yet.
+        }
+        emit(event,
+             peer.getId(),
+             zxid,
+             accepted,
+             current,
+             peer.getPeerState().toString().toLowerCase(),
+             peer.getZabState().toString().toLowerCase(),
+             peer.getSyncMode().toString());
+    }
+
+    public static void emit(String event, ZooKeeperServer server, long zxid) {
+        if (!isEnabled()) {
+            return;
+        }
+        emit(event,
+             server == null ? -1 : server.getServerId(),
+             zxid,
+             -1,
+             -1,
+             "unknown",
+             "unknown",
+             "NONE");
+    }
+
+    public static synchronized void emit(
+            String event,
+            long sid,
+            long zxid,
+            long acceptedEpoch,
+            long currentEpoch,
+            String role,
+            String phase,
+            String syncMode) {
+        emit(event, sid, zxid, acceptedEpoch, currentEpoch, role, phase, syncMode, "");
+    }
+
+    public static synchronized void emit(
+            String event,
+            long sid,
+            long zxid,
+            long acceptedEpoch,
+            long currentEpoch,
+            String role,
+            String phase,
+            String syncMode,
+            String extra) {
+        String path = System.getProperty("specula.trace.file");
+        if (!isEnabled()) {
+            return;
+        }
+        long sequence = SEQUENCE.incrementAndGet();
+        Thread thread = Thread.currentThread();
+        long txnEpoch = zxid < 0 ? -1 : ZxidUtils.getEpochFromZxid(zxid);
+        long txnCounter = zxid < 0 ? -1 : (zxid & 0xffffffffL);
+        String scenario = System.getProperty("specula.trace.scenario", "unspecified");
+        String line = "{\"tag\":\"trace\",\"scenario\":\"" + escape(scenario)
+            + "\",\"seq\":" + sequence
+            + ",\"timeMillis\":" + System.currentTimeMillis()
+            + ",\"timeNanos\":" + System.nanoTime()
+            + ",\"thread\":{\"id\":" + thread.getId()
+            + ",\"name\":\"" + escape(thread.getName()) + "\"}"
+            + ",\"event\":{\"name\":\"" + escape(event)
+            + "\",\"node\":\"s" + sid
+            + "\",\"zxid\":\"" + zxid + "\""
+            + ",\"txnEpoch\":" + txnEpoch
+            + ",\"txnCounter\":" + txnCounter
+            + ",\"state\":{\"acceptedEpoch\":" + acceptedEpoch
+            + ",\"currentEpoch\":" + currentEpoch
+            + ",\"role\":\"" + escape(role)
+            + "\",\"phase\":\"" + escape(phase)
+            + "\",\"syncMode\":\"" + escape(syncMode)
+            + "\"}" + extra + "}}";
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+                 new FileOutputStream(path, true), StandardCharsets.UTF_8))) {
+            writer.write(line);
+            writer.newLine();
+        } catch (IOException e) {
+            throw new IllegalStateException("Unable to write Specula trace " + path, e);
+        }
+    }
+
+    private static String escape(String value) {
+        return value.replace("\\", "\\\\")
+                    .replace("\"", "\\\"")
+                    .replace("\n", "\\n")
+                    .replace("\r", "\\r");
+    }
+}
