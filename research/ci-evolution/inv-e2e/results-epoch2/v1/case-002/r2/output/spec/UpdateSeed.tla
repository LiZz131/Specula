----------------------------- MODULE UpdateSeed -----------------------------
(***************************************************************************)
(* Seeded entry points for the update campaign.  SeedInit is the literal   *)
(* last state (State 17) of the full-MCNext reachability witness           *)
(* spec/output/incr/canary-seed.log (Update-seed-canary.cfg, MCSpec from   *)
(* MCInit): s1 led epoch 1 after s2's NEWLEADER ACK, proposed t1 and       *)
(* fsynced it alone; all servers are back in LOOKING; nothing committed.   *)
(* Path: BeginElection(s1), CastVote(s2,s1), WinElection(s1),              *)
(* FollowLeader(s2,s1), AcceptEpoch(s2), FinishDiscovery(s1),              *)
(* EnterSyncPhase(s2,s1), SelectSync(s2,s1,DIFF), LearnerNewLeader(s2),    *)
(* LearnerAckNewLeader(s2), BeginElection(s2), LeaderBroadcast(s1),        *)
(* Propose(s1,t1), BeginElection(s1), AppendOne(s1), FsyncOne(s1)          *)
(* (re-derived after the Round U discovery-guard repair; see canary-seed.log). *)
(* Starting here only skips an already-witnessed prefix; every successor   *)
(* is generated by MCNext (or its restrictions below).                     *)
(***************************************************************************)
EXTENDS Update

CONSTANTS s1, s2, s3, t1

SeedInit ==
    /\ rollbackAuthorized = (s1 :> FALSE @@ s2 :> FALSE @@ s3 :> FALSE)
    /\ recovered = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ votes = (s1 :> {s1} @@ s2 :> {s2} @@ s3 :> {})
    \* witness ran with MaxEpoch = 2; later epochs have no leader yet
    /\ leadersByEpoch = [e \in Epoch |-> IF e = 1 THEN {s1} ELSE {}]
    /\ syncMode = (s1 :> "NONE" @@ s2 :> "NONE" @@ s3 :> "NONE")
    /\ commitCertified = (t1 :> FALSE)
    /\ syncSource = (s1 :> Nil @@ s2 :> Nil @@ s3 :> Nil)
    /\ applied = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ syncPending = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ durable = (s1 :> <<[epoch |-> 1, id |-> t1]>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ acked = (t1 :> {})
    /\ usedTxn = {t1}
    /\ everCommitted = {}
    /\ appended = (s1 :> <<[epoch |-> 1, id |-> t1]>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ acceptedEpoch = (s1 :> 1 @@ s2 :> 1 @@ s3 :> 0)
    /\ role = (s1 :> "looking" @@ s2 :> "looking" @@ s3 :> "looking")
    /\ seen = { "durable",
      "election",
      "sync",
      "broadcast",
      "DIFF",
      "newleader",
      "leader",
      "nlack",
      "mutation" }
    /\ syncJustified = (s1 :> FALSE @@ s2 :> FALSE @@ s3 :> FALSE)
    /\ phase = (s1 :> "election" @@ s2 :> "election" @@ s3 :> "election")
    /\ snapshot = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ currentEpoch = (s1 :> 1 @@ s2 :> 1 @@ s3 :> 0)
    /\ queued = (s1 :> <<[epoch |-> 1, id |-> t1]>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ proposed = (s1 :> <<[epoch |-> 1, id |-> t1]>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ committed = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
    /\ counters = [crash |-> 0, drop |-> 0, snapshot |-> 0]
    /\ up = (s1 :> TRUE @@ s2 :> TRUE @@ s3 :> TRUE)
    /\ learnerStage = (s1 :> "idle" @@ s2 :> "idle" @@ s3 :> "idle")
    /\ messages = { [epoch |-> 1, id |-> t1, kind |-> "proposal", from |-> s1, to |-> s2],
      [epoch |-> 1, id |-> t1, kind |-> "proposal", from |-> s1, to |-> s3] }
    /\ leaderOf = (s1 :> Nil @@ s2 :> Nil @@ s3 :> Nil)
    /\ nlAcks = (s1 :> {} @@ s2 :> {} @@ s3 :> {})

\* Full reference MCNext from the seed.
SeedFullSpec == SeedInit /\ [][MCNext]_vars
\* Concrete focused view (Affected \/ Interaction actions) from the seed.
SeedFocusedSpec == SeedInit /\ [][FocusedNext]_vars
\* Hypothetical-fix control (NOT the implementation), see Update!FixedControlNext.
SeedFixedSpec == SeedInit /\ [][FixedControlNext]_vars

=============================================================================
