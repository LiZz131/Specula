+// ---------------------------------------------------------------------------
+// Update-focused scenarios (Pre-Vote). Each one drives the real updated
+// Engine methods (`pre_elect`, `handle_pre_vote_req`, `handle_pre_vote_resp`)
+// and their unchanged producers/consumers. Peer messages are constructed with
+// the exact field values a peer's Engine/runtime would send; the runtime
+// correlation filter `does_pre_candidate_vote_match` is represented by the
+// `vote` argument of a Pre-Vote response (the pre-candidate vote it answers).
+// ---------------------------------------------------------------------------
+
+fn pre_vote_req_args(source: u64, req: &VoteRequest<UTConfig>, resp: &VoteResponse<UTConfig>) -> Value {
+    json!({
+        "source": source.to_string(),
+        "vote": vote_json(&req.vote),
+        "last_log": log_json(req.last_log_id.as_ref(), source),
+        "transfer": req.leadership_transfer,
+        "response_vote": vote_json(&resp.vote),
+        "response_granted": resp.vote_granted,
+    })
+}
+
+fn pre_vote_resp_args(
+    source: u64,
+    candidate_vote: &Vote<crate::engine::testing::UTLeaderId>,
+    resp: &VoteResponse<UTConfig>,
+) -> Value {
+    json!({
+        "source": source.to_string(),
+        "vote": vote_json(candidate_vote),
+        "response_vote": vote_json(&resp.vote),
+        "last_log": log_json(resp.last_log_id.as_ref(), source),
+        "granted": resp.vote_granted,
+    })
+}
