+/// old context -> PreElect -> old Action -> affected Action: a Candidate whose
+/// election timer fires starts a Pre-Vote round, then wins its real election
+/// (leader establishment), then a granted Pre-Vote response arrives for the
+/// still-registered round.
+#[test]
+fn specular_trace_pre_vote_after_establish() -> anyhow::Result<()> {
+    let mut eng = base_engine(1, vec![btreeset! {1, 2, 3}], 1);
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::ZERO, Vote::new(2, 1));
+    eng.state.server_state = ServerState::Candidate;
+    let candidate = eng.new_candidate(*eng.state.vote_ref());
+    candidate.grant_by(&1);
+    eng.output.clear_commands();
+
+    // e1: election timeout while still a Candidate -> Pre-Vote round at term 3.
+    let pre = state_json(&eng, false);
+    eng.pre_elect();
+    let post = state_json(&eng, false);
+    emit("PreElect", 1, pre, post, json!({"transfer": false}))?;
+    let cv = *eng.pre_candidate_ref().unwrap().vote_ref();
+
+    // e2: delayed real-vote grant from node 2 for term 2 -> leader established.
+    let response = VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true);
+    let pre = state_json(&eng, false);
+    eng.handle_vote_resp(2, response.clone());
+    let post = state_json(&eng, false);
+    emit(
+        "HandleVoteResponse",
+        1,
+        pre,
+        post,
+        json!({
+            "source": "2",
+            "vote": vote_json(&response.vote),
+            "last_log": log_json(response.last_log_id.as_ref(), 2),
+            "granted": response.vote_granted,
+        }),
+    )?;
+
+    // e3: node 2 had granted the Pre-Vote before it learned about the leader.
+    let resp = VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true);
+    let pre = state_json(&eng, false);
+    eng.handle_pre_vote_resp(2, resp.clone());
+    let post = state_json(&eng, false);
+    emit("HandlePreVoteResponse", 1, pre, post, pre_vote_resp_args(2, &cv, &resp))
+}
