+
+/// A follower in a 3-voter cluster whose leader lease expired: the
+/// committed vote of node 2 at term 1 with a zero lease.
+fn expired_follower() -> Engine<UTConfig> {
+    let mut eng = base_engine(1, vec![btreeset! {1, 2, 3}], 1);
+    eng.state.vote = Leased::new(UTConfig::<()>::now(), Duration::ZERO, Vote::new_committed(1, 2));
+    eng
+}
