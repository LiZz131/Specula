+/// U-D: an in-flight round is dropped when the node grants a greater vote
+/// (handle_vote_req -> update_vote -> become_following).
+#[test]
+fn specular_trace_pre_vote_cleared_by_vote_request() -> anyhow::Result<()> {
+    let mut eng = expired_follower();
+    let pre = state_json(&eng, false);
+    eng.pre_elect();
+    let post = state_json(&eng, false);
+    emit("PreElect", 1, pre, post, json!({"caller": "external"}))?;
+    drain_commands(&mut eng);
+
+    let req = VoteRequest {
+        vote: Vote::new(3, 2),
+        last_log_id: Some(log_id(1, 1, 1)),
+        leadership_transfer: false,
+    };
+    let pre = state_json(&eng, false);
+    let resp = eng.handle_vote_req(req.clone());
+    let post = state_json(&eng, false);
+    emit(
+        "HandleVoteRequest",
+        1,
+        pre,
+        post,
+        json!({
+            "source": "2",
+            "vote": vote_json(&req.vote),
+            "last_log": log_json(req.last_log_id.as_ref(), 2),
+            "transfer": req.leadership_transfer,
+            "response_vote": vote_json(&resp.vote),
+            "response_granted": resp.vote_granted,
+        }),
+    )
+}
+
+/// U-E (interaction): old producer -> affected action -> old consumer ->
+/// affected action.  A real candidate whose election is slow is reached by
+/// the election timer, which (with enable_pre_vote and >1 voter) starts a
+/// Pre-Vote round; the real election then wins (establish_leader), and the
+/// round's quorum response is delivered afterwards.
+///
+/// Tick emulation: RaftCore::handle_tick_election's guards are asserted
+/// against the Engine state (not Leader, voter, >1 voter, no fresh round in
+/// flight) and its two Engine calls are performed:
+/// `reset_greater_log(); pre_elect();` (core/raft_core.rs:2027-2031).
+#[test]
+fn specular_trace_stale_pre_vote_after_leader() -> anyhow::Result<()> {
+    let mut eng = expired_follower();
+
+    // e1: real election (vote (2,1)).
+    let pre = state_json(&eng, false);
+    eng.elect();
+    let post = state_json(&eng, false);
+    emit("StartElection", 1, pre, post, json!({"transfer": false, "caller": "external"}))?;
+    let cmds = drain_commands(&mut eng);
+    assert!(cmds.contains(&CommandName::SaveVote) && cmds.contains(&CommandName::SendVote));
+
+    // e2: RaftCore's local self-grant after save_vote (core/raft_core.rs:2290-2302).
+    let self_grant = VoteResponse::new(Vote::new(2, 1), None, true);
+    let pre = state_json(&eng, false);
+    eng.handle_vote_resp(1, self_grant.clone());
+    let post = state_json(&eng, false);
+    emit("HandleVoteResponse", 1, pre, post, vote_resp_args(1, &self_grant))?;
+    drain_commands(&mut eng);
+
+    // e3: election timer fires while still Candidate -> Pre-Vote round (3,1).
+    assert_ne!(ServerState::Leader, eng.state.server_state);
+    assert!(eng.state.membership_state.effective().is_voter(&1));
+    assert!(eng.state.membership_state.effective().voter_ids().count() > 1);
+    assert!(eng.pre_candidate_ref().is_none());
+    let pre = state_json(&eng, false);
+    eng.reset_greater_log();
+    eng.pre_elect();
+    let post = state_json(&eng, false);
+    emit("PreElect", 1, pre, post, json!({"caller": "tick"}))?;
+    drain_commands(&mut eng);
+
+    // e4: the delayed real vote response from node 2 completes the quorum.
+    let grant = VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true);
+    let pre = state_json(&eng, false);
+    eng.handle_vote_resp(2, grant.clone());
+    let post = state_json(&eng, false);
+    emit("HandleVoteResponse", 1, pre, post, vote_resp_args(2, &grant))?;
+    drain_commands(&mut eng);
+    assert_eq!(ServerState::Leader, eng.state.server_state);
+
+    // e5: node 2's answer to the Pre-Vote (3,1) arrives; the runtime gate passes.
+    let req_vote = Vote::new(3, 1);
+    let pre_resp = VoteResponse::new(Vote::new(2, 1), Some(log_id(1, 1, 1)), true);
+    assert!(runtime_pre_vote_gate(&eng, &req_vote));
+    let pre = state_json(&eng, false);
+    eng.handle_pre_vote_resp(2, pre_resp.clone());
+    let post = state_json(&eng, false);
+    emit("HandlePreVoteResponse", 1, pre, post, pre_vote_resp_args(2, &pre_resp, &req_vote))
+}
