+/// U-C: pre_elect, then one granted pre-vote response completes the quorum
+/// and starts the real election (handle_pre_vote_resp -> elect).
+#[test]
+fn specular_trace_pre_vote_resp_quorum() -> anyhow::Result<()> {
+    let mut eng = expired_follower();
+    let pre = state_json(&eng, false);
+    eng.pre_elect();
+    let post = state_json(&eng, false);
+    emit("PreElect", 1, pre, post, json!({"caller": "external"}))?;
+    drain_commands(&mut eng);
+
+    let req_vote = Vote::new(2, 1);
+    let resp = VoteResponse::new(Vote::new_committed(1, 2), Some(log_id(1, 1, 1)), true);
+    assert!(runtime_pre_vote_gate(&eng, &req_vote));
+    let pre = state_json(&eng, false);
+    eng.handle_pre_vote_resp(2, resp.clone());
+    let post = state_json(&eng, false);
+    emit("HandlePreVoteResponse", 1, pre, post, pre_vote_resp_args(2, &resp, &req_vote))
+}
