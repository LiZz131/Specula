+/// [tla-trace] Record an out-of-band vote rewrite in the trace file, if tracing is enabled.
+fn tla_trace_test_set_vote(nid: u64, term: u64, node: u64) {
+    use std::io::Write;
+    let Ok(path) = std::env::var("OPENRAFT_TLA_TRACE") else {
+        return;
+    };
+    let ts = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+    let line = format!(
+        r#"{{"tag":"trace","ts":{},"seq":-1,"event":{{"name":"TestSetVote","nid":{},"state":{{}},"msg":{{"vote":{{"term":{},"node":{},"committed":false}}}}}}}}"#,
+        ts, nid, term, node
+    );
+    if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true).open(path) {
+        let _ = writeln!(f, "{}", line);
+    }
+}
