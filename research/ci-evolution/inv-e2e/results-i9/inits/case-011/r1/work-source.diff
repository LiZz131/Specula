diff --git a/openraft/src/tla_trace.rs b/openraft/src/tla_trace.rs
new file mode 100644
index 0000000..d41c8ff
--- /dev/null
+++ b/openraft/src/tla_trace.rs
@@ -0,0 +1,222 @@
+//! TLA+ trace emission for Specular trace validation (instrumentation only).
+//!
+//! Enabled when the environment variable `OPENRAFT_TLA_TRACE` names an output file.
+//! Every emitted line is an NDJSON object:
+//! `{"tag":"trace","ts":<unix-nanos>,"seq":<n>,"event":{"name":..,"nid":..,"state":{..},"msg":{..}}}`
+//!
+//! The module never changes protocol state; it only reads engine state.
+
+use std::fmt::Display;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use crate::Membership;
+use crate::RaftTypeConfig;
+use crate::engine::Engine;
+use crate::entry::RaftEntry;
+use crate::progress::Progress;
+use crate::log_id::LogId;
+use crate::raft_state::LogStateReader;
+use crate::type_config::alias::VoteOf;
+use crate::vote::RaftLeaderId;
+use crate::vote::RaftVote;
+
+struct Writer {
+    file: Option<File>,
+}
+
+static WRITER: OnceLock<Mutex<Writer>> = OnceLock::new();
+static SEQ: AtomicU64 = AtomicU64::new(0);
+
+fn writer() -> &'static Mutex<Writer> {
+    WRITER.get_or_init(|| {
+        let file = std::env::var("OPENRAFT_TLA_TRACE").ok().and_then(|p| {
+            OpenOptions::new().create(true).append(true).open(p).ok()
+        });
+        Mutex::new(Writer { file })
+    })
+}
+
+/// Whether tracing is enabled.
+pub(crate) fn enabled() -> bool {
+    writer().lock().map(|w| w.file.is_some()).unwrap_or(false)
+}
+
+/// Emit one event. `fields` is a JSON object body (without braces) or empty.
+pub(crate) fn emit(name: &str, nid: &str, state: &str, msg: &str) {
+    let mut w = match writer().lock() {
+        Ok(w) => w,
+        Err(p) => p.into_inner(),
+    };
+    let Some(f) = w.file.as_mut() else {
+        return;
+    };
+    let ts = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+    let seq = SEQ.fetch_add(1, Ordering::SeqCst);
+    let line = format!(
+        r#"{{"tag":"trace","ts":{},"seq":{},"event":{{"name":"{}","nid":{},"state":{},"msg":{}}}}}"#,
+        ts,
+        seq,
+        name,
+        num(nid),
+        if state.is_empty() { "{}" } else { state },
+        if msg.is_empty() { "{}" } else { msg },
+    );
+    let _ = writeln!(f, "{}", line);
+    let _ = f.flush();
+}
+
+/// Render a Display value as a JSON number if it is an unsigned integer, else as a string.
+pub(crate) fn num(s: &str) -> String {
+    let digits = s.strip_prefix('-').unwrap_or(s);
+    if !digits.is_empty() && digits.chars().all(|c| c.is_ascii_digit()) {
+        s.to_string()
+    } else {
+        format!("\"{}\"", s.replace('"', "'"))
+    }
+}
+
+pub(crate) fn d<T: Display>(t: &T) -> String {
+    num(&t.to_string())
+}
+
+/// Vote as `{"term":..,"node":..,"committed":..}`.
+pub(crate) fn vote_json<C>(v: &VoteOf<C>) -> String
+where C: RaftTypeConfig {
+    let lid = v.leader_id();
+    format!(
+        r#"{{"term":{},"node":{},"committed":{}}}"#,
+        d(&lid.term()),
+        d(lid.node_id()),
+        v.is_committed()
+    )
+}
+
+/// Parse a committed leader id Display: adv `T{term}-N{node}`, std `{term}`.
+fn parse_cl(s: &str) -> (String, String) {
+    if let Some(rest) = s.strip_prefix('T')
+        && let Some((t, n)) = rest.split_once("-N")
+    {
+        return (t.to_string(), n.to_string());
+    }
+    (s.to_string(), "-1".to_string())
+}
+
+/// Option<LogId> as `{"term":..,"node":..,"index":..}` (None: index -1).
+pub(crate) fn log_id_json<CLID>(l: Option<&LogId<CLID>>) -> String
+where CLID: crate::vote::RaftCommittedLeaderId {
+    match l {
+        // None is encoded as index -1 (spec index 0) to keep the JSON null-free.
+        None => r#"{"term":0,"node":-1,"index":-1}"#.to_string(),
+        Some(l) => {
+            let (t, n) = parse_cl(&l.committed_leader_id().to_string());
+            format!(r#"{{"term":{},"node":{},"index":{}}}"#, num(&t), num(&n), l.index())
+        }
+    }
+}
+
+pub(crate) fn membership_json<NID, N>(m: &Membership<NID, N>) -> String
+where
+    NID: crate::NodeId,
+    N: crate::Node,
+{
+    let cfgs = m
+        .get_joint_config()
+        .iter()
+        .map(|c| format!("[{}]", c.iter().map(|x| d(x)).collect::<Vec<_>>().join(",")))
+        .collect::<Vec<_>>()
+        .join(",");
+    let nodes = m.nodes().map(|(id, _)| d(id)).collect::<Vec<_>>().join(",");
+    format!(r#"{{"cfgs":[{}],"nodes":[{}]}}"#, cfgs, nodes)
+}
+
+/// One log entry as `{"term","node","index","type","membership"}`.
+pub(crate) fn entry_json<E>(e: &E) -> String
+where E: RaftEntry {
+    let (clid, index) = e.log_id_parts();
+    let (t, n) = parse_cl(&clid.to_string());
+    let shown = e.to_string();
+    let (ty, mem) = match e.get_membership() {
+        Some(m) => ("membership", membership_json(&m)),
+        None => {
+            let payload = shown.split_once(':').map(|x| x.1).unwrap_or("");
+            if payload.starts_with("blank") {
+                ("blank", r#"{"cfgs":[],"nodes":[]}"#.to_string())
+            } else {
+                ("normal", r#"{"cfgs":[],"nodes":[]}"#.to_string())
+            }
+        }
+    };
+    format!(
+        r#"{{"term":{},"node":{},"index":{},"type":"{}","membership":{}}}"#,
+        num(&t),
+        num(&n),
+        index,
+        ty,
+        mem
+    )
+}
+
+pub(crate) fn entries_json<E>(es: &[E]) -> String
+where E: RaftEntry {
+    format!("[{}]", es.iter().map(|e| entry_json(e)).collect::<Vec<_>>().join(","))
+}
+
+/// Snapshot of node-local engine state used for post-state validation.
+pub(crate) fn engine_state_json<C, SM>(eng: &Engine<C, SM>) -> String
+where C: RaftTypeConfig {
+    let st = &eng.state;
+    let em = st.membership_state.effective();
+    let cm = st.membership_state.committed();
+    let cand = match eng.candidate_ref() {
+        None => r#"{"present":false}"#.to_string(),
+        Some(c) => {
+            let granted = c.granters().map(|x| d(&x)).collect::<Vec<_>>().join(",");
+            format!(
+                r#"{{"present":true,"vote":{},"last":{},"granted":[{}]}}"#,
+                vote_json::<C>(c.vote_ref()),
+                log_id_json(c.last_log_id()),
+                granted
+            )
+        }
+    };
+    let ldr = match eng.leader_ref() {
+        None => r#"{"present":false}"#.to_string(),
+        Some(l) => {
+            let v: VoteOf<C> = l.committed_vote_ref().clone().into_vote();
+            let matching = l
+                .progress
+                .iter()
+                .map(|item| format!(r#"{{"id":{},"matching":{}}}"#, d(&item.id), log_id_json(item.val.matching())))
+                .collect::<Vec<_>>()
+                .join(",");
+            format!(
+                r#"{{"present":true,"vote":{},"last":{},"noop":{},"progress":[{}]}}"#,
+                vote_json::<C>(&v),
+                log_id_json(l.last_log_id()),
+                log_id_json(Some(l.noop_log_id())),
+                matching
+            )
+        }
+    };
+    format!(
+        r#"{{"vote":{},"server_state":"{:?}","last_log_id":{},"committed":{},"membership":{{"effective":{{"log_id":{},"config":{}}},"committed":{{"log_id":{},"config":{}}}}},"candidate":{},"leader":{}}}"#,
+        vote_json::<C>(st.vote_ref()),
+        st.server_state,
+        log_id_json(st.last_log_id()),
+        log_id_json(st.committed()),
+        log_id_json(em.log_id().as_ref()),
+        membership_json(em.membership()),
+        log_id_json(cm.log_id().as_ref()),
+        membership_json(cm.membership()),
+        cand,
+        ldr
+    )
+}
