        /\
        usedTxn = ({1, 2, 3, 4})
        /\
        up = ([s0 |-> TRUE, s1 |-> TRUE, s2 |-> TRUE])
        /\
        phase = ([s0 |-> "election", s1 |-> "election", s2 |-> "election"])
        /\
        committed = ([s0 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s1 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s2 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>])
        /\
        l = (158)
        /\
        acked = ((0 :> {} @@ 1 :> {} @@ 2 :> {} @@ 3 :> {} @@ 4 :> {} @@ 5 :> {} @@ 6 :> {} @@ 7 :> {} @@ 1000 :> {}))
