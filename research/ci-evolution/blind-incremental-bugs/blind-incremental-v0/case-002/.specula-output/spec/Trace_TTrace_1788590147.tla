---- MODULE Trace_TTrace_1788590147 ----
EXTENDS Trace, Sequences, TLCExt, Toolbox, Naturals, TLC

_expression ==
    LET Trace_TEExpression == INSTANCE Trace_TEExpression
    IN Trace_TEExpression!expression
----

_trace ==
    LET Trace_TETrace == INSTANCE Trace_TETrace
    IN Trace_TETrace!trace
----

_inv ==
    ~(
        TLCGet("level") = Len(_TETrace)
        /\
        syncJustified = ([s0 |-> FALSE, s1 |-> FALSE, s2 |-> FALSE])
        /\
        syncSource = ([s0 |-> "Nil", s1 |-> "Nil", s2 |-> "Nil"])
        /\
        role = ([s0 |-> "looking", s1 |-> "leading", s2 |-> "looking"])
        /\
        applied = ([s0 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s1 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s2 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>])
        /\
        commitCertified = ((0 :> FALSE @@ 1 :> TRUE @@ 2 :> TRUE @@ 3 :> TRUE @@ 4 :> FALSE @@ 5 :> FALSE @@ 6 :> FALSE @@ 7 :> FALSE @@ 1000 :> FALSE))
        /\
        queued = ([s0 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s1 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s2 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2], [id |-> 4, epoch |-> 2]>>])
        /\
        leaderOf = ([s0 |-> "Nil", s1 |-> "s1", s2 |-> "Nil"])
        /\
        currentEpoch = ([s0 |-> 2, s1 |-> 2, s2 |-> 2])
        /\
        leadersByEpoch = ((0 :> {"s2"} @@ 1 :> {"s2"} @@ 2 :> {"s1", "s2"} @@ 3 :> {}))
        /\
        durable = ([s0 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s1 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2]>>, s2 |-> <<[id |-> 1, epoch |-> 1], [id |-> 2, epoch |-> 1], [id |-> 3, epoch |-> 1], [id |-> 1, epoch |-> 2], [id |-> 2, epoch |-> 2], [id |-> 3, epoch |-> 2], [id |-> 4, epoch |-> 2]>>])
        /\
