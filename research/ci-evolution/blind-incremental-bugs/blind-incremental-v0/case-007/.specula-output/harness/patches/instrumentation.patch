diff --git a/openraft/src/tla_trace.rs b/openraft/src/tla_trace.rs
new file mode 100644
index 0000000..d6e3bdf
--- /dev/null
+++ b/openraft/src/tla_trace.rs
@@ -0,0 +1,138 @@
+//! Disabled-by-default trace emission used by the Specula validation harness.
+
+use std::env;
+use std::fmt::Display;
+use std::fmt::Write as _;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io::Write as _;
+use std::sync::Mutex;
+use std::sync::OnceLock;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+use crate::LogId;
+use crate::RaftTypeConfig;
+
+static WRITER: OnceLock<Option<Mutex<File>>> = OnceLock::new();
+
+fn writer() -> Option<&'static Mutex<File>> {
+    WRITER
+        .get_or_init(|| {
+            let path = env::var("SPECULA_TRACE_FILE").ok()?;
+            let file = OpenOptions::new().create(true).truncate(true).write(true).open(path).ok()?;
+            Some(Mutex::new(file))
+        })
+        .as_ref()
+}
+
+fn escape(value: &str) -> String {
+    let mut out = String::with_capacity(value.len() + 2);
+    for ch in value.chars() {
+        match ch {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if c.is_control() => {
+                let _ = write!(out, "\\u{:04x}", c as u32);
+            }
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+pub(crate) fn log_index<C: RaftTypeConfig>(value: &Option<LogId<C>>) -> i128 {
+    value.as_ref().map(|x| x.index as i128).unwrap_or(-1)
+}
+
+pub(crate) struct Event {
+    name: &'static str,
+    nid: String,
+    target: String,
+    session: String,
+    msg: Vec<(&'static str, String)>,
+    state: Vec<(&'static str, String)>,
+}
+
+impl Event {
+    pub(crate) fn new(name: &'static str, nid: impl Display, target: impl Display, session: impl Display) -> Self {
+        Self {
+            name,
+            nid: nid.to_string(),
+            target: target.to_string(),
+            session: session.to_string(),
+            msg: vec![],
+            state: vec![],
+        }
+    }
+
+    pub(crate) fn msg_int(mut self, key: &'static str, value: i128) -> Self {
+        self.msg.push((key, value.to_string()));
+        self
+    }
+
+    pub(crate) fn msg_str(mut self, key: &'static str, value: impl Display) -> Self {
+        self.msg.push((key, format!("\"{}\"", escape(&value.to_string()))));
+        self
+    }
+
+    pub(crate) fn state_int(mut self, key: &'static str, value: i128) -> Self {
+        self.state.push((key, value.to_string()));
+        self
+    }
+
+    pub(crate) fn state_bool(mut self, key: &'static str, value: bool) -> Self {
+        self.state.push((key, value.to_string()));
+        self
+    }
+
+    pub(crate) fn state_str(mut self, key: &'static str, value: impl Display) -> Self {
+        self.state.push((key, format!("\"{}\"", escape(&value.to_string()))));
+        self
+    }
+}
+
+fn object(fields: &[(&'static str, String)]) -> String {
+    let mut out = String::from("{");
+    for (i, (key, value)) in fields.iter().enumerate() {
+        if i > 0 {
+            out.push(',');
+        }
+        let _ = write!(out, "\"{}\":{}", key, value);
+    }
+    out.push('}');
+    out
+}
+
+pub(crate) fn emit(event: Event) {
+    let Some(writer) = writer() else {
+        return;
+    };
+
+    if let Ok(filter) = env::var("SPECULA_TRACE_TARGET")
+        && filter != event.target
+    {
+        return;
+    }
+
+    let ts = SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos();
+
+    let line = format!(
+        "{{\"tag\":\"trace\",\"ts\":\"{}\",\"event\":{{\"name\":\"{}\",\"nid\":\"{}\",\"target\":\"{}\",\"session\":\"{}\",\"msg\":{},\"state\":{}}}}}\n",
+        ts,
+        event.name,
+        escape(&event.nid),
+        escape(&event.target),
+        escape(&event.session),
+        object(&event.msg),
+        object(&event.state),
+    );
+
+    if let Ok(mut file) = writer.lock() {
+        let _ = file.write_all(line.as_bytes());
+        let _ = file.flush();
+    }
+}
