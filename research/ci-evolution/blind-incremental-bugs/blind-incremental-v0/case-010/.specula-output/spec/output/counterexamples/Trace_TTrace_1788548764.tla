        /\ commitWitness  = _TETrace[i].commitWitness
        /\ commitWitness' = _TETrace[j].commitWitness
        /\ electionVotes  = _TETrace[i].electionVotes
        /\ electionVotes' = _TETrace[j].electionVotes
        /\ acks  = _TETrace[i].acks
        /\ acks' = _TETrace[j].acks
