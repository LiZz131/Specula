        /\ role' = _TETrace[j].role
        /\ lastTransition  = _TETrace[i].lastTransition
        /\ lastTransition' = _TETrace[j].lastTransition
        /\ syncMode  = _TETrace[i].syncMode
        /\ syncMode' = _TETrace[j].syncMode
