---- MODULE Trace_TTrace_1788548764 ----
EXTENDS Trace, Sequences, TLCExt, Toolbox, Naturals, TLC

_expression ==
    LET Trace_TEExpression == INSTANCE Trace_TEExpression
    IN Trace_TEExpression!expression
----

_trace ==
    LET Trace_TETrace == INSTANCE Trace_TETrace
    IN Trace_TETrace!trace
----

_prop ==
    ~<>[](
        role = ([s0 |-> "FOLLOWING", s1 |-> "FOLLOWING", s2 |-> "LEADING"])
        /\
        applied = ([s0 |-> <<1>>, s1 |-> <<1, 2>>, s2 |-> <<1, 2>>])
        /\
        prepared = ([s0 |-> <<1>>, s1 |-> <<1, 2>>, s2 |-> <<1, 2>>])
        /\
        globalCommitted = (<<1, 2>>)
        /\
        pending = ([s0 |-> <<>>, s1 |-> <<2>>, s2 |-> <<>>])
        /\
        leaderOf = ([s0 |-> "s2", s1 |-> "s2", s2 |-> "s2"])
        /\
        newLeaderAcks = ([s0 |-> {}, s1 |-> {}, s2 |-> {"s0", "s1", "s2"}])
        /\
        currentEpoch = ([s0 |-> 2, s1 |-> 2, s2 |-> 2])
        /\
        running = ([s0 |-> TRUE, s1 |-> TRUE, s2 |-> TRUE])
        /\
        durable = ([s0 |-> <<1>>, s1 |-> <<1, 2>>, s2 |-> <<1, 2>>])
        /\
        acceptedEpoch = ([s0 |-> 2, s1 |-> 2, s2 |-> 2])
        /\
        electionRound = (0)
        /\
        syncQueued = ([s0 |-> <<>>, s1 |-> <<1, 2>>, s2 |-> <<2>>])
        /\
        snapshotImage = ([s0 |-> <<>>, s1 |-> <<>>, s2 |-> <<1>>])
        /\
        syncMode = ([s0 |-> "NONE", s1 |-> "NONE", s2 |-> "NONE"])
        /\
        snapshotPublished = ([s0 |-> <<>>, s1 |-> <<>>, s2 |-> <<1>>])
        /\
        phase = ([s0 |-> "SYNCHRONIZATION", s1 |-> "BROADCAST", s2 |-> "BROADCAST"])
        /\
        nextTxn = (3)
        /\
        votedFor = ([s0 |-> "s2", s1 |-> "s2", s2 |-> "s2"])
        /\
        committed = ([s0 |-> <<1>>, s1 |-> <<1, 2>>, s2 |-> <<1, 2>>])
        /\
        recoveryVisible = ([s0 |-> <<1>>, s1 |-> <<1>>, s2 |-> <<1>>])
        /\
        acks = (<<{"s1", "s2"}, {"s1", "s2"}, {}, {}, {}, {}, {}, {}, {}, {}>>)
        /\
        durabilityEvidence = (<<{"s0", "s1", "s2"}, {"s1", "s2"}, {}, {}, {}, {}, {}, {}, {}, {}>>)
        /\
        electionVotes = ([s0 |-> {}, s1 |-> {}, s2 |-> {"s0", "s1", "s2"}])
        /\
        epochAcks = ([s0 |-> {}, s1 |-> {}, s2 |-> {}])
        /\
        l = (116)
        /\
        snapshotBusy = ([s0 |-> FALSE, s1 |-> FALSE, s2 |-> FALSE])
        /\
        epochProposal = ([s0 |-> 2, s1 |-> 2, s2 |-> 2])
        /\
        commitWitness = (<<{"s1", "s2"}, {"s1", "s2"}, {}, {}, {}, {}, {}, {}, {}, {}>>)
        /\
        lastTransition = ("ChooseSyncMode")
        /\
        syncComplete = ([s0 |-> FALSE, s1 |-> TRUE, s2 |-> FALSE])
        /\
        newLeaderReady = ([s0 |-> FALSE, s1 |-> FALSE, s2 |-> TRUE])
    )
----

