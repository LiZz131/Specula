            [index |-> 0, active |-> FALSE, requester |-> Nil, acks |-> {}] ) @@
  s2 :>
      ( ctx1 :>
            [index |-> 0, active |-> FALSE, requester |-> Nil, acks |-> {}] ) @@
  s3 :>
      ( ctx1 :>
            [index |-> 0, active |-> FALSE, requester |-> Nil, acks |-> {}] ) )
/\ recentActive = ( s1 :> (s1 :> FALSE @@ s2 :> FALSE @@ s3 :> FALSE) @@
  s2 :> (s1 :> FALSE @@ s2 :> FALSE @@ s3 :> FALSE) @@
  s3 :> (s1 :> FALSE @@ s2 :> FALSE @@ s3 :> FALSE) )
/\ role = (s1 :> Leader @@ s2 :> Follower @@ s3 :> Follower)
/\ commitHistory = {}
/\ publishedReads = <<>>
/\ nextIndex = ( s1 :> (s1 :> 2 @@ s2 :> 2 @@ s3 :> 2) @@
  s2 :> (s1 :> 1 @@ s2 :> 1 @@ s3 :> 1) @@
  s3 :> (s1 :> 1 @@ s2 :> 1 @@ s3 :> 1) )
/\ scenarioSeen = [ proposal |-> FALSE,
  heartbeat |-> FALSE,
  quorumCheck |-> FALSE,
  crash |-> FALSE,
  commit |-> FALSE,
  leader |-> TRUE,
  readyRead |-> FALSE,
  election |-> TRUE,
  append |-> FALSE,
  readRequest |-> FALSE,
  readQuorum |-> FALSE,
  loss |-> FALSE,
  restart |-> FALSE ]
/\ producedReads = (s1 :> <<>> @@ s2 :> <<>> @@ s3 :> <<>>)
/\ matchIndex = ( s1 :> (s1 :> 1 @@ s2 :> 0 @@ s3 :> 0) @@
  s2 :> (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0) @@
  s3 :> (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0) )
/\ leaderHistory = {[term |-> 1, node |-> s1]}
/\ readyOutstanding = (s1 :> TRUE @@ s2 :> TRUE @@ s3 :> FALSE)
/\ appliedIndex = (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0)
/\ commitIndex = (s1 :> 0 @@ s2 :> 0 @@ s3 :> 0)
/\ term = (s1 :> 1 @@ s2 :> 1 @@ s3 :> 0)
/\ durableTerm = (s1 :> 1 @@ s2 :> 1 @@ s3 :> 0)
/\ faultCounters = [ campaign |-> 1,
  proposal |-> 0,
  heartbeat |-> 0,
  read |-> 0,
  ready |-> 2,
  quorumCheck |-> 0,
  crash |-> 0,
  lose |-> 0 ]
/\ messages = { [ term |-> 1,
    mtype |-> MsgVote,
    from |-> s1,
    reject |-> FALSE,
    to |-> s3,
    commit |-> 0,
    index |-> 0,
    logTerm |-> 0,
